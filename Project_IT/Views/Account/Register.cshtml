@model Project_IT.Models.RegisterViewModel
@{
    ViewBag.Title = "Регистрација";
}

<div class="max-w-md mx-auto px-6 py-12 font-sans">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-6">
        <div class="text-center">
            <h1 class="text-3xl font-serif text-slate-800">Регистрација</h1>
            <p class="text-slate-500 text-sm mt-1">Креирајте нова корисничка сметка</p>
        </div>

        @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "space-y-5" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-rose-600 text-xs font-semibold" })

            <div>
                @Html.LabelFor(m => m.Email, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
                @Html.TextBoxFor(m => m.Email, new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", placeholder = "email@example.com" })
            </div>

            <div>
                @Html.LabelFor(m => m.Password, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
                @Html.PasswordFor(m => m.Password, new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", placeholder = "••••••••" })
            </div>

            <div>
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", placeholder = "••••••••" })
            </div>

            <button type="submit" class="w-full py-3 rounded-full text-sm font-semibold text-white bg-brand-gradient shadow-md hover:opacity-90 transition">
                Регистрирај корисник
            </button>

            <div class="text-center pt-2 text-sm text-slate-500">
                Веќе имате сметка?
                <a href="@Url.Action("Login")" class="text-emerald-800 hover:text-emerald-900 font-semibold no-underline ml-1">
                    Најавете се
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
