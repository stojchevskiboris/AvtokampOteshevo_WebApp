@model Project_IT.Models.AddToRoleModel
@{
    ViewBag.Title = "Додај привилегија на корисник";
}

<div class="max-w-md mx-auto px-6 py-12 font-sans">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-6">
        <div class="text-center">
            <h1 class="text-2xl font-serif text-slate-800">Додај привилегија</h1>
            @if (ViewBag.Message != null)
            {
                <p class="text-emerald-700 text-sm mt-1 font-semibold">@ViewBag.Message</p>
            }
        </div>

        @using (Html.BeginForm("AddUserToRole", "Account", FormMethod.Post, new { @class = "space-y-5" }))
        {
            @Html.AntiForgeryToken()

            <div>
                @Html.LabelFor(m => m.Email, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
                @Html.TextBoxFor(m => m.Email, new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", placeholder = "email@example.com" })
            </div>

            <div>
                @Html.LabelFor(m => m.SelectedRole, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
                @Html.DropDownListFor(m => m.SelectedRole, new SelectList(Model.Roles), new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm bg-white" })
            </div>

            <button type="submit" class="w-full py-3 rounded-full text-sm font-semibold text-white bg-brand-gradient shadow-md hover:opacity-90 transition">
                Зачувај
            </button>
        }
    </div>
</div>
