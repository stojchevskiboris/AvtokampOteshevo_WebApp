@model Project_IT.Models.Reservation

@{
    ViewBag.Title = Strings.AdminRes_Details_Meta_Title;
}

<div class="max-w-3xl mx-auto px-6 py-10 font-sans">
    <div class="mb-6">
        <a href="@Url.Action("Index")" class="text-sm text-slate-400 hover:text-slate-700 transition">@Strings.AdminRes_BackToList</a>
        <h1 class="text-3xl font-serif text-slate-800 mt-2">@Strings.AdminRes_Details_Title</h1>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400">@Strings.AdminRes_LabelClient</span>
                <h2 class="text-xl font-serif text-slate-800">
                    @(string.IsNullOrWhiteSpace(Model.FullName) ? (Model.FirstName + " " + Model.LastName).Trim() : Model.FullName)
                </h2>
            </div>
            <div>
                @if (Model.Status == "Accepted")
                {
                    <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                        Прифатена
                    </span>
                }
                else if (Model.Status == "Denied")
                {
                    <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-rose-50 text-rose-700 border border-rose-200">
                        Одбиена
                    </span>
                }
                else
                {
                    <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                        Нова
                    </span>
                }
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block mb-1">@Strings.AdminRes_LabelEmail</span>
                <p class="text-sm text-slate-800 font-medium">@Model.Email</p>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block mb-1">@Strings.AdminRes_LabelPhone</span>
                <p class="text-sm text-slate-800 font-medium">@Model.Phone</p>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block mb-1">@Strings.AdminRes_ColAccommodation</span>
                <p class="text-sm text-slate-800 font-medium">@Model.AccommodationType</p>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block mb-1">@Strings.AdminRes_LabelGuests</span>
                <p class="text-sm text-slate-800 font-medium">@Model.Guests</p>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block mb-1">@Strings.Home_CheckIn</span>
                <p class="text-sm text-slate-800 font-medium">@(Model.CheckInDate?.ToString("dd.MM.yyyy") ?? "-")</p>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block mb-1">@Strings.Home_CheckOut</span>
                <p class="text-sm text-slate-800 font-medium">@(Model.CheckOutDate?.ToString("dd.MM.yyyy") ?? "-")</p>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block mb-1">@Strings.AdminRes_LabelNights</span>
                <p class="text-sm text-slate-800 font-medium">@Model.Days</p>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block mb-1">@Strings.AdminRes_LabelPrice</span>
                <p class="text-sm text-slate-800 font-medium">@Model.Price MKD</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Info))
        {
            <div class="pt-4 border-t border-slate-100">
                <span class="text-xs font-semibold uppercase text-slate-400 block mb-1">@Strings.AdminRes_AdditionalRequests</span>
                <p class="text-sm text-slate-600 leading-relaxed bg-slate-50 p-4 rounded-xl border border-slate-100">@Model.Info</p>
            </div>
        }

        <div class="pt-4 border-t border-slate-100 text-xs text-slate-400 space-y-1">
            <div class="font-semibold uppercase text-slate-500 mb-2">@Strings.AdminRes_TechnicalDetails</div>
            <div><strong>@Strings.AdminRes_IpAddress</strong> @Model.IPAddress</div>
            <div><strong>@Strings.AdminRes_OS</strong> @Model.UserOs</div>
            <div><strong>@Strings.AdminRes_Platform</strong> @Model.UserPlatform</div>
            <div><strong>@Strings.AdminRes_Browser</strong> @Model.UserBrowser @Model.UserVersion</div>
            <div><strong>@Strings.AdminRes_UserAgent</strong> @Model.UserAgent</div>
            <div><strong>@Strings.AdminRes_Referrer</strong> @Model.UserReferrer</div>
            <div><strong>@Strings.AdminRes_Created</strong> @Model.CreatedOn.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</div>
            <div><strong>@Strings.AdminRes_Modified</strong> @(Model.ModifiedOn.HasValue ? Model.ModifiedOn.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "-")</div>
        </div>

        <div class="flex items-center gap-4 pt-6 border-t border-slate-100">
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="px-6 py-2.5 rounded-full text-sm font-semibold text-white bg-brand-gradient shadow-md hover:opacity-90 transition">
                Измени
            </a>
            <a href="@Url.Action("Index")" class="px-6 py-2.5 rounded-full text-sm font-semibold text-slate-600 border border-slate-200 hover:bg-slate-50 transition">
                Назад
            </a>
        </div>
    </div>
</div>
