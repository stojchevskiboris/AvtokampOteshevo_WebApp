@model Project_IT.Models.Reservation

@{
    ViewBag.Title = "Детали за резервација";
}

<h2>Детали за резервација</h2>

<div class="dl-horizontal">
    <dt>Име</dt>
    <dd>@(string.IsNullOrWhiteSpace(Model.FullName) ? (Model.Ime + " " + Model.Prezime).Trim() : Model.FullName)</dd>

    <dt>Email</dt>
    <dd>@Model.Email</dd>

    <dt>Телефон</dt>
    <dd>@Model.Telefon</dd>

    <dt>Сместување</dt>
    <dd>@Model.Smestuvanje</dd>

    <dt>Лица</dt>
    <dd>@Model.Lica</dd>

    <dt>Check-in</dt>
    <dd>@Model.DataNaPristignuvanje.ToString("dd.MM.yyyy")</dd>

    <dt>Check-out</dt>
    <dd>@Model.DataNaZaminuvanje.ToString("dd.MM.yyyy")</dd>

    <dt>Ноќевања</dt>
    <dd>@Model.Denovi</dd>

    <dt>Статус</dt>
    <dd>@Model.Status</dd>

    <dt>Дополнителни барања</dt>
    <dd>@Model.Info</dd>

    <dt>IP адреса</dt>
    <dd>@Model.IPAddress</dd>

    <dt>User OS</dt>
    <dd>@Model.UserOs</dd>

    <dt>User Platform</dt>
    <dd>@Model.UserPlatform</dd>

    <dt>User Agent</dt>
    <dd>@Model.UserAgent</dd>

    <dt>Прелистувач</dt>
    <dd>@Model.UserBrowser @Model.UserVersion</dd>

    <dt>Referrer</dt>
    <dd>@Model.UserReferrer</dd>

    <dt>Креирано</dt>
    <dd>@Model.CreatedOn.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>

    <dt>Променето</dt>
    <dd>@(Model.ModifiedOn.HasValue ? Model.ModifiedOn.Value.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : "-")</dd>
</div>

<p>
    @Html.ActionLink("Измени", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Назад", "Index")
</p>
