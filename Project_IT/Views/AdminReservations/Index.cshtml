@model IEnumerable<Project_IT.Models.Reservation>

@{
    ViewBag.Title = "Админ - Резервации";
}

<h2>Резервации</h2>

<table class="table table-striped table-bordered">
    <thead>
        <tr>
            <th>Креирано</th>
            <th>Клиент</th>
            <th>Контакт</th>
            <th>Сместување</th>
            <th>Статус</th>
            <th>Период</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.CreatedOn.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>@(string.IsNullOrWhiteSpace(item.FullName) ? (item.FirstName + " " + item.LastName).Trim() : item.FullName)</td>
                <td>
                    <div>@item.Email</div>
                    <div>@item.Phone</div>
                </td>
                <td>@item.AccommodationType</td>
                <td>@item.Status</td>
                <td>
                    @item.CheckInDate.ToString("dd.MM.yyyy")
                    -
                    @item.CheckOutDate.ToString("dd.MM.yyyy")
                </td>
                <td>
                    @Html.ActionLink("Детали", "Details", new { id = item.Id }) |
                    @Html.ActionLink("Измени", "Edit", new { id = item.Id }) |
                    @Html.ActionLink("Избриши", "Delete", new { id = item.Id })
                </td>
            </tr>
        }
    </tbody>
</table>
