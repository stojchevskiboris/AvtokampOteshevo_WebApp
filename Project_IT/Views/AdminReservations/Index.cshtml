@model IEnumerable<Project_IT.Models.Reservation>

@{
    ViewBag.Title = Strings.AdminRes_Meta_Title;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10 font-sans">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 sm:mb-8">
        <div>
            <h1 class="text-2xl sm:text-3xl font-serif text-slate-800">@Strings.AdminRes_Title</h1>
            <p class="text-slate-500 text-xs sm:text-sm mt-1">@Strings.AdminRes_Subtitle</p>
        </div>
        <a href="@Url.Action("Create")" class="inline-flex items-center justify-center px-5 py-2.5 rounded-full text-xs sm:text-sm font-semibold text-white bg-brand-gradient shadow-md hover:opacity-90 transition self-start sm:self-auto no-underline">
            @Strings.Admin_NewEntry
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        @if (!Model.Any())
        {
            <div class="p-8 sm:p-12 text-center text-slate-400">
                <div class="text-3xl sm:text-4xl mb-3">📋</div>
                <p class="text-xs sm:text-base font-medium">@Strings.AdminRes_Empty</p>
            </div>
        }
        else
        {
            <!-- Mobile Card List (< sm) -->
            <div class="block sm:hidden divide-y divide-slate-100">
                @foreach (var item in Model)
                {
                    <div class="p-4 flex flex-col gap-3 hover:bg-slate-50/50 transition">
                        <div class="flex items-start justify-between gap-2">
                            <div class="min-w-0 flex-1">
                                <h3 class="text-sm font-bold text-slate-800 break-words">
                                    @(string.IsNullOrWhiteSpace(item.FullName) ? (item.FirstName + " " + item.LastName).Trim() : item.FullName)
                                </h3>
                                <div class="text-xs text-slate-500 flex items-center gap-2 mt-0.5 flex-wrap">
                                    @if (!string.IsNullOrWhiteSpace(item.Phone))
                                    {
                                        <a href="tel:@item.Phone" class="text-emerald-700 font-medium hover:underline no-underline">📞 @item.Phone</a>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.Email))
                                    {
                                        <a href="mailto:@item.Email" class="text-slate-600 hover:underline truncate max-w-[180px] no-underline">✉️ @item.Email</a>
                                    }
                                </div>
                            </div>
                            <div class="shrink-0">
                                @if (item.Status == "Accepted")
                                {
                                    <span class="inline-block px-2.5 py-1 text-[11px] font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                                        Прифатена
                                    </span>
                                }
                                else if (item.Status == "Denied")
                                {
                                    <span class="inline-block px-2.5 py-1 text-[11px] font-semibold rounded-full bg-rose-50 text-rose-700 border border-rose-200">
                                        Одбиена
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-block px-2.5 py-1 text-[11px] font-semibold rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                                        Нова
                                    </span>
                                }
                            </div>
                        </div>

                        <div class="bg-slate-50 rounded-xl p-3 text-xs text-slate-700 space-y-1">
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">@Strings.AdminRes_Accommodation</span>
                                <span class="font-semibold text-slate-800">@item.AccommodationType</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">@Strings.AdminRes_Period</span>
                                <span class="font-medium">@(item.CheckInDate?.ToString("dd.MM.yyyy") ?? "-") &mdash; @(item.CheckOutDate?.ToString("dd.MM.yyyy") ?? "-")</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400">@Strings.AdminRes_Details</span>
                                <span>@string.Format(Strings.AdminRes_NightsGuestsFormat, item.Days, item.Guests)</span>
                            </div>
                        </div>

                        <div class="flex items-center justify-between text-[11px] text-slate-400 pt-1">
                            <span>@Strings.AdminRes_Created @item.CreatedOn.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        </div>

                        <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100 text-xs font-semibold">
                            <a href="@Url.Action("Edit", new { id = item.Id })" class="px-3 py-1.5 rounded-lg bg-emerald-50 text-emerald-700 hover:bg-emerald-100 transition no-underline">@Strings.AdminRes_Edit</a>
                            <a href="@Url.Action("Details", new { id = item.Id })" class="px-3 py-1.5 rounded-lg bg-slate-100 text-slate-700 hover:bg-slate-200 transition no-underline">@Strings.AdminRes_ViewDetails</a>
                            <a href="@Url.Action("Delete", new { id = item.Id })" class="px-3 py-1.5 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 transition no-underline">@Strings.AdminRes_Delete</a>
                        </div>
                    </div>
                }
            </div>

            <!-- Desktop Table (>= sm) -->
            <div class="hidden sm:!block overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 border-b border-slate-100 text-slate-500 uppercase text-xs">
                        <tr>
                            <th class="px-6 py-4 font-semibold">@Strings.AdminRes_ColCreated</th>
                            <th class="px-6 py-4 font-semibold">@Strings.AdminRes_ColClient</th>
                            <th class="px-6 py-4 font-semibold">@Strings.AdminRes_ColContact</th>
                            <th class="px-6 py-4 font-semibold">@Strings.AdminRes_ColAccommodation</th>
                            <th class="px-6 py-4 font-semibold">@Strings.AdminRes_ColPeriod</th>
                            <th class="px-6 py-4 font-semibold">@Strings.AdminRes_ColStatus</th>
                            <th class="px-6 py-4 font-semibold text-right">@Strings.AdminRes_ColActions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-slate-50/50 transition">
                                <td class="px-6 py-4 text-xs text-slate-400 whitespace-nowrap">
                                    @item.CreatedOn.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td class="px-6 py-4 font-medium text-slate-800">
                                    @(string.IsNullOrWhiteSpace(item.FullName) ? (item.FirstName + " " + item.LastName).Trim() : item.FullName)
                                </td>
                                <td class="px-6 py-4">
                                    <div class="text-slate-800 text-xs">@item.Email</div>
                                    <div class="text-slate-400 text-xs">@item.Phone</div>
                                </td>
                                <td class="px-6 py-4 text-xs">
                                    <span class="inline-block px-2.5 py-1 font-semibold rounded-full bg-slate-100 text-slate-700">
                                        @item.AccommodationType
                                    </span>
                                </td>
                                <td class="px-6 py-4 text-xs">
                                    <div>@(item.CheckInDate?.ToString("dd.MM.yyyy") ?? "-") &mdash; @(item.CheckOutDate?.ToString("dd.MM.yyyy") ?? "-")</div>
                                    <div class="text-slate-400">@string.Format(Strings.AdminRes_NightsGuestsFormat, item.Days, item.Guests)</div>
                                </td>
                                <td class="px-6 py-4 text-xs">
                                    @if (item.Status == "Accepted")
                                    {
                                        <span class="inline-block px-2.5 py-1 font-semibold rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            Прифатена
                                        </span>
                                    }
                                    else if (item.Status == "Denied")
                                    {
                                        <span class="inline-block px-2.5 py-1 font-semibold rounded-full bg-rose-50 text-rose-700 border border-rose-200">
                                            Одбиена
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-block px-2.5 py-1 font-semibold rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                                            Нова
                                        </span>
                                    }
                                </td>
                                <td class="px-6 py-4 text-right space-x-2 whitespace-nowrap">
                                    <a href="@Url.Action("Edit", new { id = item.Id })" class="text-emerald-700 hover:text-emerald-900 font-semibold text-xs no-underline">@Strings.AdminRes_Edit</a>
                                    <a href="@Url.Action("Details", new { id = item.Id })" class="text-slate-600 hover:text-slate-900 font-semibold text-xs no-underline">@Strings.AdminRes_ViewDetails</a>
                                    <a href="@Url.Action("Delete", new { id = item.Id })" class="text-rose-600 hover:text-rose-800 font-semibold text-xs no-underline">@Strings.AdminRes_Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
