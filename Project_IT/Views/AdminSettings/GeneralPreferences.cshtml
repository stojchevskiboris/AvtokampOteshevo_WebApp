@model Project_IT.Models.ViewModels.GeneralAppPreferencesViewModel

@{
    ViewBag.Title = Strings.AdminSettings_General_Meta_Title;
}

<div class="max-w-5xl mx-auto px-4 sm:px-6 py-6 sm:py-10 font-sans">

    <!-- Breadcrumb -->
    <div class="mb-4">
        <a href="@Url.Action("Index", "AdminSettings")" class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 hover:text-emerald-700 transition-colors no-underline font-body">
            <span>←</span> Подесувања
        </a>
    </div>

    <!-- Header -->
    <div class="mb-6 sm:mb-8 flex items-center gap-3">
        <div class="w-11 h-11 rounded-xl bg-brand-gradient shadow-md flex items-center justify-center flex-shrink-0 text-white">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
        </div>
        <div>
            <h1 class="text-2xl sm:text-3xl font-serif text-slate-800">@Strings.AdminSettings_General_Title</h1>
            <p class="text-slate-500 text-xs sm:text-sm mt-0.5">@Strings.AdminSettings_General_Subtitle</p>
        </div>
    </div>

    <!-- Success message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm font-medium flex items-center gap-2 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 sm:p-8">
        @using (Html.BeginForm("GeneralPreferences", "AdminSettings", FormMethod.Post, new { @class = "space-y-8" }))
        {
            @Html.AntiForgeryToken()

            if (ViewData.ModelState.Values.Any(v => v.Errors.Count > 0))
            {
                <div class="p-4 rounded-xl bg-red-50 border border-red-200">
                    @Html.ValidationSummary(true, "", new { @class = "text-red-600 text-sm font-medium space-y-1" })
                </div>
            }

            <div>
                <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-400 mb-4 font-body">@Strings.AdminSettings_General_GalleryTitle</h2>
                <div class="p-4 rounded-xl border border-slate-100 bg-slate-50/60 max-w-2xl">
                    <div class="flex flex-col gap-1.5">
                        @Html.LabelFor(m => m.AboutUsGalleryPath, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-600 font-body" })
                        @Html.TextBoxFor(m => m.AboutUsGalleryPath, new { @class = "w-full px-4 py-3 rounded-xl border border-slate-200 bg-white text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors", placeholder = "напр. /Content/gallery/1" })
                        <span class="text-xs text-slate-400 font-body mt-1">@Strings.AdminSettings_General_GalleryHelp</span>
                        @Html.ValidationMessageFor(m => m.AboutUsGalleryPath, "", new { @class = "text-xs text-red-500" })
                    </div>
                </div>
            </div>

            <div class="pt-6 border-t border-slate-100 flex flex-col-reverse sm:flex-row items-center justify-end gap-3 sm:gap-4">
                <a href="@Url.Action("Index", "AdminSettings")" class="w-full sm:w-auto text-center px-6 py-3.5 rounded-xl text-slate-600 font-semibold text-sm border border-slate-200 hover:bg-slate-50 transition-colors cursor-pointer">
                    Откажи
                </a>
                <button type="submit" class="w-full sm:w-auto px-8 py-3.5 rounded-xl text-white font-semibold text-sm transition-all duration-200 hover:opacity-90 hover:shadow-xl active:scale-95 cursor-pointer bg-brand-gradient shadow-md font-body">
                    Зачувај промени
                </button>
            </div>
        }
    </div>
</div>
