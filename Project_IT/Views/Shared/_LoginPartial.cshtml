@using Microsoft.AspNet.Identity

@if (Request.IsAuthenticated)
{
    using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "logoutForm", @class = "inline-flex items-center gap-3" }))
    {
        @Html.AntiForgeryToken()

        <div class="flex items-center gap-3 text-sm">
            @if (User.IsInRole("Admin"))
            {
                <a href="@Url.Action("AddUserToRole", "Account")" class="text-xs px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 hover:bg-amber-100 transition no-underline">
                    Додај Admin
                </a>
            }

            <a href="@Url.Action("Index", "Manage")" class="font-medium text-slate-700 hover:text-slate-900 transition no-underline">
                Здраво, @User.Identity.GetUserName()!
            </a>

            <button type="submit" class="text-xs px-3 py-1.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 transition font-medium border-0 cursor-pointer">
                Одјави се
            </button>
        </div>
    }
}
else
{

}
