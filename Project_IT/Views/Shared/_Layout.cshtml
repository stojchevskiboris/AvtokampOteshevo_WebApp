<!DOCTYPE html>
<html lang="mk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Autocamp Otesevo - Автокамп Отешево | Camping | Otesevo, Macedonia</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:wght@600;700;800&display=swap" rel="stylesheet">

    <!-- Tailwind CSS -->
    @Scripts.Render("~/bundles/tailwind")
    <script>
        window.tailwind && (tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        forest: {
                            50: '#f2f7f6',
                            100: '#e1edea',
                            200: '#c5dbd6',
                            300: '#9bbfb6',
                            400: '#6b9c91',
                            500: '#4d8075',
                            600: '#3c665e',
                            700: '#32534c',
                            800: '#1a3636', // Deep Forest
                            900: '#1e312e',
                        },
                        earth: {
                            50: '#fbf8f4',
                            100: '#f5eee3',
                            200: '#ebdcc5',
                            300: '#dec29d',
                            400: '#cea270',
                            500: '#c28951',
                            600: '#b47343',
                            700: '#965d39',
                            800: '#794c33',
                            900: '#633f2c',
                        },
                        sand: '#D6BD98',
                        accent: '#fb8500', // Modern Orange
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        heading: ['Montserrat', 'sans-serif'],
                    },
                }
            }
        });
    </script>

    <!-- Alpine.js -->
    @Scripts.Render("~/bundles/alpine")

    <style type="text/tailwindcss">
        @@layer base {
            h1, h2, h3, h4, h5, h6 {
                @@apply font-heading;
            }
            body {
                @@apply font-sans text-gray-900 bg-white;
            }
        }
        @@layer components {
            .btn-primary {
                @@apply bg-accent hover:bg-orange-600 text-white font-bold py-3 px-8 rounded-full transition-all duration-300 transform hover:scale-105 shadow-lg;
            }
            .glass-nav {
                @@apply bg-white/80 backdrop-blur-md border-b border-white/20 sticky top-0 z-50;
            }
        }
    </style>

    @Scripts.Render("~/bundles/modernizr")
</head>

<body class="min-h-screen flex flex-col">

    <nav class="glass-nav" x-data="{ open: false }">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-20">
                <div class="flex items-center">
                    <a href='@Url.Action("Index", "Home")' class="flex-shrink-0 flex items-center">
                        <img class="h-12 w-auto" src="~/Content/Avtokamp_Logo_Transparent.png" alt="Autocamp Otesevo Logo">
                        <span class="ml-3 text-forest-800 font-heading font-bold text-xl hidden md:block">Автокамп Отешево</span>
                    </a>
                </div>
                <div class="hidden md:flex items-center space-x-8">
                    @Html.ActionLink("Резервирај", "Create2", "Reservations", null, new { @class = "text-gray-700 hover:text-forest-800 font-medium transition-colors" })
                    @if (User.IsInRole("Admin"))
                    {
                        @Html.ActionLink("Резервации", "Index", "Reservations", null, new { @class = "text-gray-700 hover:text-forest-800 font-medium transition-colors" })
                    }
                    @Html.ActionLink("За нас", "About", "Home", null, new { @class = "text-gray-700 hover:text-forest-800 font-medium transition-colors" })
                    @Html.ActionLink("Контакт", "Contact", "Home", null, new { @class = "text-gray-700 hover:text-forest-800 font-medium transition-colors" })

                    <div class="ml-4">
                        @Html.Partial("_LoginPartial")
                    </div>
                </div>

                <!-- Mobile menu button -->
                <div class="flex items-center md:hidden">
                    <button x-on:click="open = !open" class="inline-flex items-center justify-center p-2 rounded-md text-gray-700 hover:text-forest-800 focus:outline-none">
                        <svg class="h-6 w-6" stroke="currentColor" fill="none" viewBox="0 0 24 24">
                            <path x-bind:class="{'hidden': open, 'inline-flex': !open }" class="inline-flex" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                            <path x-bind:class="{'hidden': !open, 'inline-flex': open }" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile menu -->
        <div x-show="open"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 -translate-y-4"
             x-transition:enter-end="opacity-100 translate-y-0"
             class="md:hidden bg-white border-b border-gray-200">
            <div class="px-2 pt-2 pb-3 space-y-1 sm:px-3">
                @Html.ActionLink("Резервирај", "Create2", "Reservations", null, new { @class = "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-forest-800 hover:bg-gray-50" })
                @if (User.IsInRole("Admin"))
                {
                    @Html.ActionLink("Резервации", "Index", "Reservations", null, new { @class = "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-forest-800 hover:bg-gray-50" })
                }
                @Html.ActionLink("За нас", "About", "Home", null, new { @class = "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-forest-800 hover:bg-gray-50" })
                @Html.ActionLink("Контакт", "Contact", "Home", null, new { @class = "block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-forest-800 hover:bg-gray-50" })
                <div class="border-t border-gray-200 pt-4 pb-3">
                    @Html.Partial("_LoginPartial")
                </div>
            </div>
        </div>
    </nav>

    <main class="flex-grow">
        <div class="container mx-auto px-4 py-8">
            @RenderBody()
        </div>
    </main>

    <footer class="bg-forest-800 text-white py-12">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div>
                    <h3 class="text-xl font-heading font-bold mb-4">Автокамп Отешево</h3>
                    <p class="text-gray-300">Модерен камп опкружен со природа, идеално место за вашиот одмор на Преспанското Езеро.</p>
                </div>
                <div>
                    <h3 class="text-xl font-heading font-bold mb-4">Брзи Линкови</h3>
                    <ul class="space-y-2">
                        <li>@Html.ActionLink("Резервирај", "Create2", "Reservations", null, new { @class = "text-gray-300 hover:text-white transition-colors" })</li>
                        <li>@Html.ActionLink("За нас", "About", "Home", null, new { @class = "text-gray-300 hover:text-white transition-colors" })</li>
                        <li>@Html.ActionLink("Контакт", "Contact", "Home", null, new { @class = "text-gray-300 hover:text-white transition-colors" })</li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-xl font-heading font-bold mb-4">Контакт</h3>
                    <p class="text-gray-300">Отешево, Ресен</p>
                    <p class="text-gray-300">070 207 259</p>
                    <p class="text-gray-300">avtokamp.otesevo@gmail.com</p>
                </div>
            </div>
            <div class="mt-12 pt-8 border-t border-forest-700 text-center text-gray-400 text-sm">
                <p>&copy; @DateTime.Now.Year - ТД „Европа 2002“ ДОО - Отешево, Ресен</p>
            </div>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
