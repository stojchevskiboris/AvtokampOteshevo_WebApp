<!DOCTYPE html>
<html lang="mk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Autocamp Otesevo - Автокамп Отешево | Camping | Otesevo, Macedonia</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

    <style>
        :root {
            --font-body: 'Plus Jakarta Sans', sans-serif;
            --font-display: 'Playfair Display', serif;
            --color-cream: #fbf9f5;
        }

        body {
            font-family: var(--font-body);
            background-color: var(--color-cream);
            color: #1e293b;
            margin: 0;
            padding: 0;
        }

        .font-display {
            font-family: var(--font-display);
        }

        .font-body {
            font-family: var(--font-body);
        }

        .bg-brand-gradient {
            background: linear-gradient(135deg, #1a3d2b 0%, #2d6a46 100%);
        }

        .text-brand-gradient {
            background: linear-gradient(135deg, #1a3d2b 0%, #2d6a46 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col antialiased">
    <!-- ── Header / Navigation ────────────────────────────────────────────── -->
    <header id="mainHeader" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-slate-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-6">
            <!-- Brand Logo -->
            <a href='@Url.Action("Index", "Home")' class="flex items-center gap-2.5 no-underline shrink-0 group">
                <div class="w-9 h-9 rounded-xl flex items-center justify-center text-white text-lg font-bold shadow-md bg-brand-gradient group-hover:scale-105 transition-transform">
                    А
                </div>
                <div class="flex flex-col leading-none">
                    <span class="text-sm font-semibold tracking-wide text-slate-800 font-body">
                        Автокамп
                    </span>
                    <span class="text-base font-normal text-slate-700 italic font-display">
                        Отешево
                    </span>
                </div>
            </a>

            <!-- Desktop Nav Links -->
            <nav class="max-sm:hidden sm:flex items-center gap-1">
                <a href='@Url.Action("Index", "Home")#home' class="px-4 py-2 rounded-full text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-all duration-200 no-underline font-body">
                    Дома
                </a>
                @if (User.IsInRole("Admin"))
                {
                    <a href='@Url.Action("Index", "Reservations")' class="px-4 py-2 rounded-full text-sm font-medium text-amber-700 bg-amber-50 hover:bg-amber-100 transition-all duration-200 no-underline font-body">
                        Резервации (Admin)
                    </a>
                }
                <a href='@Url.Action("Index", "Home")#about' class="px-4 py-2 rounded-full text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-all duration-200 no-underline font-body">
                    За нас
                </a>
                <a href='@Url.Action("Index", "Home")#contact' class="px-4 py-2 rounded-full text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-all duration-200 no-underline font-body">
                    Контакт
                </a>
            </nav>

            <div class="max-sm:hidden sm:flex items-center gap-4">
                @Html.Partial("_LoginPartial")
                <a href='@Url.Action("Create2", "Reservations")' class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-brand-gradient transition-all duration-200 hover:opacity-90 hover:shadow-lg active:scale-95 no-underline shadow-md" style="box-shadow: 0 4px 14px rgba(26,61,43,0.35);">
                    Резервирај <span class="text-xs">↗</span>
                </a>
            </div>

            <!-- Hamburger Button -->
            <button id="mobileMenuBtn" class="sm:hidden p-2 rounded-lg hover:bg-slate-100 transition cursor-pointer" aria-label="Menu">
                <div class="w-5 h-0.5 bg-slate-700 mb-1 transition-all"></div>
                <div class="w-5 h-0.5 bg-slate-700 mb-1 transition-all"></div>
                <div class="w-5 h-0.5 bg-slate-700 transition-all"></div>
            </button>
        </div>

        <!-- Mobile Menu Drawer -->
        <div id="mobileMenu" class="hidden sm:hidden border-t border-slate-100 bg-white/95 backdrop-blur-md px-6 py-4 flex flex-col gap-2">
            <a href='@Url.Action("Index", "Home")#home' class="py-2.5 px-3 rounded-xl text-slate-700 font-medium hover:bg-slate-50 no-underline font-body">
                Дома
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a href='@Url.Action("Index", "Reservations")' class="py-2.5 px-3 rounded-xl text-amber-700 font-medium hover:bg-amber-50 no-underline font-body">
                    Резервации (Admin)
                </a>
            }
            <a href='@Url.Action("Index", "Home")#about' class="py-2.5 px-3 rounded-xl text-slate-700 font-medium hover:bg-slate-50 no-underline font-body">
                За нас
            </a>
            <a href='@Url.Action("Index", "Home")#contact' class="py-2.5 px-3 rounded-xl text-slate-700 font-medium hover:bg-slate-50 no-underline font-body">
                Контакт
            </a>
            <div class="pt-2 border-t border-slate-100 flex flex-col gap-2">
                @Html.Partial("_LoginPartial")
                <a href='@Url.Action("Create2", "Reservations")' class="py-3 rounded-full text-white font-semibold text-center bg-brand-gradient no-underline">
                    Резервирај
                </a>
            </div>
        </div>
    </header>

    <!-- ── Main Content Body ─────────────────────────────────────────────── -->
    <main class="flex-grow pt-16">
        @RenderBody()
    </main>

    <!-- ── Contact / Footer ───────────────────────────────────────────────── -->
    <footer id="contact" class="py-20 px-6 text-white" style="background-color: #0d1f17;">
        <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-12">
            <!-- Brand Column -->
            <div>
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white text-lg font-bold" style="background: rgba(255,255,255,0.12);">
                        А
                    </div>
                    <div>
                        <div class="text-sm font-semibold opacity-80 font-body">Автокамп</div>
                        <div class="text-base italic font-display">Отешево</div>
                    </div>
                </div>
                <p class="text-white/50 text-sm leading-relaxed font-body">
                    Природен рај на бреговите на Преспанското Езеро. Дојдете и доживејте ја убавината на Македонија.
                </p>
            </div>

            <!-- Navigation Links Column -->
            <div>
                <h4 class="text-xs font-semibold uppercase tracking-widest opacity-50 mb-5 font-body">Навигација</h4>
                <div class="flex flex-col gap-3 font-body">
                    <a href='@Url.Action("Index", "Home")#home' class="text-white/60 hover:text-white text-sm transition no-underline">Дома</a>
                    <a href='@Url.Action("Create2", "Reservations")' class="text-white/60 hover:text-white text-sm transition no-underline">Резервирај</a>
                    <a href='@Url.Action("Index", "Home")#about' class="text-white/60 hover:text-white text-sm transition no-underline">За нас</a>
                    <a href='@Url.Action("Index", "Home")#contact' class="text-white/60 hover:text-white text-sm transition no-underline">Контакт</a>
                </div>
            </div>

            <!-- Contact Information Column -->
            <div>
                <h4 class="text-xs font-semibold uppercase tracking-widest opacity-50 mb-5 font-body">Контакт</h4>
                <div class="flex flex-col gap-3 text-sm text-white/60 font-body">
                    <span>📍 Отешево, Ресен, Македонија</span>
                    <span>📞 +389 47 000 000</span>
                    <span>✉️ info@autocamp-otesevo.mk</span>
                </div>
                <div class="mt-6">
                    <a href='@Url.Action("Create2", "Reservations")' class="inline-block px-6 py-3 rounded-full text-sm font-semibold text-white transition-all hover:opacity-90 no-underline cursor-pointer" style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.15);">
                        Резервирај сега →
                    </a>
                </div>
            </div>
        </div>

        <div class="max-w-6xl mx-auto mt-14 pt-6 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-white/30 text-xs font-body">
            <span>© @DateTime.Now.Year Автокамп Отешево. Сите права задржани.</span>
            <span>Преспанско Езеро, Р. Македонија</span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script>
        // Mobile Menu Toggle
        document.getElementById('mobileMenuBtn').addEventListener('click', function () {
            var menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        });

        // Sticky Header scroll styling
        window.addEventListener('scroll', function () {
            var header = document.getElementById('mainHeader');
            if (window.scrollY > 40) {
                header.classList.add('shadow-md');
            } else {
                header.classList.remove('shadow-md');
            }
        });
    </script>

    @RenderSection("scripts", required: false)
</body>
</html>
