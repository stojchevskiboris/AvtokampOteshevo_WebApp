                        </span>
                        @lang.ToUpperInvariant()
                        <span class="text-[10px]">▾</span>
                    </button>
                    <div x-show="open" x-transition x-cloak class="absolute right-0 mt-2 w-40 rounded-xl border border-slate-100 bg-white shadow-xl py-1 z-50">
                        <a href="@Url.ForCulture("mk")" lang="mk" hreflang="mk" class="block px-4 py-2 text-xs text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 no-underline font-body @(lang == "mk" ? "font-bold text-emerald-700 bg-emerald-50/50" : "")">Македонски</a>
                        <a href="@Url.ForCulture("en")" lang="en" hreflang="en" class="block px-4 py-2 text-xs text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 no-underline font-body @(lang == "en" ? "font-bold text-emerald-700 bg-emerald-50/50" : "")">English</a>
                        <a href="@Url.ForCulture("sq")" lang="sq" hreflang="sq" class="block px-4 py-2 text-xs text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 no-underline font-body @(lang == "sq" ? "font-bold text-emerald-700 bg-emerald-50/50" : "")">Shqip</a>
                        <a href="@Url.ForCulture("sr")" lang="sr" hreflang="sr" class="block px-4 py-2 text-xs text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 no-underline font-body @(lang == "sr" ? "font-bold text-emerald-700 bg-emerald-50/50" : "")">Српски</a>
                        <a href="@Url.ForCulture("de")" lang="de" hreflang="de" class="block px-4 py-2 text-xs text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 no-underline font-body @(lang == "de" ? "font-bold text-emerald-700 bg-emerald-50/50" : "")">Deutsch</a>
                        <a href="@Url.ForCulture("pl")" lang="pl" hreflang="pl" class="block px-4 py-2 text-xs text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 no-underline font-body @(lang == "pl" ? "font-bold text-emerald-700 bg-emerald-50/50" : "")">Polski</a>
                        <a href="@Url.ForCulture("it")" lang="it" hreflang="it" class="block px-4 py-2 text-xs text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 no-underline font-body @(lang == "it" ? "font-bold text-emerald-700 bg-emerald-50/50" : "")">Italiano</a>
                        <a href="@Url.ForCulture("el")" lang="el" hreflang="el" class="block px-4 py-2 text-xs text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 no-underline font-body @(lang == "el" ? "font-bold text-emerald-700 bg-emerald-50/50" : "")">Ελληνικά</a>
                        <a href="@Url.ForCulture("es")" lang="es" hreflang="es" class="block px-4 py-2 text-xs text-slate-700 hover:bg-emerald-50 hover:text-emerald-800 no-underline font-body @(lang == "es" ? "font-bold text-emerald-700 bg-emerald-50/50" : "")">Español</a>
                    </div>
                </div>

                @Html.Partial("_LoginPartial")
                <a href='@Url.Action("New", "Reservations")' class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-brand-gradient transition-all duration-200 hover:opacity-90 hover:shadow-lg active:scale-95 no-underline shadow-md" style="box-shadow: 0 4px 14px rgba(26,61,43,0.35);">
                    @Strings.Nav_Book <span class="text-xs">↗</span>
                </a>
            </div>

            <!-- Hamburger Button -->
            <button id="mobileMenuBtn" class="sm:hidden p-2 rounded-lg hover:bg-slate-100 transition cursor-pointer" aria-label="Menu">
                <div class="w-5 h-0.5 bg-slate-700 mb-1 transition-all"></div>
                <div class="w-5 h-0.5 bg-slate-700 mb-1 transition-all"></div>
                <div class="w-5 h-0.5 bg-slate-700 transition-all"></div>
            </button>
        </div>

        <!-- Mobile Menu Overlay -->
        <div id="mobileMenuOverlay"
             class="hidden sm:hidden fixed inset-0 bg-black/40 backdrop-blur-[1px] z-40">
        </div>

        <!-- Mobile Menu Drawer -->
        <div id="mobileMenu" class="hidden sm:hidden text-xl z-50 border-t border-slate-100 bg-white/95 backdrop-blur-md px-6 py-4 flex flex-col gap-2 overflow-y-auto max-h-[50dvh]">
            <a href='@Url.Action("Index", "Home")#home'
               class="py-2.5 px-3 rounded-xl font-medium hover:bg-slate-50 no-underline font-body transition-all border-l-4 @(currentController.ToLower() == "home" && currentAction.ToLower() == "index" ? "text-[#2d6a46] bg-slate-100/80 border-[#2d6a46] font-semibold" : "text-slate-700 border-transparent")">
                @Strings.Nav_Home
            </a>

            <a href='@Url.Action("Index", "News")'
               class="py-2.5 px-3 rounded-xl font-medium hover:bg-slate-50 no-underline font-body transition-all border-l-4 @(currentController.ToLower() == "news" ? "text-[#2d6a46] bg-slate-100/80 border-[#2d6a46] font-semibold" : "text-slate-700 border-transparent")">
                @Strings.Nav_News
            </a>

            @if (isAuthenticated)
            {
                <a href='@Url.Action("Index", "AdminReservations")'
                   class="py-2.5 px-3 rounded-xl font-medium hover:bg-amber-100/80 no-underline font-body transition-all border-l-4 @(currentController.ToLower() == "adminreservations" ? "text-[#2d6a46] bg-amber-100/60 border-[#2d6a46] font-semibold" : "text-amber-700 bg-amber-50 border-transparent")">
                    @Strings.Nav_Reservations
                </a>
                <a href='@Url.Action("Index", "FeedItems")'
                   class="py-2.5 px-3 rounded-xl font-medium hover:bg-amber-100/80 no-underline font-body transition-all border-l-4 @(currentController.ToLower() == "feeditems" ? "text-[#2d6a46] bg-amber-100/60 border-[#2d6a46] font-semibold" : "text-amber-700 bg-amber-50 border-transparent")">
                    @Strings.Nav_EditNews
                </a>
                <a href='@Url.Action("Index", "AdminSettings")'
                   class="py-2.5 px-3 rounded-xl font-medium hover:bg-amber-100/80 no-underline font-body transition-all border-l-4 @(currentController.ToLower() == "adminsettings" ? "text-[#2d6a46] bg-amber-100/60 border-[#2d6a46] font-semibold" : "text-amber-700 bg-amber-50 border-transparent")">
                    @Strings.Nav_Settings
                </a>
                <a href='@Url.Action("Index", "AdminFileManager")'
                   class="py-2.5 px-3 rounded-xl font-medium hover:bg-amber-100/80 no-underline font-body transition-all border-l-4 @(currentController.ToLower() == "adminfilemanager" ? "text-[#2d6a46] bg-amber-100/60 border-[#2d6a46] font-semibold" : "text-amber-700 bg-amber-50 border-transparent")">
                    @Strings.Nav_FileManager
                </a>
            }

            <a href='@Url.Action("About", "Home")'
               class="py-2.5 px-3 rounded-xl font-medium hover:bg-slate-50 no-underline font-body transition-all border-l-4 @(currentController.ToLower() == "home" && currentAction.ToLower() == "about" ? "text-[#2d6a46] bg-slate-100/80 border-[#2d6a46] font-semibold" : "text-slate-700 border-transparent")">
                @Strings.Nav_About
            </a>

            <a href='@Url.Action("Contact", "Home")'
               class="py-2.5 px-3 rounded-xl font-medium hover:bg-slate-50 no-underline font-body transition-all border-l-4 @(currentController.ToLower() == "home" && currentAction.ToLower() == "contact" ? "text-[#2d6a46] bg-slate-100/80 border-[#2d6a46] font-semibold" : "text-slate-700 border-transparent")">
                @Strings.Nav_Contact
            </a>

            <div class="pt-2 border-t border-slate-100 flex flex-col gap-2">
                @Html.Partial("_LoginPartial")
                <a href='@Url.Action("New", "Reservations")' class="py-3 rounded-full text-white font-semibold text-center bg-brand-gradient no-underline">
                    @Strings.Nav_Book
                </a>
            </div>

            <!-- Mobile Language Switcher -->
            <div class="py-2 px-3 border-t border-slate-100 font-body text-xs flex flex-wrap gap-2 text-slate-600" aria-label="Language">
                <a href="@Url.ForCulture("mk")" lang="mk" hreflang="mk" class="px-2 py-1 rounded bg-slate-100 hover:bg-emerald-100 text-slate-800 no-underline @(lang == "mk" ? "font-bold text-emerald-800 bg-emerald-100" : "")">Македонски</a>
                <a href="@Url.ForCulture("en")" lang="en" hreflang="en" class="px-2 py-1 rounded bg-slate-100 hover:bg-emerald-100 text-slate-800 no-underline @(lang == "en" ? "font-bold text-emerald-800 bg-emerald-100" : "")">English</a>
                <a href="@Url.ForCulture("sq")" lang="sq" hreflang="sq" class="px-2 py-1 rounded bg-slate-100 hover:bg-emerald-100 text-slate-800 no-underline @(lang == "sq" ? "font-bold text-emerald-800 bg-emerald-100" : "")">Shqip</a>
                <a href="@Url.ForCulture("sr")" lang="sr" hreflang="sr" class="px-2 py-1 rounded bg-slate-100 hover:bg-emerald-100 text-slate-800 no-underline @(lang == "sr" ? "font-bold text-emerald-800 bg-emerald-100" : "")">Српски</a>
                <a href="@Url.ForCulture("de")" lang="de" hreflang="de" class="px-2 py-1 rounded bg-slate-100 hover:bg-emerald-100 text-slate-800 no-underline @(lang == "de" ? "font-bold text-emerald-800 bg-emerald-100" : "")">Deutsch</a>
                <a href="@Url.ForCulture("pl")" lang="pl" hreflang="pl" class="px-2 py-1 rounded bg-slate-100 hover:bg-emerald-100 text-slate-800 no-underline @(lang == "pl" ? "font-bold text-emerald-800 bg-emerald-100" : "")">Polski</a>
                <a href="@Url.ForCulture("it")" lang="it" hreflang="it" class="px-2 py-1 rounded bg-slate-100 hover:bg-emerald-100 text-slate-800 no-underline @(lang == "it" ? "font-bold text-emerald-800 bg-emerald-100" : "")">Italiano</a>
                <a href="@Url.ForCulture("el")" lang="el" hreflang="el" class="px-2 py-1 rounded bg-slate-100 hover:bg-emerald-100 text-slate-800 no-underline @(lang == "el" ? "font-bold text-emerald-800 bg-emerald-100" : "")">Ελληνικά</a>
                <a href="@Url.ForCulture("es")" lang="es" hreflang="es" class="px-2 py-1 rounded bg-slate-100 hover:bg-emerald-100 text-slate-800 no-underline @(lang == "es" ? "font-bold text-emerald-800 bg-emerald-100" : "")">Español</a>
            </div>
        </div>
    </header>

    <!-- ── Main Content Body ─────────────────────────────────────────────── -->
    <main class="flex-grow pt-16 animate-fadeIn">
        @RenderBody()
    </main>

    <!-- ── Contact / Footer ───────────────────────────────────────────────── -->
    <footer id="contact" class="py-20 px-6 text-white" style="background-color: #0d1f17;">
        <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-12">
            <!-- Brand Column -->
            <div>
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white text-lg font-bold" style="background: rgba(255,255,255,0.12);">
                        <img src="~/Content/logo.png" alt="Logo" class="w-full h-full object-contain" />
                    </div>
                    <div>
                        <div class="text-sm font-semibold opacity-80 font-body">@Strings.Site_Name</div>
                        <div class="text-base italic font-display">@Strings.Home_Hero_Sub_2</div>
                    </div>
                </div>
                <p class="text-white/50 text-sm leading-relaxed font-body">
                    @Strings.Site_Footer_Desc
                </p>
            </div>

            <!-- Navigation Links Column -->
            <div>
                <h4 class="text-xs font-semibold uppercase tracking-widest opacity-50 mb-5 font-body">@Strings.Nav_Home</h4>
                <div class="flex flex-col gap-3 font-body">
                    <a href='@Url.Action("Index", "Home")#home' class="text-white/60 hover:text-white text-sm transition no-underline">@Strings.Nav_Home</a>
                    <a href='@Url.Action("New", "Reservations")' class="text-white/60 hover:text-white text-sm transition no-underline">@Strings.Nav_Book</a>
                    <a href='@Url.Action("Index", "News")' class="text-white/60 hover:text-white text-sm transition no-underline">@Strings.Nav_News</a>
                    <a href='@Url.Action("About", "Home")' class="text-white/60 hover:text-white text-sm transition no-underline">@Strings.Nav_About</a>
                    <a href='@Url.Action("Contact", "Home")' class="text-white/60 hover:text-white text-sm transition no-underline">@Strings.Nav_Contact</a>
                </div>
            </div>

            <!-- Contact Information Column -->
            <div>
                <h4 class="text-xs font-semibold uppercase tracking-widest opacity-50 mb-5 font-body">@Strings.Nav_Contact</h4>
                <div class="flex flex-col gap-3 text-sm text-white/60 font-body">
                    <span>📍 @Strings.Contact_Address_Val</span>
                    <span>📞 <a href="tel:+38970207259">070207259</a></span>
                    <span>✉️ <a href="mailto:avtokamp.otesevo@gmail.com">avtokamp.otesevo@gmail.com</a></span>
                </div>
                <div class="mt-6">
                    <a href='@Url.Action("New", "Reservations")' class="inline-block px-6 py-3 rounded-full text-sm font-semibold text-white transition-all hover:opacity-90 no-underline cursor-pointer" style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.15);">
                        @Strings.Nav_Book →
                    </a>
                </div>
            </div>
        </div>

        <div class="max-w-6xl mx-auto mt-14 pt-6 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-white/30 text-xs font-body">
            <span>© @DateTime.Now.Year @Strings.Site_Footer_Rights</span>
            <span>@Strings.Site_Footer_Location</span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script src="~/Scripts/js/global.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
