<!DOCTYPE html>
<html lang="mk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Autocamp Otesevo - Автокамп Отешево | Camping | Otesevo, Macedonia</title>

    <!-- Canonical Tag -->
    @{
        string rawPath = Request.Url.AbsolutePath.ToLowerInvariant();
        if (rawPath.EndsWith("/home/index"))
        {
            rawPath = rawPath.Substring(0, rawPath.Length - 10); // Normalizes /home/index to /
        }
        string canonicalUrl = $"{Request.Url.Scheme}://{Request.Url.Authority}{rawPath}";
    }
    <link rel="canonical" href="@canonicalUrl" />

    <!-- Facebook App ID -->
    <meta property="fb:app_id" content="1219520254588206" />

    <!-- Basic Open Graph Tags -->
    <meta property="og:site_name" content="Autocamp Otesevo" />
    <meta property="og:locale" content="mk_MK" />

    @if (IsSectionDefined("OGMeta"))
    {
        @RenderSection("OGMeta", required: false)
    }
    else
    {
        <!-- Default Fallback OG Tags for General Pages -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content="@Request.Url.AbsoluteUri" />
        <meta property="og:title" content="Autocamp Otesevo - Автокамп Отешево | Camping & RV Park Lake Prespa" />
        <meta property="og:description" content="Reserve your stay at Autocamp Otesevo on Lake Prespa. Enjoy lakeside camping, campervan pitches, and nature stays near Galicica National Park." />
        <meta property="og:image" content="https://www.otesevo.com/Content/bungalows_1200x630.jpg" />
        <meta property="og:image:secure_url" content="https://www.otesevo.com/Content/bungalows_1200x630.jpg" />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="Autocamp Otesevo campsite on Lake Prespa" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="Autocamp Otesevo | Camping Lake Prespa" />
        <meta name="twitter:description" content="Lakeside camping and RV pitches at Autocamp Otesevo." />
        <meta name="twitter:image" content="https://www.otesevo.com/Content/bungalows_1200x630.jpg" />
    }

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FY6047P9JE"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-FY6047P9JE');
    </script>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- Tailwind CSS CDN -->
    <script src="~/Scripts/tailwind_3-4-17.min.js"></script>

    <!-- Alpine.js CDN for collapsible states (x-data, x-collapse) -->
    <script defer src="~/Scripts/alpinejs.min.js"></script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link rel="stylesheet" href="~/Scripts/css/style.css" />
</head>

<body class="min-h-screen flex flex-col antialiased">
    <!-- ── Header / Navigation ────────────────────────────────────────────── -->
    <header id="mainHeader" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-slate-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-6">
            <!-- Brand Logo -->
            <a href='@Url.Action("Index", "Home")' class="flex items-center gap-2.5 no-underline shrink-0 group">
                <div class="w-9 h-9 rounded-xl flex items-center justify-center text-white text-lg font-bold shadow-md group-hover:scale-105 transition-transform">
                    <img src="~/Content/logo.png" alt="Logo" class="w-full h-full object-contain" />
                </div>
                <div class="flex flex-col leading-none">
                    <span class="text-sm font-semibold tracking-wide text-slate-800 font-body">
                        Автокамп
                    </span>
                    <span class="text-base font-normal text-slate-700 italic font-display">
                        Отешево
                    </span>
                </div>
            </a>

            @{
                string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                string currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                bool isAuthenticated = User?.Identity != null && User.Identity.IsAuthenticated;
            }

            <!-- Desktop Nav Links -->
            <nav class="max-sm:hidden sm:flex items-center gap-1">
                <a href='@Url.Action("Index", "Home")#home'
                   class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 no-underline font-body relative text-slate-700 hover:text-slate-900 hover:bg-slate-100 @(currentController == "Home" && currentAction == "Index" ? "font-semibold after:content-[''] after:absolute after:bottom-1 after:left-4 after:right-4 after:h-[2px] after:bg-[#2d6a46]" : "")">
                    Дома
                </a>

                <a href='@Url.Action("Index", "News")'
                   class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 no-underline font-body relative text-slate-700 hover:text-slate-900 hover:bg-slate-100 @(currentController == "News" ? "font-semibold after:content-[''] after:absolute after:bottom-1 after:left-4 after:right-4 after:h-[2px] after:bg-[#2d6a46]" : "")">
                    Новости
                </a>

                <a href='@Url.Action("About", "Home")'
                   class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 no-underline font-body relative text-slate-700 hover:text-slate-900 hover:bg-slate-100 @(currentController == "Home" && currentAction == "About" ? "font-semibold after:content-[''] after:absolute after:bottom-1 after:left-4 after:right-4 after:h-[2px] after:bg-[#2d6a46]" : "")">
                    За нас
                </a>

                <a href='@Url.Action("Contact", "Home")'
                   class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 no-underline font-body relative text-slate-700 hover:text-slate-900 hover:bg-slate-100 @(currentController == "Home" && currentAction == "Contact" ? "font-semibold after:content-[''] after:absolute after:bottom-1 after:left-4 after:right-4 after:h-[2px] after:bg-[#2d6a46]" : "")">
                    Контакт
                </a>

                @if (isAuthenticated)
                {
                    <div class="relative">
                        <button id="adminDropdownBtn" type="button"
                                class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 no-underline font-body relative text-amber-700 bg-amber-50 hover:bg-amber-100 inline-flex items-center gap-1 cursor-pointer">
                            Администрација
                            <span class="text-xs">▾</span>
                        </button>
                        <div id="adminDropdownMenu" class="absolute right-0 mt-2 w-56 rounded-xl border border-slate-100 bg-white shadow-lg hidden z-50">
                            <a href='@Url.Action("Index", "AdminReservations")'
                               class="block px-4 py-2 text-sm text-slate-700 no-underline hover:bg-slate-50 rounded-t-xl @(currentController == "AdminReservations" ? "font-semibold text-emerald-700" : "")">
                                Резервации
                            </a>
                            <a href='@Url.Action("Index", "FeedItems")'
                               class="block px-4 py-2 text-sm text-slate-700 no-underline hover:bg-slate-50 @(currentController == "FeedItems" ? "font-semibold text-emerald-700" : "")">
                                Новости
                            </a>
                            <a href='@Url.Action("Index", "AdminSettings")'
                               class="block px-4 py-2 text-sm text-slate-700 no-underline hover:bg-slate-50 @(currentController == "AdminSettings" ? "font-semibold text-emerald-700" : "")">
                                Подесувања
                            </a>
                            <a href='@Url.Action("Index", "AdminFileManager")'
                               class="block px-4 py-2 text-sm text-slate-700 no-underline hover:bg-slate-50 rounded-b-xl @(currentController == "AdminFileManager" ? "font-semibold text-emerald-700" : "")">
                                File Manager
                            </a>
                        </div>
                    </div>
                }
            </nav>

            <div class="max-sm:hidden sm:flex items-center gap-4">
                @Html.Partial("_LoginPartial")
                <a href='@Url.Action("New", "Reservations")' class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full text-sm font-semibold text-white bg-brand-gradient transition-all duration-200 hover:opacity-90 hover:shadow-lg active:scale-95 no-underline shadow-md" style="box-shadow: 0 4px 14px rgba(26,61,43,0.35);">
                    Резервирај <span class="text-xs">↗</span>
                </a>
            </div>

            <!-- Hamburger Button -->
            <button id="mobileMenuBtn" class="sm:hidden p-2 rounded-lg hover:bg-slate-100 transition cursor-pointer" aria-label="Menu">
                <div class="w-5 h-0.5 bg-slate-700 mb-1 transition-all"></div>
                <div class="w-5 h-0.5 bg-slate-700 mb-1 transition-all"></div>
                <div class="w-5 h-0.5 bg-slate-700 transition-all"></div>
            </button>
        </div>

        <!-- Mobile Menu Drawer -->
        <div id="mobileMenu" class="hidden sm:hidden text-xl border-t border-slate-100 bg-white/95 backdrop-blur-md px-6 py-4 flex flex-col gap-2 overflow-y-auto max-h-[calc(100vh-4rem)]">
            <a href='@Url.Action("Index", "Home")#home'
               class="py-2.5 px-3 rounded-xl font-medium hover:bg-slate-50 no-underline font-body transition-all border-l-4 @(currentController == "Home" && currentAction == "Index" ? "text-[#2d6a46] bg-slate-100/80 border-[#2d6a46] font-semibold" : "text-slate-700 border-transparent")">
                Дома
            </a>

            <a href='@Url.Action("Index", "News")'
               class="py-2.5 px-3 rounded-xl font-medium hover:bg-slate-50 no-underline font-body transition-all border-l-4 @(currentController == "News" ? "text-[#2d6a46] bg-slate-100/80 border-[#2d6a46] font-semibold" : "text-slate-700 border-transparent")">
                Новости & Понуди
            </a>

            @if (isAuthenticated)
            {
                <a href='@Url.Action("Index", "AdminReservations")'
                   class="py-2.5 px-3 rounded-xl font-medium hover:bg-amber-100/80 no-underline font-body transition-all border-l-4 @(currentController == "AdminReservations" ? "text-[#2d6a46] bg-amber-100/60 border-[#2d6a46] font-semibold" : "text-amber-700 bg-amber-50 border-transparent")">
                    Резервации
                </a>
                <a href='@Url.Action("Index", "FeedItems")'
                   class="py-2.5 px-3 rounded-xl font-medium hover:bg-amber-100/80 no-underline font-body transition-all border-l-4 @(currentController == "FeedItems" ? "text-[#2d6a46] bg-amber-100/60 border-[#2d6a46] font-semibold" : "text-amber-700 bg-amber-50 border-transparent")">
                    Уреди Новости
                </a>
                <a href='@Url.Action("Index", "AdminSettings")'
                   class="py-2.5 px-3 rounded-xl font-medium hover:bg-amber-100/80 no-underline font-body transition-all border-l-4 @(currentController == "AdminSettings" ? "text-[#2d6a46] bg-amber-100/60 border-[#2d6a46] font-semibold" : "text-amber-700 bg-amber-50 border-transparent")">
                    Подесувања
                </a>
                <a href='@Url.Action("Index", "AdminFileManager")'
                   class="py-2.5 px-3 rounded-xl font-medium hover:bg-amber-100/80 no-underline font-body transition-all border-l-4 @(currentController == "AdminFileManager" ? "text-[#2d6a46] bg-amber-100/60 border-[#2d6a46] font-semibold" : "text-amber-700 bg-amber-50 border-transparent")">
                    File Manager
                </a>
            }

            <a href='@Url.Action("About", "Home")'
               class="py-2.5 px-3 rounded-xl font-medium hover:bg-slate-50 no-underline font-body transition-all border-l-4 @(currentController == "Home" && currentAction == "About" ? "text-[#2d6a46] bg-slate-100/80 border-[#2d6a46] font-semibold" : "text-slate-700 border-transparent")">
                За нас
            </a>

            <a href='@Url.Action("Contact", "Home")'
               class="py-2.5 px-3 rounded-xl font-medium hover:bg-slate-50 no-underline font-body transition-all border-l-4 @(currentController == "Home" && currentAction == "Contact" ? "text-[#2d6a46] bg-slate-100/80 border-[#2d6a46] font-semibold" : "text-slate-700 border-transparent")">
                Контакт
            </a>

            <div class="pt-2 border-t border-slate-100 flex flex-col gap-2">
                @Html.Partial("_LoginPartial")
                <a href='@Url.Action("New", "Reservations")' class="py-3 rounded-full text-white font-semibold text-center bg-brand-gradient no-underline">
                    Резервирај
                </a>
            </div>
        </div>
    </header>

    <!-- ── Main Content Body ─────────────────────────────────────────────── -->
    <main class="flex-grow pt-16 animate-fadeIn">
        @RenderBody()
    </main>

    <!-- ── Contact / Footer ───────────────────────────────────────────────── -->
    <footer id="contact" class="py-20 px-6 text-white" style="background-color: #0d1f17;">
        <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-12">
            <!-- Brand Column -->
            <div>
                <div class="flex items-center gap-3 mb-5">
                    <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white text-lg font-bold" style="background: rgba(255,255,255,0.12);">
                        <img src="~/Content/logo.png" alt="Logo" class="w-full h-full object-contain" />
                    </div>
                    <div>
                        <div class="text-sm font-semibold opacity-80 font-body">Автокамп</div>
                        <div class="text-base italic font-display">Отешево</div>
                    </div>
                </div>
                <p class="text-white/50 text-sm leading-relaxed font-body">
                    Природен рај на брегот на Преспанското Езеро. Дојдете и доживејте ја убавината на нашиот Автокамп.
                </p>
            </div>

            <!-- Navigation Links Column -->
            <div>
                <h4 class="text-xs font-semibold uppercase tracking-widest opacity-50 mb-5 font-body">Навигација</h4>
                <div class="flex flex-col gap-3 font-body">
                    <a href='@Url.Action("Index", "Home")#home' class="text-white/60 hover:text-white text-sm transition no-underline">Дома</a>
                    <a href='@Url.Action("New", "Reservations")' class="text-white/60 hover:text-white text-sm transition no-underline">Резервирај</a>
                    <a href='@Url.Action("Index", "News")' class="text-white/60 hover:text-white text-sm transition no-underline">Новости и понуди</a>
                    <a href='@Url.Action("About", "Home")' class="text-white/60 hover:text-white text-sm transition no-underline">За нас</a>
                    <a href='@Url.Action("Contact", "Home")' class="text-white/60 hover:text-white text-sm transition no-underline">Контакт</a>
                </div>
            </div>

            <!-- Contact Information Column -->
            <div>
                <h4 class="text-xs font-semibold uppercase tracking-widest opacity-50 mb-5 font-body">Контакт</h4>
                <div class="flex flex-col gap-3 text-sm text-white/60 font-body">
                    <span>📍 Отешево, Ресен, Македонија</span>
                    <span>📞 <a href="tel:+38970207259">070207259</a></span>
                    <span>✉️ <a href="mailto:avtokamp.otesevo@gmail.com">avtokamp.otesevo@gmail.com</a></span>
                </div>
                <div class="mt-6">
                    <a href='@Url.Action("New", "Reservations")' class="inline-block px-6 py-3 rounded-full text-sm font-semibold text-white transition-all hover:opacity-90 no-underline cursor-pointer" style="background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.15);">
                        Резервирај сега →
                    </a>
                </div>
            </div>
        </div>

        <div class="max-w-6xl mx-auto mt-14 pt-6 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4 text-white/30 text-xs font-body">
            <span>© @DateTime.Now.Year Автокамп Отешево. Сите права задржани.</span>
            <span>Преспанско Езеро, Р. Македонија</span>
        </div>
    </footer>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script src="~/Scripts/js/global.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
