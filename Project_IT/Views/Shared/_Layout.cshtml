@using System.Configuration
@{
    var lang = CultureHelper.Current;
    string site = ConfigurationManager.AppSettings["BaseUrl"] ?? "https://www.otesevo.com";
    if (site.EndsWith("/"))
    {
        site = site.TrimEnd('/');
    }
    string pageTitle = ViewBag.Title ?? Strings.Home_Meta_Title;
    string pageDesc = ViewBag.Description ?? Strings.Home_Meta_Desc;
}
<!DOCTYPE html>
<html lang="@lang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@pageTitle</title>
    <meta name="description" content="@pageDesc" />

    <!-- Canonical & hreflang Tags -->
    <link rel="canonical" href="@(site + Url.ForCulture(lang))" />
    @foreach (var l in CultureHelper.Supported)
    {
        <link rel="alternate" hreflang="@l" href="@(site + Url.ForCulture(l))" />
    }
    <link rel="alternate" hreflang="x-default" href="@site/" />

    <!-- Facebook App ID -->
    <meta property="fb:app_id" content="1219520254588206" />

    <!-- Basic Open Graph Tags -->
    <meta property="og:site_name" content="@Strings.Site_Name" />
    <meta property="og:locale" content="@CultureHelper.OgLocale(lang)" />

    @if (IsSectionDefined("OGMeta"))
    {
        @RenderSection("OGMeta", required: false)
    }
    else
    {
        <!-- Default Fallback OG Tags for General Pages -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content="@Request.Url.AbsoluteUri" />
        <meta property="og:title" content="@pageTitle" />
        <meta property="og:description" content="@pageDesc" />
        <meta property="og:image" content="@(site)/Content/bungalows_1200x630.jpg" />
        <meta property="og:image:secure_url" content="@(site)/Content/bungalows_1200x630.jpg" />
        <meta property="og:image:type" content="image/jpeg" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="@Strings.Site_Name" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@pageTitle" />
        <meta name="twitter:description" content="@pageDesc" />
        <meta name="twitter:image" content="@(site)/Content/bungalows_1200x630.jpg" />
    }

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-FY6047P9JE"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'G-FY6047P9JE');
    </script>

    <!-- Global i18n object for client-side JavaScript -->
    <script>
        window.i18n = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(new {
            sending = Strings.Res_Sending,
            sendRequest = Strings.Js_SendRequest,
            thankYou = Strings.Res_Success_Title,
            successMsg = Strings.Res_Success_Msg,
            genericError = Strings.Val_Generic_Error,
            emailError = Strings.Val_Email
        }));
    </script>

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <!-- Tailwind CSS CDN -->
    <script src="~/Scripts/tailwind_3-4-17.min.js"></script>

    <!-- Alpine.js CDN for collapsible states (x-data, x-collapse) -->
    <script defer src="~/Scripts/alpinejs.min.js"></script>

    <link rel="stylesheet" href="~/Scripts/css/style.css" />
    <style>
        [x-cloak] {
            display: none !important;
        }
    </style>
</head>

<body class="min-h-screen flex flex-col antialiased">
    <!-- ── Header / Navigation ────────────────────────────────────────────── -->
    <header id="mainHeader" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-white/80 backdrop-blur-md border-b border-slate-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between gap-6">
            <!-- Brand Logo -->
            <a href='@Url.Action("Index", "Home")' class="flex items-center gap-2.5 no-underline shrink-0 group">
                <div class="w-9 h-9 rounded-xl flex items-center justify-center text-white text-lg font-bold shadow-md group-hover:scale-105 transition-transform">
                    <img src="~/Content/logo.png" alt="Logo" class="w-full h-full object-contain" />
                </div>
                <div class="flex flex-col leading-none">
                    <span class="text-sm font-semibold tracking-wide text-slate-800 font-body">
                        @Strings.Site_Name
                    </span>
                    <span class="text-xs font-normal text-slate-500 italic font-display">
                        @Strings.Site_Name_Sub
                    </span>
                </div>
            </a>

            @{
                string currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                string currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                bool isAuthenticated = User?.Identity != null && User.Identity.IsAuthenticated;
            }

            <!-- Desktop Nav Links -->
            <nav class="max-sm:hidden sm:flex items-center gap-1">
                <a href='@Url.Action("Index", "Home")#home'
                   class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 no-underline font-body relative text-slate-700 hover:text-slate-900 hover:bg-slate-100 @(currentController.ToLower() == "home" && currentAction.ToLower() == "index" ? "font-semibold after:content-[''] after:absolute after:bottom-1 after:left-4 after:right-4 after:h-[2px] after:bg-[#2d6a46]" : "")">
                    @Strings.Nav_Home
                </a>

                <a href='@Url.Action("Index", "News")'
                   class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 no-underline font-body relative text-slate-700 hover:text-slate-900 hover:bg-slate-100 @(currentController.ToLower() == "news" ? "font-semibold after:content-[''] after:absolute after:bottom-1 after:left-4 after:right-4 after:h-[2px] after:bg-[#2d6a46]" : "")">
                    @Strings.Nav_News
                </a>

                <a href='@Url.Action("About", "Home")'
                   class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 no-underline font-body relative text-slate-700 hover:text-slate-900 hover:bg-slate-100 @(currentController.ToLower() == "home" && currentAction.ToLower() == "about" ? "font-semibold after:content-[''] after:absolute after:bottom-1 after:left-4 after:right-4 after:h-[2px] after:bg-[#2d6a46]" : "")">
                    @Strings.Nav_About
                </a>

                <a href='@Url.Action("Contact", "Home")'
                   class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 no-underline font-body relative text-slate-700 hover:text-slate-900 hover:bg-slate-100 @(currentController.ToLower() == "home" && currentAction.ToLower() == "contact" ? "font-semibold after:content-[''] after:absolute after:bottom-1 after:left-4 after:right-4 after:h-[2px] after:bg-[#2d6a46]" : "")">
                    @Strings.Nav_Contact
                </a>

                @if (isAuthenticated)
                {
                    <div class="relative">
                        <button id="adminDropdownBtn" type="button"
                                class="px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 no-underline font-body relative text-amber-700 bg-amber-50 hover:bg-amber-100 inline-flex items-center gap-1 cursor-pointer">
                            @Strings.Nav_Admin
                            <span class="text-xs">▾</span>
                        </button>
                        <div id="adminDropdownMenu" class="absolute right-0 mt-2 w-56 rounded-xl border border-slate-100 bg-white shadow-lg hidden z-50">
                            <a href='@Url.Action("Index", "AdminReservations")'
                               class="block px-4 py-2 text-sm text-slate-700 no-underline hover:bg-slate-50 rounded-t-xl @(currentController.ToLower() == "adminreservations" ? "font-semibold text-emerald-700" : "")">
                                @Strings.Nav_Reservations
                            </a>
                            <a href='@Url.Action("Index", "FeedItems")'
                               class="block px-4 py-2 text-sm text-slate-700 no-underline hover:bg-slate-50 @(currentController.ToLower() == "feeditems" ? "font-semibold text-emerald-700" : "")">
                                @Strings.Nav_EditNews
                            </a>
                            <a href='@Url.Action("Index", "AdminSettings")'
                               class="block px-4 py-2 text-sm text-slate-700 no-underline hover:bg-slate-50 @(currentController.ToLower() == "adminsettings" ? "font-semibold text-emerald-700" : "")">
                                @Strings.Nav_Settings
                            </a>
                            <a href='@Url.Action("Index", "AdminFileManager")'
                               class="block px-4 py-2 text-sm text-slate-700 no-underline hover:bg-slate-50 rounded-b-xl @(currentController.ToLower() == "adminfilemanager" ? "font-semibold text-emerald-700" : "")">
                                @Strings.Nav_FileManager
                            </a>
                        </div>
                    </div>
                }
            </nav>

            <div class="max-sm:hidden sm:flex items-center gap-3">
                <!-- Language Switcher Dropdown -->
                <div class="relative" x-data="{ open: false }">
                    <button @@click="open = !open" @@click.outside="open = false" type="button" aria-label="Language Switcher"
                            class="px-3 py-1.5 rounded-full text-xs font-semibold text-slate-700 hover:bg-slate-100 inline-flex items-center gap-1.5 transition border border-slate-200 uppercase font-body cursor-pointer">
                        <span class="flex">
                            <svg width="10px" viewBox="-3.69 -3.69 81.15 81.15" xmlns="http://www.w3.org/2000/svg" fill="#2d6a46" stroke="#2d6a46" stroke-width="1.770432" transform="rotate(0)"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round" stroke="#b8b8b8" stroke-width="4.42608"> <path id="Path_10" data-name="Path 10" d="M117.606,385.2a36.884,36.884,0,1,0,36.884,36.884A36.926,36.926,0,0,0,117.606,385.2Zm33.846,35.383H136.366a48.681,48.681,0,0,0-3.047-16.068,36.786,36.786,0,0,0,8.781-5.808A33.752,33.752,0,0,1,151.452,420.586Zm-32.346-31.072a36.534,36.534,0,0,1,6.069,6.387,39.467,39.467,0,0,1,4.176,7.028,33.843,33.843,0,0,1-10.245,2.061Zm3.534-.935a33.762,33.762,0,0,1,17.292,8.051,33.809,33.809,0,0,1-7.772,5.116A41.252,41.252,0,0,0,122.64,388.579ZM110.19,395.9a36.615,36.615,0,0,1,5.916-6.261v15.35a33.789,33.789,0,0,1-10.116-2.013A39.5,39.5,0,0,1,110.19,395.9Zm-7.013,5.906a33.8,33.8,0,0,1-7.9-5.177,33.757,33.757,0,0,1,17.469-8.074A41.244,41.244,0,0,0,103.177,401.807Zm12.929,6.183v12.6H102a45.607,45.607,0,0,1,2.835-14.838A36.83,36.83,0,0,0,116.106,407.99Zm0,15.6v12.386a36.8,36.8,0,0,0-11.018,2.146A42.373,42.373,0,0,1,102,423.587Zm0,15.386v15.252a47.106,47.106,0,0,1-9.792-13.361A33.819,33.819,0,0,1,116.106,438.973Zm-2.86,16.708a33.755,33.755,0,0,1-18.084-8.24,33.786,33.786,0,0,1,8.306-5.426A48.955,48.955,0,0,0,113.246,455.681Zm5.86-1.313v-15.4a33.8,33.8,0,0,1,9.922,1.94A47.081,47.081,0,0,1,119.106,454.368Zm12.762-12.294a33.846,33.846,0,0,1,8.182,5.367,33.759,33.759,0,0,1-17.909,8.217A48.888,48.888,0,0,0,131.868,442.074Zm-12.762-6.1V423.587h14.257a42.352,42.352,0,0,1-3.106,14.582A36.818,36.818,0,0,0,119.106,435.973Zm0-15.386v-12.6a36.806,36.806,0,0,0,11.4-2.291,45.562,45.562,0,0,1,2.854,14.888ZM93.112,398.711a36.8,36.8,0,0,0,8.91,5.871A48.7,48.7,0,0,0,99,420.587H83.76A33.757,33.757,0,0,1,93.112,398.711ZM83.76,423.587H99a45.675,45.675,0,0,0,3.256,15.683A36.807,36.807,0,0,0,93,445.35,33.755,33.755,