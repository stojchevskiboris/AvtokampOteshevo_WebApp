@model Project_IT.Models.FeedItem

@{
    ViewBag.Title = Strings.FeedItems_Edit_Meta_Title;
}

<div class="max-w-3xl mx-auto px-6 py-10 font-sans">
    <div class="mb-6">
        <a href="@Url.Action("Index")" class="text-sm text-slate-400 hover:text-slate-700 transition">@Strings.FeedItems_BackToList</a>
        <h1 class="text-3xl font-serif text-slate-800 mt-2">@Strings.FeedItems_Edit_Title</h1>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-6">
    @Html.ValidationSummary(true, "", new { @class = "text-rose-600 text-sm" })

    <div>
        @* show id only for ui info and make it readonly disabled *@
        @Html.LabelFor(model => model.Id, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.Id, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm bg-slate-100", @readonly = "readonly", @disabled = "disabled" })
    </div>

    <div>
        @Html.LabelFor(model => model.Title, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.Title, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <div>
        @Html.LabelFor(model => model.TitleEn, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.TitleEn, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
        @Html.ValidationMessageFor(model => model.TitleEn, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <br />

    <div>
        @Html.LabelFor(model => model.Subtitle, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.Subtitle, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
        @Html.ValidationMessageFor(model => model.Subtitle, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <div>
        @Html.LabelFor(model => model.SubtitleEn, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.SubtitleEn, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
        @Html.ValidationMessageFor(model => model.SubtitleEn, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <br />

    <div>
        @Html.LabelFor(model => model.LabelBadge, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.LabelBadge, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
        @Html.ValidationMessageFor(model => model.LabelBadge, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <div>
        @Html.LabelFor(model => model.LabelBadgeEn, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.LabelBadgeEn, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
        @Html.ValidationMessageFor(model => model.LabelBadgeEn, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <br />

    <div>
        @Html.LabelFor(model => model.Category, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.EnumDropDownListFor(model => model.Category, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm bg-white" })
        @Html.ValidationMessageFor(model => model.Category, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <div>
        @Html.LabelFor(model => model.ImageUrl, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.ImageUrl, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
        @Html.ValidationMessageFor(model => model.ImageUrl, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <div>
        @Html.LabelFor(model => model.GalleryPath, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.GalleryPath, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
        @Html.ValidationMessageFor(model => model.GalleryPath, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <div>
        @Html.LabelFor(model => model.ActionUrl, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.ActionUrl, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
    </div>

    <br />

    <div class="grid md:grid-cols-2 gap-4">
        <div>
            <div class="mb-2">
                @Html.LabelFor(model => model.OfferText, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
                @Html.TextBoxFor(model => model.OfferText, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
            </div>

            <div>
                @Html.LabelFor(model => model.OfferTextEn, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
                @Html.TextBoxFor(model => model.OfferTextEn, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
                @Html.ValidationMessageFor(model => model.OfferTextEn, "", new { @class = "text-rose-600 text-xs mt-1" })
            </div>
        </div>
        <div>
            <div class="mb-2">
                @Html.LabelFor(model => model.ButtonText, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
                @Html.TextBoxFor(model => model.ButtonText, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
            </div>
            <div>
                @Html.LabelFor(model => model.ButtonTextEn, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
                @Html.TextBoxFor(model => model.ButtonTextEn, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
                @Html.ValidationMessageFor(model => model.ButtonTextEn, "", new { @class = "text-rose-600 text-xs mt-1" })
            </div>
        </div>
    </div>

    <br />

    <div>
        @Html.LabelFor(model => model.ValidTo, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.ValidTo, "{0:yyyy-MM-dd}", new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", type = "date" })
    </div>

    <div>
        @Html.LabelFor(model => model.CreatedOn, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.CreatedOn, "{0:yyyy-MM-dd}", new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", type = "date" })
    </div>

    <div>
        @Html.LabelFor(model => model.Description, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextAreaFor(model => model.Description, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm h-32" })
        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <div>
        @Html.LabelFor(model => model.DescriptionEn, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextAreaFor(model => model.DescriptionEn, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm h-32" })
        @Html.ValidationMessageFor(model => model.DescriptionEn, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <div class="flex items-center gap-6 pt-2">
        <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
            @Html.CheckBoxFor(model => model.IsFeatured, new { @class = "rounded text-emerald-700 focus:ring-emerald-600" })
            Истакнато
        </label>
        <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
            @Html.CheckBoxFor(model => model.IsPublished, new { @class = "rounded text-emerald-700 focus:ring-emerald-600" })
            Објавено
        </label>
    </div>

    <div class="flex items-center gap-4 pt-6 border-t border-slate-100">
        <button type="submit" class="px-6 py-2.5 rounded-full text-sm font-semibold text-white bg-brand-gradient shadow-md hover:opacity-90 transition">
            Зачувај измени
        </button>
        <a href="@Url.Action("Index")" class="px-6 py-2.5 rounded-full text-sm font-semibold text-slate-600 border border-slate-200 hover:bg-slate-50 transition">
            Откажи
        </a>
    </div>
</div>
    }
</div>
