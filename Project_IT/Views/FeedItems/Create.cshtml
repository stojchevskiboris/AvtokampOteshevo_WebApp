@model Project_IT.Models.FeedItem

@{
    ViewBag.Title = "Креирај нов запис — Новости & Понуди";
}

<div class="max-w-3xl mx-auto px-6 py-10 font-sans">
    <div class="mb-6">
        <a href="@Url.Action("Index")" class="text-sm text-slate-400 hover:text-slate-700 transition">&larr; Назад на листата</a>
        <h1 class="text-3xl font-serif text-slate-800 mt-2">Додај нов запис</h1>
    </div>

    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

<div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-6">
    @Html.ValidationSummary(true, "", new { @class = "text-rose-600 text-sm" })

    <div>
        @Html.LabelFor(model => model.Title, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.Title, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
        @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <div>
        @Html.LabelFor(model => model.Subtitle, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.Subtitle, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
        @Html.ValidationMessageFor(model => model.Subtitle, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <div class="grid md:grid-cols-2 gap-4">
        <div>
            @Html.LabelFor(model => model.Category, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
            @Html.EnumDropDownListFor(model => model.Category, new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm bg-white" })
            @Html.ValidationMessageFor(model => model.Category, "", new { @class = "text-rose-600 text-xs mt-1" })
        </div>

        <div>
            @Html.LabelFor(model => model.LabelBadge, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
            @Html.TextBoxFor(model => model.LabelBadge, new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", placeholder = "e.g. -30%, Настан, Ново" })
            @Html.ValidationMessageFor(model => model.LabelBadge, "", new { @class = "text-rose-600 text-xs mt-1" })
        </div>
    </div>

    <div>
        @Html.LabelFor(model => model.ImageUrl, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.ImageUrl, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", placeholder = "https://..." })
        @Html.ValidationMessageFor(model => model.ImageUrl, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <div class="grid md:grid-cols-3 gap-4">
        <div>
            @Html.LabelFor(model => model.OfferText, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
            @Html.TextBoxFor(model => model.OfferText, new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", placeholder = "e.g. 7+1 ГРАТИС" })
        </div>
        <div>
            @Html.LabelFor(model => model.ButtonText, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
            @Html.TextBoxFor(model => model.ButtonText, new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", placeholder = "Искористи ја понудата" })
        </div>
        <div>
            @Html.LabelFor(model => model.ActionUrl, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
            @Html.TextBoxFor(model => model.ActionUrl, new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm" })
        </div>
    </div>

    <div>
        @Html.LabelFor(model => model.ValidTo, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.ValidTo, "{0:yyyy-MM-dd}", new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", type = "date" })
    </div>

    <div>
        @Html.LabelFor(model => model.CreatedOn, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextBoxFor(model => model.CreatedOn, "{0:yyyy-MM-dd}", new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", type = "date" })
    </div>

    <div>
        @Html.LabelFor(model => model.Description, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
        @Html.TextAreaFor(model => model.Description, new { @class = "min-w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm h-32" })
        @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-rose-600 text-xs mt-1" })
    </div>

    <div class="flex items-center gap-6 pt-2">
        <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
            @Html.CheckBoxFor(model => model.IsFeatured, new { @class = "rounded text-emerald-700 focus:ring-emerald-600" })
            Истакнато
        </label>
        <label class="flex items-center gap-2 text-sm text-slate-700 cursor-pointer">
            @Html.CheckBoxFor(model => model.IsPublished, new { @class = "rounded text-emerald-700 focus:ring-emerald-600" })
            Објавено
        </label>
    </div>

    <div class="flex items-center gap-4 pt-6 border-t border-slate-100">
        <button type="submit" class="px-6 py-2.5 rounded-full text-sm font-semibold text-white bg-brand-gradient shadow-md hover:opacity-90 transition">
            Зачувај
        </button>
        <a href="@Url.Action("Index")" class="px-6 py-2.5 rounded-full text-sm font-semibold text-slate-600 border border-slate-200 hover:bg-slate-50 transition">
            Откажи
        </a>
    </div>
</div>
    }
</div>
