@model Project_IT.Models.FeedItem

@{
    ViewBag.Title = Strings.FeedItems_Details_Meta_Title;
}

<div class="max-w-3xl mx-auto px-6 py-10 font-sans">
    <div class="mb-6">
        <a href="@Url.Action("Index")" class="text-sm text-slate-400 hover:text-slate-700 transition">@Strings.FeedItems_BackToList</a>
        <h1 class="text-3xl font-serif text-slate-800 mt-2">@Strings.FeedItems_Details_Title</h1>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-4">
        <div>
            <span class="text-xs font-semibold uppercase text-slate-400">@Strings.FeedItems_ColTitle</span>
            <h2 class="text-xl font-serif text-slate-800">@Model.Title</h2>
        </div>

        @if (!string.IsNullOrEmpty(Model.TitleEn))
        {
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400">Title (EN)</span>
                <h3 class="text-lg font-serif text-slate-700">@Model.TitleEn</h3>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Subtitle))
        {
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400">@Strings.FeedItems_LabelSubtitle</span>
                <p class="text-sm text-slate-600">@Model.Subtitle</p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.SubtitleEn))
        {
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400">Subtitle (EN)</span>
                <p class="text-sm text-slate-600">@Model.SubtitleEn</p>
            </div>
        }

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 py-4 border-y border-slate-100">
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block">@Strings.FeedItems_ColCategory</span>
                <span class="text-sm text-slate-700">@Model.Category</span>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block">@Strings.FeedItems_ColBadge</span>
                <span class="text-sm text-slate-700">@(!string.IsNullOrEmpty(Model.LabelBadge) ? Model.LabelBadge : "-")</span>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block">@Strings.FeedItems_ColFeatured</span>
                <span class="text-sm text-slate-700">@(Model.IsFeatured ? Strings.Res_Yes : Strings.Res_No)</span>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block">@Strings.FeedItems_ColPublished</span>
                <span class="text-sm text-slate-700">@(Model.IsPublished ? Strings.Res_Yes : Strings.Res_No)</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block mb-2">@Strings.FeedItems_LabelImage</span>
                <img src="@Model.ImageUrl" alt="@Model.Title" class="max-h-64 rounded-xl object-cover" />
            </div>
        }

        <div>
            <span class="text-xs font-semibold uppercase text-slate-400 block mb-1">@Strings.FeedItems_LabelDescription</span>
            <div class="text-sm text-slate-600 leading-relaxed">
                @Html.Raw(Model.Description)
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.DescriptionEn))
        {
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block mb-1">Description (EN)</span>
                <div class="text-sm text-slate-600 leading-relaxed">
                    @Html.Raw(Model.DescriptionEn)
                </div>
            </div>
        }

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 py-4 border-y border-slate-100">
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block">Label Badge (EN)</span>
                <span class="text-sm text-slate-700">@(!string.IsNullOrEmpty(Model.LabelBadgeEn) ? Model.LabelBadgeEn : "-")</span>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block">Offer Text (EN)</span>
                <span class="text-sm text-slate-700">@(!string.IsNullOrEmpty(Model.OfferTextEn) ? Model.OfferTextEn : "-")</span>
            </div>
            <div>
                <span class="text-xs font-semibold uppercase text-slate-400 block">Button Text (EN)</span>
                <span class="text-sm text-slate-700">@(!string.IsNullOrEmpty(Model.ButtonTextEn) ? Model.ButtonTextEn : "-")</span>
            </div>
        </div>

        <div class="flex items-center gap-4 pt-6 border-t border-slate-100">
            <a href="@Url.Action("Edit", new { id = Model.Id })" class="px-6 py-2.5 rounded-full text-sm font-semibold text-white bg-brand-gradient shadow-md hover:opacity-90 transition">
                Измени
            </a>
            <a href="@Url.Action("Index")" class="px-6 py-2.5 rounded-full text-sm font-semibold text-slate-600 border border-slate-200 hover:bg-slate-50 transition">
                Назад
            </a>
        </div>
    </div>
</div>
