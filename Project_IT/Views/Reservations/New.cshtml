@model Project_IT.Models.Reservation

@{
    ViewBag.Title = Strings.Res_Meta_Title;
    ViewBag.Description = Strings.Res_Meta_Desc;
    var lang = CultureHelper.Current;
}

<div class="py-12 px-6 bg-cover bg-center bg-no-repeat relative"
     style="min-height: 80vh; background-image: url('@Url.Content("~/Content/reservationBackground.png")');">

    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-black/20 pointer-events-none"></div>

    <div class="max-w-3xl mx-auto relative z-10">
        <!-- Header -->
        <div class="text-center mb-10">
            <span class="inline-block text-xs font-semibold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4 font-body bg-black/40 text-emerald-300 backdrop-blur-md border border-white/10">
                @Strings.Res_Badge
            </span>
            <h1 class="text-3xl md:text-4xl text-white font-display font-bold drop-shadow-md">
                @Strings.Res_Title
            </h1>
            <p class="text-slate-100 mt-3 text-sm md:text-base font-body font-normal drop-shadow">
                @Strings.Res_Sub
            </p>
        </div>

        @{
            var prices = ViewBag.Prices as Project_IT.Models.BookingPricesViewModel;
        }

        @if (prices != null)
        {
            <div id="pricesCard" class="mb-6 bg-white/95 backdrop-blur-md rounded-2xl p-4 sm:p-6 border border-slate-100 shadow-xl font-body">
                <div class="flex items-center justify-center mb-4">
                    <span class="text-[11px] text-slate-400">@Strings.Res_Prices_Title</span>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    @if (prices.PriceBoxVisible1)
                    {
                        string label = (lang != "mk" && !string.IsNullOrEmpty(prices.LabelBungalow1.NameEn)) ? prices.LabelBungalow1.NameEn : prices.LabelBungalow1.Name;
                        int eur = (int)Math.Round(prices.PricePerNightBungalow1 / 61.5m);
                        <div class="group relative overflow-hidden rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-4 text-center transition-all duration-200 hover:border-emerald-300 hover:shadow-md hover:-translate-y-0.5">
                            <div class="mx-auto mb-2 flex h-9 w-9 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 group-hover:bg-emerald-100 transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;">
                                    <path d="M3 21h18M4 21V10l8-6 8 6v11M9 21v-6h6v6" />
                                </svg>
                            </div>
                            <span class="block text-[11px] text-slate-500 leading-tight mb-1">@label</span>
                            <span class="block text-base font-bold text-emerald-800">@prices.PricePerNightBungalow1.ToString("N0") <span class="text-[11px] font-medium text-slate-400">@Strings.Currency_MKD</span> <span class="text-xs text-slate-400 font-normal">(~@eur €)</span></span>
                        </div>
                    }
                    @if (prices.PriceBoxVisible2)
                    {
                        string label = (lang != "mk" && !string.IsNullOrEmpty(prices.LabelBungalow2.NameEn)) ? prices.LabelBungalow2.NameEn : prices.LabelBungalow2.Name;
                        int eur = (int)Math.Round(prices.PricePerNightBungalow2 / 61.5m);
