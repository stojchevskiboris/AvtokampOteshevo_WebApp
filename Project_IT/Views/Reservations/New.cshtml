                            <span class="block text-base font-bold text-emerald-800">@prices.PricePerNightTrailer.ToString("N0") <span class="text-[11px] font-medium text-slate-400">@Strings.Currency_MKD</span> <span class="text-xs text-slate-400 font-normal">(~@eur €)</span></span>
