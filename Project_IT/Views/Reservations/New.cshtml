                                    <path d="M12 3 3 21h18L12 3Zm0 6 5 12H7l5-12Z" />
                                </svg>
                            </div>
                            <span class="block text-[11px] text-slate-500 leading-tight mb-1">@label</span>
                            <span class="block text-base font-bold text-emerald-800">@prices.PitchFee.ToString("N0") <span class="text-[11px] font-medium text-slate-400">@Strings.Currency_MKD</span> <span class="text-xs text-slate-400 font-normal">(~@eur €)</span></span>
