@model Project_IT.Models.Reservation

@{
    ViewBag.Title = "Резервирај - Автокамп Отешево";
}

<div class="py-12 px-6 bg-cover bg-center bg-no-repeat relative"
     style="min-height: 80vh; background-image: url('@Url.Content("~/Content/reservationBackground.png")');">

    <!-- Dark overlay -->
    <div class="absolute inset-0 bg-black/20 pointer-events-none"></div>

    <div class="max-w-3xl mx-auto relative z-10">
        <!-- Header -->
        <div class="text-center mb-10">
            <span class="inline-block text-xs font-semibold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4 font-body bg-black/40 text-emerald-300 backdrop-blur-md border border-white/10">
                Резервација
            </span>
            <h1 class="text-3xl md:text-4xl text-white font-display font-bold drop-shadow-md">
                Испрати барање за резервација
            </h1>
            <p class="text-slate-100 mt-3 text-sm md:text-base font-body font-normal drop-shadow">
                Пополнете ги податоците подолу за да испратите барање за резервација во Автокамп Отешево.
            </p>
        </div>

        <!-- Reservation Form Card -->
        <div id="formCard" class="bg-white/95 backdrop-blur-md rounded-2xl p-6 md:p-10 border border-slate-100 shadow-2xl space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name -->
                <div class="flex flex-col gap-1.5">
                    <label for="fullName" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        * Име и презиме
                    </label>
                    <input type="text" id="fullName" required="required" placeholder="Пр. Петар Петровски"
                           class="min-w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors font-body" />
                </div>

                <!-- Email -->
                <div class="flex flex-col gap-1.5">
                    <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        * E-mail адреса
                    </label>
                    <input type="email" id="email" required="required" placeholder="vasiot@email.com"
                           class="min-w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors font-body" />
                    <span id="emailError" class="text-xs text-red-500 hidden font-body">Ве молиме внесете валидна е-маил адреса.</span>
                </div>

                <!-- Phone -->
                <div class="flex flex-col gap-1.5">
                    <label for="phone" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        * Телефон
                    </label>
                    <input type="tel" id="phone" required="required" placeholder="07X XXX XXX"
                           class="min-w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors font-body" />
                </div>

                <!-- Guests -->
                <div class="flex flex-col gap-1.5">
                    <label for="guests" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        * Број на лица
                    </label>
                    <input type="number" id="guests" min="1" max="10" required="required" placeholder="2"
                           class="min-w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors font-body" />
                </div>

                <!-- Accommodation -->
                <div class="flex flex-col gap-1.5 md:col-span-2">
                    <label for="accommodationType" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        * Сместување
                    </label>
                    <select id="accommodationType" required="required"
                            class="min-w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors font-body bg-white">
                        <option value="Bungalov" selected="selected">Бунгалов</option>
                        <option value="Prikolka">Приколка</option>
                        <option value="Plac za shator">Плац за шатор</option>
                    </select>
                </div>

                <!-- Check-in Date -->
                <div class="flex flex-col gap-1.5">
                    <label for="checkInDate" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        Дата на пристигнување
                    </label>
                    <input type="date" id="checkInDate"
                           class="min-w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors cursor-pointer font-body" />
                </div>

                <!-- Check-out Date -->
                <div class="flex flex-col gap-1.5">
                    <label for="checkOutDate" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        Дата на заминување
                    </label>
                    <input type="date" id="checkOutDate"
                           class="min-w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors cursor-pointer font-body" />
                </div>
            </div>

            <!-- Message -->
            <div class="flex flex-col gap-1.5">
                <label for="info" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                    Дополнителни барања
                </label>
                <textarea id="info" rows="3" placeholder="Напомени или дополнителни барања..."
                          class="min-w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors font-body resize-y"></textarea>
            </div>

            <!-- Global Error Banner -->
            <div id="globalError" class="hidden p-4 rounded-xl bg-red-50 border border-red-200 text-red-600 text-sm font-body text-center">
                Извинете, ве молиме обидете се повторно....
            </div>

            <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-100">
                <p class="text-xs text-slate-400 font-body">
                    Полињата означени со * се задолжителни.
                </p>
                <button type="button" id="submitBtn"
                        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-white font-semibold text-sm transition-all duration-200 hover:opacity-90 hover:shadow-xl active:scale-95 cursor-pointer bg-brand-gradient shadow-md font-body disabled:opacity-50 disabled:cursor-not-allowed"
                        style="box-shadow: 0 4px 14px rgba(26,61,43,0.35);">
                    Испрати барање ↗
                </button>
            </div>
        </div>

        <!-- Back Link -->
        <div class="mt-6 text-center">
            <a href='@Url.Action("Index", "Home")' class="inline-flex items-center gap-2 text-slate-900 bg-white/80 hover:bg-white px-4 py-2 rounded-full text-sm font-semibold transition font-body no-underline shadow-sm backdrop-blur-sm">
                ← Назад до Почетна
            </a>
        </div>
    </div>
</div>

<!-- Hidden EmailJS Form -->
<form id="form" class="hidden">
    <input type="text" name="customer_name" id="form_customer_name" />
    <input type="email" name="customer_email" id="form_customer_email" />
    <input type="text" name="phone" id="form_phone" />
    <input type="text" name="guests" id="form_guests" />
    <input type="text" name="smestuvanje" id="form_smestuvanje" />
    <input type="text" name="check_in" id="form_check_in" />
    <input type="text" name="check_out" id="form_check_out" />
    <textarea name="message" id="form_message"></textarea>

    <input type="text" name="user_os" id="form_user_os" />
    <input type="text" name="user_platform" id="form_user_platform" />
    <input type="text" name="user_browser" id="form_user_browser" />
    <input type="text" name="user_version" id="form_user_version" />
    <input type="text" name="user_referrer" id="form_user_referrer" />

    <textarea name="from_name" id="from_name"></textarea>
    <input type="text" name="reply_to" id="reply_to" />
</form>

<style>
    .danger {
        border-color: #ef4444 !important;
        background-color: #fef2f2 !important;
    }
</style>

<script src="~/Content/email.min.js"></script>

<script type="text/javascript">
    emailjs.init('0YVQaG2ITtZEM__Mt');
</script>

<script type="text/javascript">
    Date.prototype.addDays = function (days) {
        var date = new Date(this.valueOf());
        date.setDate(date.getDate() + days);
        return date;
    };

    function updateMinCheckOut(checkInVal) {
        if (!checkInVal) return;
        var parts = checkInVal.split('-');
        if (parts.length === 3) {
            var yyyy = parseInt(parts[0], 10);
            var mm = parseInt(parts[1], 10);
            var dd = parseInt(parts[2], 10);

            var minDate = new Date(yyyy, mm - 1, dd).addDays(1);
            var formattedDd = String(minDate.getDate()).padStart(2, '0');
            var formattedMm = String(minDate.getMonth() + 1).padStart(2, '0');
            var formattedYyyy = minDate.getFullYear();

            document.getElementById('checkOutDate').setAttribute('min', formattedYyyy + '-' + formattedMm + '-' + formattedDd);
        }
    }

    function getOS() {
        var userAgent = window.navigator.userAgent,
            platform = window.navigator.platform,
            macosPlatforms = ['Macintosh', 'MacIntel', 'MacPPC', 'Mac68K'],
            windowsPlatforms = ['Win32', 'Win64', 'Windows', 'WinCE'],
            iosPlatforms = ['iPhone', 'iPad', 'iPod'];

        if (macosPlatforms.indexOf(platform) !== -1) return 'Mac OS';
        if (iosPlatforms.indexOf(platform) !== -1) return 'iOS';
        if (windowsPlatforms.indexOf(platform) !== -1) return 'Windows';
        if (/Android/.test(userAgent)) return 'Android';
        if (/Linux/.test(platform)) return 'Linux';
        return platform || 'Unknown OS';
    }

    function getBrowserInfo() {
        var ua = navigator.userAgent, tem,
            M = ua.match(/(opera|chrome|safari|firefox|msie|trident(?=\/))\/?\s*(\d+)/i) || [];
        if (/trident/i.test(M[1])) {
            tem = /\brv[ :]+(\d+)/g.exec(ua) || [];
            return 'IE ' + (tem[1] || '');
        }
        if (M[1] === 'Chrome') {
            tem = ua.match(/\b(OPR|Edge)\/(\d+)/);
            if (tem != null) return tem.slice(1).join(' ').replace('OPR', 'Opera');
        }
        M = M[2] ? [M[1], M[2]] : [navigator.appName, navigator.appVersion, '-?'];
        if ((tem = ua.match(/version\/(\d+)/i)) != null) M.splice(1, 1, tem[1]);
        return M.join(' ');
    }

    document.addEventListener('DOMContentLoaded', function () {
        const checkInDateElem = document.getElementById('checkInDate');
        const checkOutDateElem = document.getElementById('checkOutDate');
        const fullNameElem = document.getElementById('fullName');
        const emailElem = document.getElementById('email');
        const phoneElem = document.getElementById('phone');
        const guestsElem = document.getElementById('guests');
        const accommodationTypeElem = document.getElementById('accommodationType');
        const infoElem = document.getElementById('info');
        const emailErrorElem = document.getElementById('emailError');
        const globalErrorElem = document.getElementById('globalError');
        const submitBtnElem = document.getElementById('submitBtn');

        function resetSubmitState() {
            if (submitBtnElem) {
                submitBtnElem.disabled = false;
                submitBtnElem.innerHTML = 'Испрати барање ↗';
            }
        }

        function showUIError() {
            resetSubmitState();
            if (globalErrorElem) {
                globalErrorElem.classList.remove('hidden');
            }
        }

        var today = new Date();
        var dd = String(today.getDate()).padStart(2, '0');
        var mm = String(today.getMonth() + 1).padStart(2, '0');
        var yyyy = today.getFullYear();
        var todayStr = yyyy + '-' + mm + '-' + dd;

        checkInDateElem.setAttribute('min', todayStr);
        checkOutDateElem.setAttribute('min', todayStr);

        // Prepopulate parameters
        var urlParams = new URLSearchParams(window.location.search);
        var paramCheckIn = urlParams.get('checkIn');
        var paramCheckOut = urlParams.get('checkOut');
        var paramGuests = urlParams.get('guests');

        if (paramGuests) guestsElem.value = paramGuests;
        if (paramCheckIn) {
            checkInDateElem.value = paramCheckIn;
            updateMinCheckOut(paramCheckIn);
        }
        if (paramCheckOut) checkOutDateElem.value = paramCheckOut;

        checkInDateElem.addEventListener('change', function () {
            var dtP = checkInDateElem.value;
            if (dtP) {
                updateMinCheckOut(dtP);
                var currentOut = checkOutDateElem.value;
                if (currentOut && currentOut <= dtP) {
                    checkOutDateElem.value = "";
                }
            }
        });

        emailElem.addEventListener('input', function () {
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            if (emailElem.value.trim() !== "" && emailRegex.test(emailElem.value.trim())) {
                emailElem.classList.remove("danger");
                emailErrorElem.classList.add("hidden");
            }
        });

        submitBtnElem.addEventListener('click', function () {
            if (globalErrorElem) globalErrorElem.classList.add('hidden');

            let isValid = true;

            if (fullNameElem.value.trim() == "") {
                fullNameElem.classList.add("danger");
                isValid = false;
            } else {
                fullNameElem.classList.remove("danger");
            }

            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
            const emailVal = emailElem.value.trim();
            if (emailVal == "" || !emailRegex.test(emailVal)) {
                emailElem.classList.add("danger");
                emailErrorElem.classList.remove("hidden");
                isValid = false;
            } else {
                emailElem.classList.remove("danger");
                emailErrorElem.classList.add("hidden");
            }

            if (phoneElem.value.trim() == "") {
                phoneElem.classList.add("danger");
                isValid = false;
            } else {
                phoneElem.classList.remove("danger");
            }

            if (guestsElem.value.trim() == "") {
                guestsElem.classList.add("danger");
                isValid = false;
            } else {
                guestsElem.classList.remove("danger");
            }

            if (!isValid) return;

            // Lock submit button
            submitBtnElem.disabled = true;
            submitBtnElem.innerHTML = `
                <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Испраќање...
            `;

            var formattedCheckIn = checkInDateElem.value ? checkInDateElem.value.substr(8, 2) + "." + checkInDateElem.value.substr(5, 2) + "." + checkInDateElem.value.substr(0, 4) : 'Null';
            var formattedCheckOut = checkOutDateElem.value ? checkOutDateElem.value.substr(8, 2) + "." + checkOutDateElem.value.substr(5, 2) + "." + checkOutDateElem.value.substr(0, 4) : 'Null';

            const osVal = getOS();
            const browserVal = getBrowserInfo();
            const platformVal = navigator.platform || "";
            const versionVal = navigator.appVersion || "";
            const referrerVal = document.referrer || "";
            const localeVal = navigator.language || "";
            const userAgentVal = navigator.userAgent || "";

            // Populate hidden form for EmailJS
            document.getElementById("form_customer_name").value = fullNameElem.value;
            document.getElementById("form_customer_email").value = emailVal;
            document.getElementById("form_phone").value = phoneElem.value;
            document.getElementById("form_guests").value = guestsElem.value;
            document.getElementById("form_smestuvanje").value = accommodationTypeElem.value;
            document.getElementById("form_check_in").value = formattedCheckIn;
            document.getElementById("form_check_out").value = formattedCheckOut;
            document.getElementById("form_message").value = infoElem.value;
            document.getElementById("form_user_os").value = osVal;
            document.getElementById("form_user_platform").value = platformVal;
            document.getElementById("form_user_browser").value = browserVal;
            document.getElementById("form_user_version").value = versionVal;
            document.getElementById("form_user_referrer").value = referrerVal;

            document.getElementById("from_name").value = " Име и презиме: " + fullNameElem.value +
                "\n Email: " + emailVal +
                "\n Телефон: " + phoneElem.value +
                "\n Број на лица: " + guestsElem.value +
                "\n Сместување: " + accommodationTypeElem.value +
                "\n Дата на пристигнување: " + formattedCheckIn +
                "\n Дата на заминување: " + formattedCheckOut;
            document.getElementById("reply_to").value = emailVal;

            const serviceID = 'default_service';
            const templateID = 'template_bjhyjh8';
            const formElem = document.getElementById('form');

            // Step 1: Send via EmailJS
            emailjs.sendForm(serviceID, templateID, formElem)
                .then(function () {
                    // Step 2: Save to backend database
                    const modelPayload = {
                        FullName: fullNameElem.value,
                        Email: emailVal,
                        Phone: phoneElem.value,
                        Guests: guestsElem.value,
                        AccommodationType: accommodationTypeElem.value,
                        CheckInDate: formattedCheckIn,
                        CheckOutDate: formattedCheckOut,
                        Info: infoElem.value,
                        UserOs: osVal,
                        UserPlatform: platformVal,
                        UserBrowser: browserVal,
                        UserVersion: versionVal,
                        UserAgent: userAgentVal,
                        UserCountry: localeVal,
                        UserReferrer: referrerVal
                    };

                    return fetch('@Url.Action("Save", "Reservations")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(modelPayload)
                    });
                })
                .then(function (response) {
                    if (response && !response.ok) {
                        throw new Error('Database save failed');
                    }
                    // Step 3: Success UI
                    const formCardElem = document.getElementById('formCard');
                    formCardElem.innerHTML = `
                        <div class="text-center py-12 px-4 space-y-4">
                            <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold shadow-sm">
                                ✓
                            </div>
                            <h2 class="text-2xl md:text-3xl font-bold text-slate-800 font-display">
                                Ви благодариме!
                            </h2>
                            <p class="text-slate-600 font-body text-base max-w-md mx-auto leading-relaxed">
                                Вашето барање за резервација е успешно испратено. Ќе ве контактираме во најкраток можен рок.
                            </p>
                        </div>
                    `;
                })
                .catch(function (err) {
                    console.error("Submission failed:", err);
                    showUIError();
                });
        });
    });
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
