@model Project_IT.Models.Reservation

@{
    ViewBag.Title = "Резервирај - Автокамп Отешево";
}

<div class="py-12 px-6 bg-cover bg-center bg-no-repeat relative"
     style="min-height: 80vh; background-image: url('@Url.Content("~/Content/reservationBackground.png")');">

    <!-- Optional: Dark overlay to improve readability of white/dark text on top of the image -->
    <div class="absolute inset-0 bg-black/20 pointer-events-none"></div>

    <div class="max-w-3xl mx-auto relative z-10">
        <!-- Header -->
        <div class="text-center mb-10">
            <span class="inline-block text-xs font-semibold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4 font-body bg-black/40 text-emerald-300 backdrop-blur-md border border-white/10">
                Резервација
            </span>
            <h1 class="text-3xl md:text-4xl text-white font-display font-bold drop-shadow-md">
                Испрати барање за резервација
            </h1>
            <p class="text-slate-100 mt-3 text-sm md:text-base font-body font-normal drop-shadow">
                Пополнете ги податоците подолу за да испратите барање за резервација во Автокамп Отешево.
            </p>
        </div>

        <!-- Reservation Form Card -->
        <div id="f1" class="bg-white/95 backdrop-blur-md rounded-2xl p-6 md:p-10 border border-slate-100 shadow-2xl space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <!-- Name -->
                <div class="flex flex-col gap-1.5">
                    <label for="ime" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        * Име и презиме
                    </label>
                    <input type="text" id="ime" required="required" placeholder="Пр. Петар Петровски"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors font-body" />
                </div>

                <!-- Email -->
                <div class="flex flex-col gap-1.5">
                    <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        * E-mail адреса
                    </label>
                    <input type="email" id="email" required="required" placeholder="vasiot@email.com"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors font-body" />
                </div>

                <!-- Phone -->
                <div class="flex flex-col gap-1.5">
                    <label for="telefon" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        * Телефон
                    </label>
                    <input type="tel" id="telefon" required="required" placeholder="07X XXX XXX"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors font-body" />
                </div>

                <!-- Guests -->
                <div class="flex flex-col gap-1.5">
                    <label for="lica" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        * Број на лица
                    </label>
                    <input type="number" id="lica" min="1" max="10" required="required" placeholder="2"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors font-body" />
                </div>

                <!-- Check-in Date -->
                <div class="flex flex-col gap-1.5">
                    <label for="dataP" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        Дата на пристигнување
                    </label>
                    <input type="date" id="dataP"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors cursor-pointer font-body" />
                </div>

                <!-- Check-out Date -->
                <div class="flex flex-col gap-1.5">
                    <label for="dataZ" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                        Дата на заминување
                    </label>
                    <input type="date" id="dataZ"
                           class="w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors cursor-pointer font-body" />
                </div>
            </div>

            <!-- Message -->
            <div class="flex flex-col gap-1.5">
                <label for="poraka" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 font-body">
                    Дополнителни барања
                </label>
                <textarea id="poraka" rows="3" placeholder="Напомени или дополнителни барања..."
                          class="max-w-full px-4 py-3 rounded-xl border border-slate-200 text-slate-800 text-sm font-medium outline-none focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 transition-colors font-body resize-y"></textarea>
            </div>

            <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4 border-t border-slate-100">
                <p class="text-xs text-slate-400 font-body">
                    Полињата означени со * се задолжителни.
                </p>
                <button type="button" id="isprati"
                        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-xl text-white font-semibold text-sm transition-all duration-200 hover:opacity-90 hover:shadow-xl active:scale-95 cursor-pointer bg-brand-gradient shadow-md font-body"
                        style="box-shadow: 0 4px 14px rgba(26,61,43,0.35);">
                    Испрати барање ↗
                </button>
            </div>
        </div>

        <!-- Back Link -->
        <div class="mt-6 text-center">
            <a href='@Url.Action("Index", "Home")' class="inline-flex items-center gap-2 text-slate-900 bg-white/80 hover:bg-white px-4 py-2 rounded-full text-sm font-semibold transition font-body no-underline shadow-sm backdrop-blur-sm">
                ← Назад до Почетна
            </a>
        </div>
    </div>
</div>

<!-- Hidden EmailJS Form -->
<form id="form" class="hidden">
    <textarea name="from_name" id="from_name"></textarea>
    <input type="text" name="reply_to" id="reply_to" />
    <textarea name="message" id="message"></textarea>
    <input type="submit" id="button" value="Send Email" />
</form>

<style>
    .danger {
        border-color: #ef4444 !important;
        background-color: #fef2f2 !important;
    }
</style>

<script src="~/Content/email.min.js"></script>

<script type="text/javascript">
    emailjs.init('0YVQaG2ITtZEM__Mt');
</script>

<script type="text/javascript">
    Date.prototype.addDays = function (days) {
        var date = new Date(this.valueOf());
        date.setDate(date.getDate() + days);
        return date;
    };

    function updateMinCheckOut(checkInVal) {
        if (!checkInVal) return;
        var parts = checkInVal.split('-');
        if (parts.length === 3) {
            var yyyy = parseInt(parts[0], 10);
            var mm = parseInt(parts[1], 10);
            var dd = parseInt(parts[2], 10);

            var minZdate = new Date(yyyy, mm - 1, dd).addDays(1);
            var Tdd = String(minZdate.getDate()).padStart(2, '0');
            var Tmm = String(minZdate.getMonth() + 1).padStart(2, '0');
            var Tyyyy = minZdate.getFullYear();

            document.getElementById('dataZ').setAttribute('min', Tyyyy + '-' + Tmm + '-' + Tdd);
        }
    }

    document.addEventListener('DOMContentLoaded', function () {
        const btn = document.getElementById('button');
        const dataP = document.getElementById('dataP');
        const dataZ = document.getElementById('dataZ');
        const ime = document.getElementById('ime');
        const email = document.getElementById('email');
        const telefon = document.getElementById('telefon');
        const lica = document.getElementById('lica');
        const poraka = document.getElementById('poraka');

        document.getElementById('form').addEventListener('submit', function (event) {
            event.preventDefault();

            btn.value = 'Sending...';

            const serviceID = 'default_service';
            const templateID = 'template_ufh4xh4';

            emailjs.sendForm(serviceID, templateID, this)
                .then(() => {
                    btn.value = 'Send Email';

                    // Clear values
                    ime.value = "";
                    email.value = "";
                    telefon.value = "";
                    lica.value = "";
                    dataP.value = "";
                    dataZ.value = "";
                    poraka.value = "";

                    // Replace form card with thank you state
                    const formCard = document.getElementById('f1');
                    formCard.innerHTML = `
                        <div class="text-center py-12 px-4 space-y-4">
                            <div class="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl font-bold shadow-sm">
                                ✓
                            </div>
                            <h2 class="text-2xl md:text-3xl font-bold text-slate-800 font-display">
                                Ви благодариме!
                            </h2>
                            <p class="text-slate-600 font-body text-base max-w-md mx-auto leading-relaxed">
                                Вашето барање за резервација е успешно испратено. Ќе ве контактираме во најкраток можен рок.
                            </p>
                        </div>
                    `;
                }, (err) => {
                    btn.value = 'Send Email';
                    alert(JSON.stringify(err));
                });
        });

        var today = new Date();
        var dd = String(today.getDate()).padStart(2, '0');
        var mm = String(today.getMonth() + 1).padStart(2, '0');
        var yyyy = today.getFullYear();
        var todayStr = yyyy + '-' + mm + '-' + dd;

        dataP.setAttribute('min', todayStr);
        dataZ.setAttribute('min', todayStr);

        // Prepopulate from URL parameters
        var urlParams = new URLSearchParams(window.location.search);
        var paramCheckIn = urlParams.get('checkIn');
        var paramCheckOut = urlParams.get('checkOut');
        var paramGuests = urlParams.get('guests');

        if (paramGuests) {
            lica.value = paramGuests;
        }

        if (paramCheckIn) {
            dataP.value = paramCheckIn;
            updateMinCheckOut(paramCheckIn);
        }

        if (paramCheckOut) {
            dataZ.value = paramCheckOut;
        }

        dataP.addEventListener('change', function () {
            var dtP = dataP.value;
            if (dtP) {
                updateMinCheckOut(dtP);
                var currentOut = dataZ.value;
                if (currentOut && currentOut <= dtP) {
                    dataZ.value = "";
                }
            }
        });

        document.getElementById('isprati').addEventListener('click', function () {
            var e1 = dataP.value;
            var e2 = dataZ.value;
            if (e1 == "") e1 = 'Null';
            else {
                var tmp = e1.substr(8, 2) + "." + e1.substr(5, 2) + "." + e1.substr(0, 4);
                e1 = tmp;
            }
            if (e2 == "") e2 = 'Null';
            else {
                var tmp = e2.substr(8, 2) + "." + e2.substr(5, 2) + "." + e2.substr(0, 4);
                e2 = tmp;
            }

            if (ime.value == "") {
                ime.classList.add("danger");
            } else {
                ime.classList.remove("danger");
            }

            if (email.value == "") {
                email.classList.add("danger");
            } else {
                email.classList.remove("danger");
            }

            if (telefon.value == "") {
                telefon.classList.add("danger");
            } else {
                telefon.classList.remove("danger");
            }

            if (lica.value == "") {
                lica.classList.add("danger");
            } else {
                lica.classList.remove("danger");
            }

            if (ime.value == "" || email.value == "" || telefon.value == "" || lica.value == "") {
                return;
            }

            document.getElementById("from_name").value = " Име и презиме: " + ime.value +
                "\n Email: " + email.value +
                "\n Телефон: " + telefon.value +
                "\n Број на лица: " + lica.value +
                "\n Дата на пристигнување: " + e1 +
                "\n Дата на заминување: " + e2;

            document.getElementById("message").value = poraka.value;

            btn.click();
        });
    });
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}