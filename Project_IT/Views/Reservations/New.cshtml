                                    <path d="M3 21h18M4 21V10l8-6 8 6v11M9 21v-6h6v6" />
                                </svg>
                            </div>
                            <span class="block text-[11px] text-slate-500 leading-tight mb-1">@label</span>
                            <span class="block text-base font-bold text-emerald-800">@prices.PricePerNightBungalow2.ToString("N0") <span class="text-[11px] font-medium text-slate-400">@Strings.Currency_MKD</span> <span class="text-xs text-slate-400 font-normal">(~@eur €)</span></span>
                        </div>
                    }
                    @if (prices.PriceBoxVisible3)
                    {
                        string label = (lang != "mk" && !string.IsNullOrEmpty(prices.LabelBungalow3.NameEn)) ? prices.LabelBungalow3.NameEn : prices.LabelBungalow3.Name;
                        int eur = (int)Math.Round(prices.PricePerNightBungalow3 / 61.5m);
                        <div class="group relative overflow-hidden rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-4 text-center transition-all duration-200 hover:border-emerald-300 hover:shadow-md hover:-translate-y-0.5">
                            <div class="mx-auto mb-2 flex h-9 w-9 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 group-hover:bg-emerald-100 transition-colors">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width:18px;height:18px;">
                                    <path d="M3 21h18M4 21V10l8-6 8 6v11M9 21v-6h6v6" />
                                </svg>
                            </div>
                            <span class="block text-[11px] text-slate-500 leading-tight mb-1">@label</span>
                            <span class="block text-base font-bold text-emerald-800">@prices.PricePerNightBungalow3.ToString("N0") <span class="text-[11px] font-medium text-slate-400">@Strings.Currency_MKD</span> <span class="text-xs text-slate-400 font-normal">(~@eur €)</span></span>
                        </div>
                    }
                    @if (prices.PriceBoxVisible4)
                    {
                        string label = (lang != "mk" && !string.IsNullOrEmpty(prices.LabelTrailer.NameEn)) ? prices.LabelTrailer.NameEn : prices.LabelTrailer.Name;
                        int eur = (int)Math.Round(prices.PricePerNightTrailer / 61.5m);
                        <div class="group relative overflow-hidden rounded-xl border border-slate-200 bg-gradient-to-br from-slate-50 to-white p-4 text-center transition-all duration-200 hover:border-emerald-300 hover:shadow-md hover:-translate-y-0.5">
                            <div class="mx-auto mb-2 flex h-9 w-9 items-center justify-center rounded-full bg-emerald-50 text-emerald-700 group-hover:bg-emerald-100 transition-colors">
