@model Project_IT.Models.Reservation

@{
    ViewBag.Title = "Резервација";
}

<div class="max-w-4xl mx-auto py-12 px-4">
    <div class="text-center mb-12">
        <h2 class="text-4xl font-extrabold text-forest-800 mb-4">Испрати барање за резервација</h2>
        <p class="text-gray-600">Пополнете ги податоците и ќе ве контактираме во најбрз можен рок.</p>
    </div>

    <div class="bg-white rounded-3xl shadow-2xl overflow-hidden border border-gray-100">
        <div class="p-8 md:p-12">
            <div id="f1" class="space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Name -->
                    <div class="relative group">
                        <label class="block text-sm font-bold text-forest-700 mb-2 transition-all group-focus-within:text-accent">*Име и презиме</label>
                        <input id="ime" required="required" placeholder="Вашето име"
                               class="w-full bg-gray-50 border-2 border-gray-100 rounded-xl py-4 px-5 focus:bg-white focus:border-accent focus:ring-0 transition-all outline-none" />
                    </div>

                    <!-- Email -->
                    <div class="relative group">
                        <label class="block text-sm font-bold text-forest-700 mb-2 transition-all group-focus-within:text-accent">*E-mail адреса</label>
                        <input id="email" type="email" required="required" placeholder="email@example.com"
                               class="w-full bg-gray-50 border-2 border-gray-100 rounded-xl py-4 px-5 focus:bg-white focus:border-accent focus:ring-0 transition-all outline-none" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Phone -->
                    <div class="relative group">
                        <label class="block text-sm font-bold text-forest-700 mb-2 transition-all group-focus-within:text-accent">*Телефон</label>
                        <input id="telefon" required="required" placeholder="07X XXX XXX"
                               class="w-full bg-gray-50 border-2 border-gray-100 rounded-xl py-4 px-5 focus:bg-white focus:border-accent focus:ring-0 transition-all outline-none" />
                    </div>

                    <!-- Persons -->
                    <div class="relative group">
                        <label class="block text-sm font-bold text-forest-700 mb-2 transition-all group-focus-within:text-accent">*Број на лица</label>
                        <input id="lica" type="number" min="1" max="10" required="required" value="1"
                               class="w-full bg-gray-50 border-2 border-gray-100 rounded-xl py-4 px-5 focus:bg-white focus:border-accent focus:ring-0 transition-all outline-none" />
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Arrival Date -->
                    <div class="relative group">
                        <label class="block text-sm font-bold text-forest-700 mb-2 transition-all group-focus-within:text-accent">Дата на пристигнување</label>
                        <input id="dataP" type="date"
                               class="w-full bg-gray-50 border-2 border-gray-100 rounded-xl py-4 px-5 focus:bg-white focus:border-accent focus:ring-0 transition-all outline-none" />
                    </div>

                    <!-- Departure Date -->
                    <div class="relative group">
                        <label class="block text-sm font-bold text-forest-700 mb-2 transition-all group-focus-within:text-accent">Дата на заминување</label>
                        <input id="dataZ" type="date"
                               class="w-full bg-gray-50 border-2 border-gray-100 rounded-xl py-4 px-5 focus:bg-white focus:border-accent focus:ring-0 transition-all outline-none" />
                    </div>
                </div>

                <!-- Message -->
                <div class="relative group">
                    <label class="block text-sm font-bold text-forest-700 mb-2 transition-all group-focus-within:text-accent">Дополнителни барања</label>
                    <textarea id="poraka" placeholder="Овде напишете ги вашите желби или прашања..."
                              class="w-full bg-gray-50 border-2 border-gray-100 rounded-xl py-4 px-5 focus:bg-white focus:border-accent focus:ring-0 transition-all outline-none min-h-[120px]"></textarea>
                </div>

                <p class="text-xs text-gray-400 font-medium italic">Полињата означени со * се задолжителни</p>

                <button id="isprati" class="w-full btn-primary text-xl py-5 mt-4">
                    Испрати барање
                </button>
            </div>
        </div>
    </div>

    <!-- Hidden Form for EmailJS -->
    <form id="form" class="hidden">
        <textarea name="from_name" id="from_name"></textarea>
        <input type="text" name="reply_to" id="reply_to">
        <textarea name="message" id="message"></textarea>
        <input type="submit" id="button">
    </form>

    <div class="mt-12 text-center">
        @Html.ActionLink("← Назад до Почетна", "Index", "Home", null, new { @class = "text-forest-700 hover:text-accent font-bold transition-colors" })
    </div>
</div>

@section Scripts {
    <script src="~/Content/email.min.js"></script>
    <script type="text/javascript">
        emailjs.init('0YVQaG2ITtZEM__Mt')
    </script>

    <script>
        const btn = document.getElementById('button');

        document.getElementById('form')
            .addEventListener('submit', function (event) {
                event.preventDefault();

                const originalBtn = document.getElementById('isprati');
                const originalText = originalBtn.innerText;
                originalBtn.innerText = 'Се испраќа...';
                originalBtn.disabled = true;

                const serviceID = 'default_service';
                const templateID = 'template_ufh4xh4';

                emailjs.sendForm(serviceID, templateID, this)
                    .then(() => {
                        originalBtn.innerText = originalText;
                        originalBtn.disabled = false;
                        alert('Барањето е испратено!');
                        // Reset form
                        document.getElementById("ime").value = "";
                        document.getElementById("email").value = "";
                        document.getElementById("telefon").value = "";
                        document.getElementById("lica").value = "1";
                        document.getElementById("dataP").value = "";
                        document.getElementById("dataZ").value = "";
                        document.getElementById("poraka").value = "";
                    }, (err) => {
                        originalBtn.innerText = originalText;
                        originalBtn.disabled = false;
                        alert('Грешка при испраќање: ' + JSON.stringify(err));
                    });
            });

        // Date constraints logic
        Date.prototype.addDays = function (days) {
            var date = new Date(this.valueOf());
            date.setDate(date.getDate() + days);
            return date;
        }

        var today = new Date();
        today = today.addDays(2);
        var dd = String(today.getDate()).padStart(2, '0');
        var mm = String(today.getMonth() + 1).padStart(2, '0');
        var yyyy = today.getFullYear();
        var minDate = yyyy + '-' + mm + '-' + dd;

        document.getElementById('dataP').setAttribute('min', minDate);
        document.getElementById('dataZ').setAttribute('min', minDate);

        document.getElementById('isprati').addEventListener('click', function() {
            var ime = document.getElementById("ime");
            var email = document.getElementById("email");
            var telefon = document.getElementById("telefon");
            var lica = document.getElementById("lica");
            var dataP = document.getElementById("dataP").value;
            var dataZ = document.getElementById("dataZ").value;
            var poraka = document.getElementById("poraka").value;

            // Simple validation highlighting
            [ime, email, telefon, lica].forEach(el => {
                if (!el.value) {
                    el.classList.add('border-red-300', 'bg-red-50');
                } else {
                    el.classList.remove('border-red-300', 'bg-red-50');
                }
            });

            if (!ime.value || !email.value || !telefon.value || !lica.value) return;

            // Format dates for email
            var d1 = dataP ? dataP.split('-').reverse().join('.') : 'Не е избрано';
            var d2 = dataZ ? dataZ.split('-').reverse().join('.') : 'Не е избрано';

            document.getElementById("from_name").value = "Име и презиме: " + ime.value +
                "\nEmail: " + email.value +
                "\nТелефон: " + telefon.value +
                "\nДата на пристигнување: " + d1 +
                "\nДата на заминување: " + d2;

            document.getElementById("message").value = poraka;
            document.getElementById("reply_to").value = email.value;

            btn.click();
        });

        document.getElementById('dataP').addEventListener('change', function() {
            var dtP = this.value;
            if(!dtP) return;
            
            var parts = dtP.split('-');
            var minZdate = new Date(parts[0], parts[1]-1, parts[2]);
            minZdate = minZdate.addDays(2);

            var Tdd = String(minZdate.getDate()).padStart(2, '0');
            var Tmm = String(minZdate.getMonth() + 1).padStart(2, '0');
            var Tyyyy = minZdate.getFullYear();
            var minZStr = Tyyyy + '-' + Tmm + '-' + Tdd;

            document.getElementById('dataZ').setAttribute('min', minZStr);
            if(document.getElementById('dataZ').value < minZStr) {
                document.getElementById('dataZ').value = "";
            }
        });
    </script>
}
