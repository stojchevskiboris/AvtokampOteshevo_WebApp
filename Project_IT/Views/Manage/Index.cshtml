@model Project_IT.Models.IndexViewModel
@{
    ViewBag.Title = "Поставки на сметката";
}

<div class="max-w-2xl mx-auto px-6 py-12 font-sans">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-6">
        <div>
            <h1 class="text-3xl font-serif text-slate-800">@ViewBag.Title</h1>
            <p class="text-slate-500 text-sm mt-1">Управувајте со сите подесувања на вашата корисничка сметка</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.StatusMessage))
        {
            <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-100 text-emerald-800 text-sm font-semibold">
                @ViewBag.StatusMessage
            </div>
        }

        <div class="divide-y divide-slate-100">
            <div class="py-4 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-semibold text-slate-800">Лозинка</h3>
                    <p class="text-xs text-slate-400">Променете ја вашата лозинка за најава</p>
                </div>
                <div>
                    @if (Model.HasPassword)
                    {
                        <a href="@Url.Action("ChangePassword")" class="px-4 py-2 rounded-full border border-slate-200 text-slate-700 hover:bg-slate-50 text-xs font-semibold no-underline transition">
                            Промени лозинка
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("SetPassword")" class="px-4 py-2 rounded-full bg-brand-gradient text-white text-xs font-semibold no-underline transition shadow-sm">
                            Креирај лозинка
                        </a>
                    }
                </div>
            </div>

            <div class="py-4 flex items-center justify-between">
                <div>
                    <h3 class="text-sm font-semibold text-slate-800">Надворешни најави</h3>
                    <p class="text-xs text-slate-400">Поврзани сметки: @Model.Logins.Count</p>
                </div>
                <div>
                    <a href="@Url.Action("ManageLogins")" class="px-4 py-2 rounded-full border border-slate-200 text-slate-700 hover:bg-slate-50 text-xs font-semibold no-underline transition">
                        Уреди
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
