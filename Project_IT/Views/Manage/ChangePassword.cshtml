@model Project_IT.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Промени лозинка";
}

<div class="max-w-md mx-auto px-6 py-12 font-sans">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 space-y-6">
        <div>
            <a href="@Url.Action("Index")" class="text-xs text-slate-400 hover:text-slate-700 transition">&larr; Назад на поставки</a>
            <h1 class="text-2xl font-serif text-slate-800 mt-2">Промени лозинка</h1>
        </div>

        @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { @class = "space-y-5" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-rose-600 text-xs font-semibold" })

            <div>
                @Html.LabelFor(m => m.OldPassword, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
                @Html.PasswordFor(m => m.OldPassword, new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", placeholder = "••••••••" })
            </div>

            <div>
                @Html.LabelFor(m => m.NewPassword, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
                @Html.PasswordFor(m => m.NewPassword, new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", placeholder = "••••••••" })
            </div>

            <div>
                @Html.LabelFor(m => m.ConfirmPassword, new { @class = "block text-xs font-semibold uppercase tracking-wider text-slate-700 mb-2" })
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:border-emerald-600 text-sm", placeholder = "••••••••" })
            </div>

            <button type="submit" class="w-full py-3 rounded-full text-sm font-semibold text-white bg-brand-gradient shadow-md hover:opacity-90 transition">
                Зачувај промени
            </button>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
