@{
    ViewBag.Title = "Контакт - Автокамп Отешево";
}

<div class="py-12 md:py-16 px-6 max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block text-xs font-semibold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4 font-body"
              style="background: rgba(26,61,43,0.08); color: #1a3d2b;">
            Контакт Информации
        </span>
        <h1 class="text-4xl md:text-5xl text-slate-800 mb-6 leading-tight font-display font-bold">
            Контактирајте нè и <em class="italic font-normal">посетете нè</em>
        </h1>
        <p class="text-slate-600 text-lg leading-relaxed font-body">
            Тука сме да одговориме на сите ваши прашања, информации за слободни места и резервации.
        </p>
    </div>

    <!-- Main Grid: Info Cards Left & Google Map Right -->
    <div class="grid lg:grid-cols-12 gap-8 items-start mb-16">
        <!-- Contact Details Column (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
            <!-- Address Card -->
            <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-800 flex items-center justify-center text-xl shrink-0">
                        📍
                    </div>
                    <div>
                        <h3 class="text-base font-semibold text-slate-800 font-body mb-1">Адреса</h3>
                        <p class="text-slate-600 text-sm leading-relaxed font-body">
                            Туристичка населба Отешево бб.<br />
                            Ресен, 7310<br />
                            Република Северна Македонија
                            <span id="addRole">
                                <a href="@Url.Action("AddUserToRole", "Account")" id="link1" class="text-slate-300 hover:text-slate-500 no-underline">.</a>
                            </span>
                        </p>
                    </div>
                </div>
            </div>

            <!-- Email Card -->
            <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-800 flex items-center justify-center text-xl shrink-0">
                        ✉️
                    </div>
                    <div>
                        <h3 class="text-base font-semibold text-slate-800 font-body mb-1">Информации и резервации</h3>
                        <a href="mailto:avtokamp.otesevo@gmail.com" class="text-emerald-800 hover:text-emerald-900 font-medium text-sm transition-colors font-body">
                            avtokamp.otesevo@gmail.com
                        </a>
                    </div>
                </div>
            </div>

            <!-- Phone Card -->
            <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex items-start gap-4">
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-800 flex items-center justify-center text-xl shrink-0">
                        📞
                    </div>
                    <div>
                        <h3 class="text-base font-semibold text-slate-800 font-body mb-1">Телефон за контакт</h3>
                        <a href="tel:+38970207259" class="text-emerald-800 hover:text-emerald-900 font-medium text-sm transition-colors font-body">
                            070207259
                        </a>
                    </div>
                </div>
            </div>

            <!-- Social Links & Logo Card -->
            <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm hover:shadow-md transition-shadow">
                <h3 class="text-base font-semibold text-slate-800 font-body mb-4">Следете нè на социјалните мрежи</h3>
                <div class="flex items-center gap-4 mb-6">
                    <a href="https://www.instagram.com/autocampotesevo/" target="_blank" rel="noopener" class="transition-transform hover:scale-110">
                        <img src="~/Content/insta_Logo.png" alt="Instagram" class="w-11 h-11 object-contain" />
                    </a>
                    <a href="https://www.facebook.com/autocampotesevo/" target="_blank" rel="noopener" class="transition-transform hover:scale-110">
                        <img src="~/Content/fb_Logo.png" alt="Facebook" class="w-11 h-11 object-contain" />
                    </a>
                    <a href="https://avtokampotesevo.wixsite.com/otesevo" target="_blank" rel="noopener" class="transition-transform hover:scale-110">
                        <img src="~/Content/website.png" alt="Website" class="w-11 h-11 object-contain" />
                    </a>
                </div>
                <div class="pt-4 border-t border-slate-100 flex justify-center">
                    <img src="~/Content/Avtokamp_Logo1.png" alt="Автокамп Отешево Лого" class="w-56 h-auto max-w-full object-contain" />
                </div>
            </div>
        </div>

        <!-- Google Map Column (7 cols) -->
        <div class="lg:col-span-7 h-full min-h-[450px] lg:min-h-[620px]">
            <div class="bg-white rounded-3xl overflow-hidden border border-slate-100 shadow-md h-full min-h-[450px] lg:min-h-[620px] relative">
                <iframe class="w-full h-full min-h-[450px] lg:min-h-[620px] border-0"
                        src="https://maps.google.com/maps?q=%D0%B0%D0%B2%D1%82%D0%BE%D0%BA%D0%B0%D0%BC%D0%BF%20%D0%BE%D1%82%D0%B5%D1%88%D0%B5%D0%B2%D0%BE&t=&z=13&ie=UTF8&iwloc=&output=embed"
                        allowfullscreen=""
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                </iframe>
            </div>
        </div>
    </div>
</div>
