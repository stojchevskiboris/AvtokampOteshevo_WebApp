@{
    ViewBag.Title = "Контакт";
}

<div class="max-w-7xl mx-auto py-16 px-4">
    <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-extrabold text-forest-800 mb-6">@ViewBag.Title</h2>
        <div class="h-1.5 w-24 bg-accent mx-auto rounded-full"></div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
        <!-- Contact Information -->
        <div class="space-y-12">
            <div class="bg-white rounded-3xl shadow-xl p-8 md:p-10 border border-gray-100">
                <h3 class="text-2xl font-bold text-forest-800 mb-8">Информации</h3>

                <div class="space-y-8">
                    <div class="flex items-start">
                        <div class="bg-forest-100 p-3 rounded-xl mr-4 text-forest-700">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
                        </div>
                        <div>
                            <p class="font-bold text-gray-900">Адреса</p>
                            <p class="text-gray-600">Туристичка населба Отешево бб.</p>
                            <p class="text-gray-600">Ресен, 7310, Македонија</p>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="bg-forest-100 p-3 rounded-xl mr-4 text-forest-700">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                        </div>
                        <div>
                            <p class="font-bold text-gray-900">E-mail</p>
                            <a href="mailto:avtokamp.otesevo@gmail.com" class="text-forest-600 hover:text-accent font-medium transition-colors">avtokamp.otesevo@gmail.com</a>
                        </div>
                    </div>

                    <div class="flex items-start">
                        <div class="bg-forest-100 p-3 rounded-xl mr-4 text-forest-700">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                        </div>
                        <div>
                            <p class="font-bold text-gray-900">Телефон</p>
                            <a href="tel:+38970207259" class="text-forest-600 hover:text-accent font-medium transition-colors">070 207 259</a>
                        </div>
                    </div>
                </div>

                <div class="mt-12 pt-10 border-t border-gray-100">
                    <p class="font-bold text-gray-900 mb-6">Следете нè:</p>
                    <div class="flex space-x-6">
                        <a href="https://www.instagram.com/autocampotesevo/" class="bg-gray-50 p-4 rounded-2xl hover:bg-forest-100 transition-all transform hover:-translate-y-1">
                            <img src="~/Content/insta_Logo.png" alt="Instagram" class="w-8 h-8">
                        </a>
                        <a href="https://www.facebook.com/autocampotesevo/" class="bg-gray-50 p-4 rounded-2xl hover:bg-forest-100 transition-all transform hover:-translate-y-1">
                            <img src="~/Content/fb_Logo.png" alt="Facebook" class="w-8 h-8">
                        </a>
                        <a href="https://avtokampotesevo.wixsite.com/otesevo" class="bg-gray-50 p-4 rounded-2xl hover:bg-forest-100 transition-all transform hover:-translate-y-1">
                            <img src="~/Content/website.png" alt="Website" class="w-8 h-8">
                        </a>
                    </div>
                </div>
            </div>

            <div class="flex justify-center">
                <img src="~/Content/Avtokamp_Logo1.png" alt="Logo" class="max-w-[200px] opacity-20 grayscale">
            </div>
        </div>

        <!-- Interactive Map -->
        <div class="h-full min-h-[500px] rounded-3xl overflow-hidden shadow-2xl border-8 border-white">
            <iframe
                class="w-full h-full min-h-[500px] grayscale hover:grayscale-0 transition-all duration-700"
                src="https://maps.google.com/maps?q=%D0%B0%D0%B2%D1%82%D0%BE%D0%BA%D0%B0%D0%BC%D0%BF%20%D0%BE%D1%82%D0%B5%D1%88%D0%B5%D0%B2%D0%BE&t=&z=13&ie=UTF8&iwloc=&output=embed"
                frameborder="0"
                scrolling="no"
                marginheight="0"
                marginwidth="0">
            </iframe>
        </div>
    </div>
</div>
