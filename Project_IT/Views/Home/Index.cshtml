                    <p class="text-white/80 text-sm font-body">@Strings.Gallery_Slide4_Desc</p>
                </div>
            </div>

            <!-- Slide Item 4 -->
            <div class="carousel-slide absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none">
                <img src="~/Content/campervan2.jpg" alt="@Strings.Gallery_Slide5_Title" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                    <h3 class="text-2xl mb-1 font-display">@Strings.Gallery_Slide5_Title</h3>
                    <p class="text-white/80 text-sm font-body">@Strings.Gallery_Slide5_Desc</p>
                </div>
