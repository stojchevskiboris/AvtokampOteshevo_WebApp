@{
    ViewBag.Title = "Почетна";
}

<div class="relative h-[80vh] min-h-[500px] flex items-center justify-center overflow-hidden -mt-8 mb-16">
    <!-- Hero Background Image -->
    <div class="absolute inset-0 z-0">
        <img src="~/Content/13.jpg" alt="Prespa Lake" class="w-full h-full object-cover">
        <div class="absolute inset-0 bg-black/40"></div>
    </div>

    <!-- Hero Content -->
    <div class="relative z-10 text-center text-white px-4">
        <h1 class="text-5xl md:text-7xl font-extrabold mb-6 tracking-tight">Преспанско Езеро</h1>
        <p class="text-xl md:text-2xl max-w-3xl mx-auto mb-10 text-gray-100 font-light leading-relaxed">
            Бистра езерска вода, долги песочни плажи и природа која го одзема здивот.
            Вашето совршено место за одмор под сонцето на Преспа.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href='@Url.Action("Create2", "Reservations")' class="btn-primary text-xl">Резервирај сега</a>
            <a href="https://mk.wikipedia.org/wiki/%D0%9F%D1%80%D0%B5%D1%81%D0%BF%D0%B0%D0%BD%D1%81%D0%BA%D0%BE_%D0%95%D0%B7%D0%B5%D1%80%D0%BE"
               target="_blank"
               class="bg-white/20 backdrop-blur-md hover:bg-white/30 text-white font-semibold py-3 px-8 rounded-full border border-white/40 transition-all">
               Дознај повеќе
            </a>
        </div>
    </div>

    <!-- Availability Bar (Simplified CTA) -->
    <div class="absolute bottom-0 left-0 right-0 transform translate-y-1/2 px-4 z-20">
        <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-2xl p-6 md:p-8 border border-gray-100">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6">
                <div>
                    <h3 class="text-2xl font-bold text-forest-800">Подготвени за кампување?</h3>
                    <p class="text-gray-500">Проверете ги слободните места и резервирајте веднаш.</p>
                </div>
                <a href='@Url.Action("Create2", "Reservations")' class="w-full md:w-auto bg-forest-700 hover:bg-forest-800 text-white font-bold py-4 px-10 rounded-xl transition-all shadow-lg">
                    Провери достапност
                </a>
            </div>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 mt-32 mb-24">
    <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-extrabold text-forest-800 mb-4">Автокамп Отешево</h2>
        <div class="h-1.5 w-24 bg-accent mx-auto rounded-full mb-6"></div>
        <p class="text-xl text-gray-600 max-w-2xl mx-auto">
            Нечија приказна од детството, нечие љубовно сеќавање, нечиј рај за душата...
        </p>
    </div>

    <!-- Campsite Categories -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Bungalows Card -->
        <div class="group bg-white rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-gray-100">
            <div class="relative h-80 overflow-hidden">
                <img src="~/Content/24.jpg" alt="Bungalows" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                <div class="absolute top-4 left-4">
                    <span class="bg-forest-700 text-white text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider">Premium</span>
                </div>
            </div>
            <div class="p-8">
                <div class="flex justify-between items-start mb-4">
                    <h3 class="text-3xl font-bold text-forest-800">Бунгалови</h3>
                    <div class="text-right">
                        <span class="block text-sm text-gray-400 uppercase font-bold tracking-widest">Од ноќевање</span>
                        <span class="text-2xl font-extrabold text-forest-700">600 ден.</span>
                    </div>
                </div>
                <p class="text-gray-600 mb-8 leading-relaxed">
                    Уживајте во удобноста на нашите дрвени бунгалови. Идеални за семејства и парови кои го сакаат мирот на езерото.
                </p>
                <div class="flex flex-wrap gap-3 mb-8">
                    <span class="flex items-center text-xs font-semibold text-forest-600 bg-forest-50 px-3 py-1 rounded-lg">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Струја
                    </span>
                    <span class="flex items-center text-xs font-semibold text-forest-600 bg-forest-50 px-3 py-1 rounded-lg">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Тераса
                    </span>
                    <span class="flex items-center text-xs font-semibold text-forest-600 bg-forest-50 px-3 py-1 rounded-lg">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Езерски поглед
                    </span>
                </div>
                <a href='@Url.Action("Create2", "Reservations")' class="block text-center bg-gray-50 hover:bg-forest-700 hover:text-white text-forest-800 font-bold py-4 rounded-xl transition-all border border-gray-200">
                    Резервирај Бунгалов
                </a>
            </div>
        </div>

        <!-- Tent/Caravan Sites Card -->
        <div class="group bg-white rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition-all duration-500 border border-gray-100">
            <div class="relative h-80 overflow-hidden">
                <img src="~/Content/1.jpg" alt="Tent sites" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700">
                <div class="absolute top-4 left-4">
                    <span class="bg-earth-600 text-white text-xs font-bold px-3 py-1.5 rounded-full uppercase tracking-wider">Nature</span>
                </div>
            </div>
            <div class="p-8">
                <div class="flex justify-between items-start mb-4">
                    <h3 class="text-3xl font-bold text-forest-800">Шатори и Приколки</h3>
                    <div class="text-right">
                        <span class="block text-sm text-gray-400 uppercase font-bold tracking-widest">Од ноќевање</span>
                        <span class="text-2xl font-extrabold text-forest-700">300 ден.</span>
                    </div>
                </div>
                <p class="text-gray-600 mb-8 leading-relaxed">
                    За вистинските љубители на природата. Поставете го вашиот шатор или приколка под сенките на старите дрвја.
                </p>
                <div class="flex flex-wrap gap-3 mb-8">
                    <span class="flex items-center text-xs font-semibold text-earth-600 bg-earth-50 px-3 py-1 rounded-lg">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Струја достапна
                    </span>
                    <span class="flex items-center text-xs font-semibold text-earth-600 bg-earth-50 px-3 py-1 rounded-lg">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Чиста вода
                    </span>
                    <span class="flex items-center text-xs font-semibold text-earth-600 bg-earth-50 px-3 py-1 rounded-lg">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Сенка
                    </span>
                </div>
                <a href='@Url.Action("Create2", "Reservations")' class="block text-center bg-gray-50 hover:bg-earth-600 hover:text-white text-earth-800 font-bold py-4 rounded-xl transition-all border border-gray-200">
                    Резервирај Плац
                </a>
            </div>
        </div>
    </div>
</div>

<!-- Image Gallery Section -->
<div class="bg-forest-50 py-24">
    <div class="max-w-7xl mx-auto px-4">
        <div class="flex items-end justify-between mb-12">
            <div>
                <h2 class="text-4xl font-bold text-forest-800 mb-4">Галерија</h2>
                <p class="text-gray-600">Погледнете дел од атмосферата во Автокамп Отешево.</p>
            </div>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <div class="overflow-hidden rounded-2xl h-64 border-4 border-white shadow-md">
                <img src="~/Content/11.jpg" alt="Gallery 1" class="w-full h-full object-cover hover:scale-110 transition-transform duration-500">
            </div>
            <div class="overflow-hidden rounded-2xl h-64 border-4 border-white shadow-md">
                <img src="~/Content/10.jpg" alt="Gallery 2" class="w-full h-full object-cover hover:scale-110 transition-transform duration-500">
            </div>
            <div class="overflow-hidden rounded-2xl h-64 border-4 border-white shadow-md">
                <img src="~/Content/18.jpg" alt="Gallery 3" class="w-full h-full object-cover hover:scale-110 transition-transform duration-500">
            </div>
            <div class="overflow-hidden rounded-2xl h-64 border-4 border-white shadow-md">
                <img src="~/Content/19.JPG" alt="Gallery 4" class="w-full h-full object-cover hover:scale-110 transition-transform duration-500">
            </div>
        </div>
    </div>
</div>
