            <!-- Carousel Controls -->
            <button id="prevSlideBtn" class="absolute left-4 top-1/2 -translate-y-1/2 w-11 h-11 rounded-full flex items-center justify-center transition hover:scale-110 cursor-pointer text-white text-xl z-10"
