@{
    ViewBag.Title = Strings.Home_Meta_Title;
    ViewBag.Description = Strings.Home_Meta_Desc;
}

<!-- ── Hero Section ─────────────────────────────────────────────────────── -->
<section id="home" class="relative flex flex-col items-center justify-center text-center px-6" style=" top: -30px; height: 92vh; min-height: 600px; max-height: 860px;">
    <!-- Background Video & Gradient Overlay -->
    <div class="absolute inset-0 bg-slate-800 overflow-hidden">
        <video autoplay loop muted playsinline poster="/Content/banner3.jpg" class="w-full h-full object-cover">
            <source src="/Content/bannerVideo.webm" type="video/webm">
            <source src="/Content/bannerVideo.mp4" type="video/mp4">
        </video>
        <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(10,25,18,0.55) 0%, rgba(10,25,18,0.25) 50%, rgba(10,25,18,0.75) 100%);"></div>
    </div>

    <!-- Content Container -->
    <div class="relative z-10 max-w-3xl mx-auto text-white">
        <span class="inline-block text-xs font-semibold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 text-white/90 font-body shadow-sm"
              style="background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);">
            @Strings.Home_Hero_Badge
        </span>

        <h1 class="text-5xl md:text-6xl lg:text-7xl text-white mb-6 leading-tight font-display font-bold" style="text-shadow: 0 2px 20px rgba(0,0,0,0.3);">
            @Strings.Home_Hero_Title_1 <em class="italic font-normal">@Strings.Home_Hero_Title_2</em>
        </h1>

        <p class="text-lg md:text-xl text-white/90 max-w-xl mx-auto mb-10 leading-relaxed font-body" style="text-shadow: 0 1px 8px rgba(0,0,0,0.4);">
            @Strings.Home_Hero_Sub_1 <br /> @Strings.Home_Hero_Sub_2
        </p>

        <button onclick="document.getElementById('booking').scrollIntoView({ behavior: 'smooth' })"
                class="inline-flex items-center gap-2.5 px-8 py-4 rounded-full text-sm font-semibold transition-all duration-200 hover:opacity-90 hover:shadow-xl hover:-translate-y-0.5 active:scale-95 cursor-pointer font-body bg-white text-slate-900 shadow-xl">
            @Strings.Home_Hero_Cta
            <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs bg-emerald-900 text-white">↗</span>
        </button>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-white/60 font-body">
        <div class="w-px h-10 bg-white/40 animate-pulse"></div>
    </div>
</section>

<!-- ── Booking Bar Widget ───────────────────────────────────────────────── -->
<div id="booking" class="mx-auto max-w-5xl px-6 -mt-10 relative z-20" style=" top: -40px;">
    <div class="bg-white rounded-2xl p-5 flex flex-col sm:flex-row items-stretch gap-3 border border-slate-100"
         style="box-shadow: 0 12px 40px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.04);">

        <!-- Check-in -->
        <label for="bookingCheckIn" class="flex flex-col gap-1 px-4 py-3 border border-slate-200 rounded-xl bg-white hover:border-slate-300 transition-colors flex-1 min-w-0 cursor-pointer">
            <span class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1 font-body">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
                @Strings.Home_CheckIn
            </span>
            <input type="date" id="bookingCheckIn" class="w-full max-w-full text-slate-800 text-sm font-medium outline-none bg-transparent cursor-pointer font-body" />
        </label>

        <!-- Check-out -->
        <label for="bookingCheckOut" class="flex flex-col gap-1 px-4 py-3 border border-slate-200 rounded-xl bg-white hover:border-slate-300 transition-colors flex-1 min-w-0 cursor-pointer">
            <span class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1 font-body">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
                @Strings.Home_CheckOut
            </span>
            <input type="date" id="bookingCheckOut" class="w-full max-w-full text-slate-800 text-sm font-medium outline-none bg-transparent cursor-pointer font-body" />
        </label>

        <!-- Guests -->
        <div class="flex flex-col gap-1 px-4 py-3 border border-slate-200 rounded-xl bg-white hover:border-slate-300 transition-colors flex-1 min-w-0">
            <span class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1 font-body">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                @Strings.Home_Guests
            </span>
            <select id="bookingGuests" class="w-full max-w-full text-slate-800 text-sm font-medium outline-none bg-transparent cursor-pointer font-body">
                <option value="1">@string.Format(Strings.Home_Guest_Singular, 1)</option>
                <option value="2" selected>@string.Format(Strings.Home_Guest_Plural, 2)</option>
                <option value="3">@string.Format(Strings.Home_Guest_Plural, 3)</option>
                <option value="4">@string.Format(Strings.Home_Guest_Plural, 4)</option>
                <option value="5">@string.Format(Strings.Home_Guest_Plural, 5)</option>
                <option value="6">@string.Format(Strings.Home_Guest_Plural, 6)</option>
                <option value="7">@string.Format(Strings.Home_Guest_Plural, 7)</option>
                <option value="8">@string.Format(Strings.Home_Guest_Plural, 8)</option>
            </select>
        </div>

        <!-- Search Button -->
        <button id="bookingSearchBtn"
                class="sm:self-stretch flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-white font-semibold text-sm transition-all duration-200 hover:opacity-90 hover:shadow-xl active:scale-95 cursor-pointer whitespace-nowrap bg-brand-gradient shadow-lg font-body"
                style="box-shadow: 0 4px 16px rgba(26,61,43,0.4);">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.35-4.35" />
            </svg>
            @Strings.Home_Search
        </button>
    </div>
</div>

<!-- ── About & Features Section ─────────────────────────────────────────── -->
<section id="about" class="py-28 px-6" style="background-color: var(--color-cream); margin-top: -40px;">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
        <!-- Left: Brand Story -->
        <div>
            <span class="inline-block text-xs font-semibold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 font-body"
                  style="background: rgba(26,61,43,0.08); color: #1a3d2b;">
                @Strings.About_Badge
            </span>
            <h2 class="text-4xl md:text-5xl text-slate-800 mb-6 leading-snug font-display">
                @Strings.About_Hero_Title_1<br />
                <em class="italic font-normal">@Strings.About_Hero_Title_2</em>
            </h2>
            <p class="text-slate-600 leading-relaxed mb-5 text-base font-body">
                @Strings.About_Story_P1
            </p>
            <p class="text-slate-500 leading-relaxed mb-8 text-sm font-body">
                @Strings.About_Story_P2
            </p>
            <a href='@Url.Action("New", "Reservations")'
               class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold text-white transition-all hover:opacity-90 hover:shadow-lg no-underline cursor-pointer bg-brand-gradient font-body"
               style="box-shadow: 0 4px 14px rgba(26,61,43,0.35);">
                @Strings.About_View_Prices
            </a>
        </div>

        <!-- Right: Feature Cards Grid -->
        <div class="grid grid-cols-2 gap-4">
            <div class="bg-white rounded-2xl p-6 flex flex-col gap-3 transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-slate-100" style="box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
                <h3 class="text-sm font-semibold text-slate-800 font-body">@Strings.Feature_Nature_Title</h3>
                <p class="text-xs text-slate-500 leading-relaxed font-body">@Strings.Feature_Nature_Desc</p>
            </div>
            <div class="bg-white rounded-2xl p-6 flex flex-col gap-3 transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-slate-100" style="box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
                <h3 class="text-sm font-semibold text-slate-800 font-body">@Strings.Feature_Bungalows_Title</h3>
                <p class="text-xs text-slate-500 leading-relaxed font-body">@Strings.Feature_Bungalows_Desc</p>
            </div>
            <div class="bg-white rounded-2xl p-6 flex flex-col gap-3 transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-slate-100" style="box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
                <h3 class="text-sm font-semibold text-slate-800 font-body">@Strings.Feature_Health_Title</h3>
                <p class="text-xs text-slate-500 leading-relaxed font-body">@Strings.Feature_Health_Desc</p>
            </div>
            <div class="bg-white rounded-2xl p-6 flex flex-col gap-3 transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-slate-100" style="box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
                <h3 class="text-sm font-semibold text-slate-800 font-body">@Strings.Feature_Peace_Title</h3>
                <p class="text-xs text-slate-500 leading-relaxed font-body">@Strings.Feature_Peace_Desc</p>
            </div>
        </div>
    </div>
</section>

<!-- ── Stats Bar ────────────────────────────────────────────────────────── -->
<div id="statsSection" class="py-12 px-6 bg-brand-gradient">
    <div class="max-w-4xl mx-auto grid grid-cols-3 gap-8 text-center text-white">
        <div>
            <div class="text-3xl md:text-4xl font-bold mb-1 font-display stat-number" data-target="50" data-suffix="+">0+</div>
            <div class="text-white/70 text-xs uppercase tracking-wider font-body">@Strings.Stats_Years</div>
        </div>
        <div>
            <div class="text-3xl md:text-4xl font-bold mb-1 font-display stat-number" data-target="10" data-suffix="+">0+</div>
            <div class="text-white/70 text-xs uppercase tracking-wider font-body">@Strings.Stats_Bungalows</div>
        </div>
        <div>
            <div class="text-3xl md:text-4xl font-bold mb-1 font-display stat-number" data-target="5000" data-suffix="+">0+</div>
            <div class="text-white/70 text-xs uppercase tracking-wider font-body">@Strings.Stats_Guests</div>
        </div>
    </div>
</div>

<!-- ── Gallery Carousel ─────────────────────────────────────────────────── -->
