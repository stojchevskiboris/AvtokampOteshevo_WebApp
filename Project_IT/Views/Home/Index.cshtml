            <!-- Indicator Dots -->
            <div id="carouselDots" class="absolute bottom-6 left-0 right-0 flex justify-center gap-2 z-10">
                <button class="carousel-dot transition-all duration-300 rounded-full cursor-pointer h-2 w-6 bg-white" aria-label="Slide 1"></button>
                <button class="carousel-dot transition-all duration-300 rounded-full cursor-pointer h-2 w-2 bg-white/50" aria-label="Slide 2"></button>
                <button class="carousel-dot transition-all duration-300 rounded-full cursor-pointer h-2 w-2 bg-white/50" aria-label="Slide 3"></button>
                <button class="carousel-dot transition-all duration-300 rounded-full cursor-pointer h-2 w-2 bg-white/50" aria-label="Slide 4"></button>
                <button class="carousel-dot transition-all duration-300 rounded-full cursor-pointer h-2 w-2 bg-white/50" aria-label="Slide 5"></button>
                <button class="carousel-dot transition-all duration-300 rounded-full cursor-pointer h-2 w-2 bg-white/50" aria-label="Slide 6"></button>
            </div>
        </div>
    </div>
</section>

@section scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Setup default dates for Booking Widget
            var today = new Date();
            var checkInDate = new Date();
            checkInDate.setDate(today.getDate() + 7);
            var checkOutDate = new Date();
            checkOutDate.setDate(today.getDate() + 10);

            var formatDate = function (d) {
                return d.toISOString().split('T')[0];
            };

            var checkInInput = document.getElementById('bookingCheckIn');
            var checkOutInput = document.getElementById('bookingCheckOut');
            var guestsSelect = document.getElementById('bookingGuests');

            if (checkInInput && checkOutInput) {
                checkInInput.value = formatDate(checkInDate);
                checkInInput.min = formatDate(today);
                checkOutInput.value = formatDate(checkOutDate);
                checkOutInput.min = formatDate(checkInDate);

                checkInInput.addEventListener('change', function () {
                    var newIn = new Date(this.value);
                    if (isNaN(newIn.getTime())) return;
                    var minOut = new Date(newIn);
                    minOut.setDate(minOut.getDate() + 1);
                    checkOutInput.min = formatDate(minOut);

                    var currentOut = new Date(checkOutInput.value);
                    if (currentOut <= newIn) {
                        checkOutInput.value = formatDate(minOut);
                    }
                });
            }

            // Open date picker when clicking on either label card container
            var labels = document.querySelectorAll('label[for="bookingCheckIn"], label[for="bookingCheckOut"]');
            labels.forEach(function (label) {
                label.addEventListener('click', function (e) {
                    var inputId = label.getAttribute('for');
                    var input = document.getElementById(inputId);
                    if (input && typeof input.showPicker === 'function') {
                        // Avoid double triggering if directly clicking the native input element
                        if (e.target !== input) {
                            e.preventDefault();
                            input.showPicker();
                        }
                    }
                });
            });

            // Handle Booking Search Button Action
            var searchBtn = document.getElementById('bookingSearchBtn');
            if (searchBtn) {
                searchBtn.addEventListener('click', function () {
                    var inVal = checkInInput ? checkInInput.value : '';
                    var outVal = checkOutInput ? checkOutInput.value : '';
                    var guestsVal = guestsSelect ? guestsSelect.value : '2';

                    var reservationUrl = '@Url.Action("New", "Reservations")' +
                        '?checkIn=' + encodeURIComponent(inVal) +
                        '&checkOut=' + encodeURIComponent(outVal) +
                        '&guests=' + encodeURIComponent(guestsVal);

                    window.location.href = reservationUrl;
                });
            }

            // Carousel Implementation
            var slides = document.querySelectorAll('.carousel-slide');
            var dots = document.querySelectorAll('.carousel-dot');
            var prevBtn = document.getElementById('prevSlideBtn');
            var nextBtn = document.getElementById('nextSlideBtn');
            var activeIdx = 0;
            var timer = null;

            function goToSlide(idx) {
                activeIdx = (idx + slides.length) % slides.length;

                slides.forEach(function (slide, i) {
                    if (i === activeIdx) {
                        slide.classList.remove('opacity-0', 'pointer-events-none');
                        slide.classList.add('opacity-100');
                    } else {
                        slide.classList.remove('opacity-100');
                        slide.classList.add('opacity-0', 'pointer-events-none');
                    }
                });

                dots.forEach(function (dot, i) {
                    if (i === activeIdx) {
                        dot.classList.remove('w-2', 'bg-white/50');
                        dot.classList.add('w-6', 'bg-white');
                    } else {
                        dot.classList.remove('w-6', 'bg-white');
                        dot.classList.add('w-2', 'bg-white/50');
                    }
                });
            }

            function startTimer() {
                if (timer) clearInterval(timer);
                timer = setInterval(function () {
                    goToSlide(activeIdx + 1);
                }, 8000);
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', function () {
                    goToSlide(activeIdx - 1);
                    startTimer();
                });
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', function () {
                    goToSlide(activeIdx + 1);
                    startTimer();
                });
            }

            dots.forEach(function (dot, i) {
                dot.addEventListener('click', function () {
                    goToSlide(i);
                    startTimer();
                });
            });

            startTimer();
        });
    </script>
}
