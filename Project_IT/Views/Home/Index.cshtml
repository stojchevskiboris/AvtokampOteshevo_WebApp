@{
    ViewBag.Title = "Автокамп Отешево - Почетна";
}

<!-- ── Hero Section ─────────────────────────────────────────────────────── -->
<section id="home" class="relative flex flex-col items-center justify-center text-center px-6" style=" top: -30px; height: 92vh; min-height: 600px; max-height: 860px;">
    <!-- Background Video & Gradient Overlay -->
    <div class="absolute inset-0 bg-slate-800 overflow-hidden">
        <video autoplay loop muted playsinline poster="/Content/banner3.jpg" class="w-full h-full object-cover">
            <source src="/Content/bannerVideo.webm" type="video/webm">
            <source src="/Content/bannerVideo.mp4" type="video/mp4">
        </video>
        <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(10,25,18,0.55) 0%, rgba(10,25,18,0.25) 50%, rgba(10,25,18,0.75) 100%);"></div>
    </div>

    <!-- Content Container -->
    <div class="relative z-10 max-w-3xl mx-auto text-white">
        <span class="inline-block text-xs font-semibold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 text-white/90 font-body shadow-sm"
              style="background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);">
            Преспанско Езеро, Македонија
        </span>

        <h1 class="text-5xl md:text-6xl lg:text-7xl text-white mb-6 leading-tight font-display font-bold" style="text-shadow: 0 2px 20px rgba(0,0,0,0.3);">
            Добредојдовте во <em class="italic font-normal">Автокамп Отешево</em>
        </h1>

        <p class="text-lg md:text-xl text-white/90 max-w-xl mx-auto mb-10 leading-relaxed font-body" style="text-shadow: 0 1px 8px rgba(0,0,0,0.4);">
            Вашето природно засолниште на брегот на <br /> Преспанското Езеро
        </p>

        <button onclick="document.getElementById('booking').scrollIntoView({ behavior: 'smooth' })"
                class="inline-flex items-center gap-2.5 px-8 py-4 rounded-full text-sm font-semibold transition-all duration-200 hover:opacity-90 hover:shadow-xl hover:-translate-y-0.5 active:scale-95 cursor-pointer font-body bg-white text-slate-900 shadow-xl">
            Истражете го кампот
            <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs bg-emerald-900 text-white">↗</span>
        </button>
    </div>

    <!-- Scroll Indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-white/60 font-body">
        <div class="w-px h-10 bg-white/40 animate-pulse"></div>
    </div>
</section>

<!-- ── Booking Bar Widget ───────────────────────────────────────────────── -->
<div id="booking" class="mx-auto max-w-5xl px-6 -mt-10 relative z-20" style=" top: -40px;">
    <div class="bg-white rounded-2xl p-5 flex flex-col sm:flex-row items-stretch gap-3 border border-slate-100"
         style="box-shadow: 0 12px 40px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.04);">

        <!-- Check-in -->
        <label for="bookingCheckIn" class="flex flex-col gap-1 px-4 py-3 border border-slate-200 rounded-xl bg-white hover:border-slate-300 transition-colors flex-1 min-w-0 cursor-pointer">
            <span class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1 font-body">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
                Пристигнување
            </span>
            <input type="date" id="bookingCheckIn" class="w-full max-w-full text-slate-800 text-sm font-medium outline-none bg-transparent cursor-pointer font-body" />
        </label>

        <!-- Check-out -->
        <label for="bookingCheckOut" class="flex flex-col gap-1 px-4 py-3 border border-slate-200 rounded-xl bg-white hover:border-slate-300 transition-colors flex-1 min-w-0 cursor-pointer">
            <span class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1 font-body">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
                Заминување
            </span>
            <input type="date" id="bookingCheckOut" class="w-full max-w-full text-slate-800 text-sm font-medium outline-none bg-transparent cursor-pointer font-body" />
        </label>

        <!-- Guests -->
        <div class="flex flex-col gap-1 px-4 py-3 border border-slate-200 rounded-xl bg-white hover:border-slate-300 transition-colors flex-1 min-w-0">
            <span class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider flex items-center gap-1 font-body">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                    <circle cx="9" cy="7" r="4" />
                    <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
                </svg>
                Гости
            </span>
            <select id="bookingGuests" class="w-full max-w-full text-slate-800 text-sm font-medium outline-none bg-transparent cursor-pointer font-body">
                <option value="1">1 гостин</option>
                <option value="2" selected>2 гости</option>
                <option value="3">3 гости</option>
                <option value="4">4 гости</option>
                <option value="5">5 гости</option>
                <option value="6">6 гости</option>
                <option value="7">7 гости</option>
                <option value="8">8 гости</option>
            </select>
        </div>

        <!-- Search Button -->
        <button id="bookingSearchBtn"
                class="sm:self-stretch flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-white font-semibold text-sm transition-all duration-200 hover:opacity-90 hover:shadow-xl active:scale-95 cursor-pointer whitespace-nowrap bg-brand-gradient shadow-lg font-body"
                style="box-shadow: 0 4px 16px rgba(26,61,43,0.4);">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.35-4.35" />
            </svg>
            Пребарај
        </button>
    </div>
</div>

<!-- ── About & Features Section ─────────────────────────────────────────── -->
<section id="about" class="py-28 px-6" style="background-color: var(--color-cream); margin-top: -40px;">
    <div class="max-w-6xl mx-auto grid md:grid-cols-2 gap-16 items-center">
        <!-- Left: Brand Story -->
        <div>
            <span class="inline-block text-xs font-semibold uppercase tracking-widest px-4 py-1.5 rounded-full mb-6 font-body"
                  style="background: rgba(26,61,43,0.08); color: #1a3d2b;">
                За нас
            </span>
            <h2 class="text-4xl md:text-5xl text-slate-800 mb-6 leading-snug font-display">
                Каде природата<br />
                <em class="italic font-normal">се среќава со комфорот</em>
            </h2>
            <p class="text-slate-600 leading-relaxed mb-5 text-base font-body">
                Автокамп Отешево лежи на западниот брег на Преспанското Езеро, опкружен со вековни шуми и растителен свет со ендемичен карактер, кои го прават овој простор уникатен и погоден за одмор, рекреација и целосна регенреација.
            </p>
            <p class="text-slate-500 leading-relaxed mb-8 text-sm font-body">
                Со повеќе од 50 години традиција, нудиме бунгалови, опремени кампинг места, директен пристап до езерската плажа и незаборавни залези на сонцето над Преспа.
            </p>
            <a href='@Url.Action("New", "Reservations")'
               class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold text-white transition-all hover:opacity-90 hover:shadow-lg no-underline cursor-pointer bg-brand-gradient font-body"
               style="box-shadow: 0 4px 14px rgba(26,61,43,0.35);">
                Резервирај сега ↗
            </a>
        </div>

        <!-- Right: Feature Cards Grid -->
        <div class="grid grid-cols-2 gap-4">
            <div class="bg-white rounded-2xl p-6 flex flex-col gap-3 transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-slate-100" style="box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
                <h3 class="text-sm font-semibold text-slate-800 font-body">Недопрена природа</h3>
                <p class="text-xs text-slate-500 leading-relaxed font-body">Опкружени со вековни шуми и чист планински воздух</p>
            </div>
            <div class="bg-white rounded-2xl p-6 flex flex-col gap-3 transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-slate-100" style="box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
                <h3 class="text-sm font-semibold text-slate-800 font-body">Удобни бунгалови</h3>
                <p class="text-xs text-slate-500 leading-relaxed font-body">Комфорни и современо опремени бунгалови за незаборавен одмор</p>
            </div>
            <div class="bg-white rounded-2xl p-6 flex flex-col gap-3 transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-slate-100" style="box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
                <h3 class="text-sm font-semibold text-slate-800 font-body">Природни лечилиште</h3>
                <p class="text-xs text-slate-500 leading-relaxed font-body">Уникатна микроклима и чист планински воздух за регенерација на телото и умот</p>
            </div>
            <div class="bg-white rounded-2xl p-6 flex flex-col gap-3 transition-all duration-200 hover:-translate-y-1 hover:shadow-md border border-slate-100" style="box-shadow: 0 2px 12px rgba(0,0,0,0.06);">
                <h3 class="text-sm font-semibold text-slate-800 font-body">Мирна средина</h3>
                <p class="text-xs text-slate-500 leading-relaxed font-body">Идеален бегство од градскиот метеж и секојдневниот стрес</p>
            </div>
        </div>
    </div>
</section>

<!-- ── Stats Bar ────────────────────────────────────────────────────────── -->
<div class="py-12 px-6 bg-brand-gradient">
    <div class="max-w-4xl mx-auto grid grid-cols-3 gap-8 text-center text-white">
        <div>
            <div class="text-3xl md:text-4xl font-bold mb-1 font-display">50+</div>
            <div class="text-white/70 text-xs uppercase tracking-wider font-body">Години искуство</div>
        </div>
        <div>
            <div class="text-3xl md:text-4xl font-bold mb-1 font-display">10+</div>
            <div class="text-white/70 text-xs uppercase tracking-wider font-body">Бунгалови</div>
        </div>
        <div>
            <div class="text-3xl md:text-4xl font-bold mb-1 font-display">5000+</div>
            <div class="text-white/70 text-xs uppercase tracking-wider font-body">Задоволни гости</div>
        </div>
    </div>
</div>

<!-- ── Gallery Carousel ─────────────────────────────────────────────────── -->
<section class="py-20 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-10">
            <span class="inline-block text-xs font-semibold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4 font-body"
                  style="background: rgba(26,61,43,0.08); color: #1a3d2b;">
                Галерија
            </span>
            <h2 class="text-4xl md:text-5xl text-slate-800 font-display">
                Погледнете ги нашите убавини
            </h2>
        </div>

        <div id="carouselContainer" class="relative rounded-2xl overflow-hidden shadow-2xl" style="height: 480px; box-shadow: 0 20px 60px rgba(0,0,0,0.18);">
            <!-- Slide Item 0 -->
            <div class="carousel-slide absolute inset-0 transition-opacity duration-700 opacity-100">
                <img src="~/Content/appartments.png" alt="Бунгалови" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                    <h3 class="text-2xl mb-1 font-display">Бунгалови</h3>
                    <p class="text-white/80 text-sm font-body">Пронајдете го Вашиот мир меѓу планината и брановите</p>
                </div>
            </div>

            <!-- Slide Item 1 -->
            <div class="carousel-slide absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none">
                <img src="~/Content/appartments2.jpg" alt="Бунгалови" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                    <h3 class="text-2xl mb-1 font-display">Бунгалови</h3>
                    <p class="text-white/80 text-sm font-body">Уживајте во мирисот на розите и спокојот на Преспа</p>
                </div>
            </div>

            <!-- Slide Item 2 -->
            <div class="carousel-slide absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none">
                <img src="~/Content/tents.png" alt="Кампување во чисто зеленило" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                    <h3 class="text-2xl mb-1 font-display">Кампување во чисто зеленило</h3>
                    <p class="text-white/80 text-sm font-body">Поставете го вашиот шатор под густите крошни и уживајте во природата</p>
                </div>
            </div>

            <!-- Slide Item 3 -->
            <div class="carousel-slide absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none">
                <img src="~/Content/camphome.jpg" alt="Погодно за вашата камп-приколка" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                    <h3 class="text-2xl mb-1 font-display">Погодно за вашата камп-приколка</h3>
                    <p class="text-white/80 text-sm font-body">Најдете ја вашата идеална локација за кампинг</p>
                </div>
            </div>

            <!-- Slide Item 4 -->
            <div class="carousel-slide absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none">
                <img src="~/Content/campervan2.jpg" alt="Езерски пејзажи" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                    <h3 class="text-2xl mb-1 font-display">Авантура без граници</h3>
                    <p class="text-white/80 text-sm font-body">Совршено место за вашиот кампер со поглед кон езерото</p>
                </div>
            </div>

            <!-- Slide Item 5 -->
            <div class="carousel-slide absolute inset-0 transition-opacity duration-700 opacity-0 pointer-events-none">
                <img src="~/Content/picnic.jpg" alt="Моменти за паметење" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                    <h3 class="text-2xl mb-1 font-display">Моменти за паметење</h3>
                    <p class="text-white/80 text-sm font-body">Место каде што семејните насмевки и верноста на миленичињата создаваат совршени моменти</p>
