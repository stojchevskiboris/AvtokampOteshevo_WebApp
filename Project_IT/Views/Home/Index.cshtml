                <div class="absolute bottom-0 left-0 right-0 p-8 text-white">
                    <h3 class="text-2xl mb-1 font-display">@Strings.Gallery_Slide3_Title</h3>
                    <p class="text-white/80 text-sm font-body">@Strings.Gallery_Slide3_Desc</p>
