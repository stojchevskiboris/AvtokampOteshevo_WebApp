@{
    ViewBag.Title = Strings.About_Meta_Title;
    ViewBag.Description = Strings.About_Meta_Desc;
}

<div class="py-12 md:py-16 px-6 max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block text-xs font-semibold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4 font-body"
              style="background: rgba(26,61,43,0.08); color: #1a3d2b;">
            @Strings.About_Badge
        </span>
        <h1 class="text-4xl md:text-5xl text-slate-800 mb-6 leading-tight font-display font-bold">
            @Strings.About_Hero_Title_1 <br /><em class="italic font-normal">@Strings.About_Hero_Title_2</em>
        </h1>
        <p class="text-slate-600 text-lg leading-relaxed font-body">
            @Strings.About_Story_P1
        </p>
    </div>

    <!-- Hero Card / Feature Banner -->
    <div class="relative rounded-3xl overflow-hidden shadow-2xl mb-20 border border-slate-100" style="box-shadow: 0 20px 50px rgba(0,0,0,0.1);">
        <div class="grid lg:grid-cols-2 bg-white">
            <div class="p-8 md:p-12 flex flex-col justify-center">
                <span class="text-xs font-semibold uppercase tracking-wider text-emerald-800 mb-3 font-body">@Strings.About_Story_Badge</span>
                <h2 class="text-2xl md:text-4xl text-slate-800 font-display mb-6">@Strings.About_Story_Heading</h2>
                <p class="text-xl text-slate-600 leading-relaxed font-body mb-4">
                    @Strings.About_Story_Full1
                </p>
                <p class="text-xl text-slate-600 leading-relaxed font-body mb-8">
                    @Strings.About_Story_Full2
                </p>
                <div class="flex items-center gap-4">
                    <a href='@Url.Action("New", "Reservations")' class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold text-white bg-brand-gradient transition-all duration-200 hover:opacity-90 hover:shadow-lg no-underline font-body">
                        @Strings.Nav_Book ↗
                    </a>
                    <a href='@Url.Action("Contact", "Home")' class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 transition-all duration-200 no-underline font-body">
                        @Strings.About_Contact_Us
                    </a>
                </div>
            </div>
            <div class="max-lg:hidden relative min-h-[320px]">
                <img src="~/Content/priroda.jpg" alt="@Strings.Site_Name" class="w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-r from-black/20 to-transparent"></div>
            </div>
        </div>
    </div>

    @* Gallery Section *@
    @{
        var galleryMedia = ViewBag.GalleryMedia as List<Project_IT.Models.MediaItem>;
        bool hasGalleryMedia = galleryMedia != null && galleryMedia.Any();
        bool hasMultipleMedia = galleryMedia != null && galleryMedia.Count > 1;
    }

    @if (hasGalleryMedia)
    {
        <div class="mb-20">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-1.5 h-7 bg-[#1a3d2b] rounded-full"></div>
                <h3 class="text-2xl font-serif font-bold text-slate-800 tracking-tight">
                    @Strings.Gallery_Badge
                </h3>
            </div>

            <div class="gallery-container bg-slate-950 rounded-2xl overflow-hidden shadow-inner p-3 md:p-5">
                <!-- Main Display Track -->
                <div class="swiper gallery-main-swiper mb-3 rounded-xl overflow-hidden bg-black max-h-[480px]">
                    <div class="swiper-wrapper">
                        @foreach (var media in galleryMedia)
                        {
                            <div class="swiper-slide outline-none flex items-center justify-center max-h-[480px] bg-slate-950">
                                @if (media.IsVideo)
                                {
                                    <video controls class="w-full max-h-[480px] object-contain mx-auto">
                                        <source src="@media.Url" type="video/mp4" />
                                    </video>
                                }
                                else
                                {
                                    <img src="@media.Url" alt="@Strings.Site_Name" class="w-full max-h-[480px] object-contain mx-auto" />
                                }
                            </div>
                        }
                    </div>

                    <div class="swiper-button-prev gallery-prev"></div>
                    <div class="swiper-button-next gallery-next"></div>
                </div>

                @if (hasMultipleMedia)
                {
                    <!-- Thumbnail Navigation Track -->
                    <div class="swiper gallery-thumbs-swiper px-2">
                        <div class="swiper-wrapper">
                            @foreach (var media in galleryMedia)
                            {
                                <div class="swiper-slide p-1">
                                    <div class="h-20 bg-slate-900">
                                        @if (media.IsVideo)
                                        {
                                            <video src="@media.Url#t=0.5" preload="metadata" class="w-full h-full object-cover pointer-events-none"></video>
                                        }
                                        else
                                        {
                                            <img src="@media.Url" alt="@Strings.About_Alt_Thumbnail" class="w-full h-full object-cover" />
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Swiper CSS -->
        <link rel="stylesheet" href="~/Scripts/swiper-bundle.min.css" />

        <style>
            .swiper-wrapper {
                align-items: center;
            }

            .gallery-container .swiper-button-next,
            .gallery-container .swiper-button-prev {
                margin-top: -40px;
                color: #fff;
                width: 30px;
                height: 30px;
            }

            .gallery-container .swiper-button-next:after,
            .gallery-container .swiper-button-prev:after {
                font-size: 16px;
                font-weight: 700;
            }

            .gallery-thumbs-swiper .swiper-slide {
                opacity: .55;
                border: 2px solid transparent;
                border-radius: .75rem;
                overflow: hidden;
                cursor: pointer;
                transition: .2s ease;
            }

            .gallery-thumbs-swiper .swiper-slide-thumb-active {
                opacity: 1;
                border-color: #2d6a46;
            }
        </style>

        <!-- Swiper JS -->
        <script src="~/Scripts/swiper-bundle.min.js"></script>

        <script>
            function initGallerySwiper() {
                const mainEl = document.querySelector('.gallery-main-swiper');
                if (!mainEl || mainEl.swiper) return;

                const thumbsEl = document.querySelector('.gallery-thumbs-swiper');
                let thumbsSwiper = null;

                if (thumbsEl && !thumbsEl.swiper) {
                    thumbsSwiper = new Swiper('.gallery-thumbs-swiper', {
                        spaceBetween: 8,
                        slidesPerView: 5,
                        freeMode: true,
                        watchSlidesProgress: true,
                        breakpoints: {
                            0: { slidesPerView: 2 },
                            480: { slidesPerView: 3 },
                            768: { slidesPerView: 5 }
                        }
                    });
                }

                new Swiper('.gallery-main-swiper', {
                    slidesPerView: 1,
                    spaceBetween: 10,
                    effect: 'fade',
                    fadeEffect: { crossFade: true },
                    navigation: {
                        nextEl: '.gallery-next',
                        prevEl: '.gallery-prev'
                    },
                    thumbs: thumbsSwiper ? { swiper: thumbsSwiper } : undefined
                });
            }

            document.addEventListener('DOMContentLoaded', initGallerySwiper);
            window.addEventListener('load', initGallerySwiper);
        </script>
    }

    <!-- Core Values & Offerings Grid -->
    <div class="mb-20">
        <div class="text-center max-w-2xl mx-auto mb-12">
            <h2 class="text-3xl text-slate-800 font-display mb-4">@Strings.About_Offerings_Title</h2>
            <p class="text-slate-600 text-sm font-body">@Strings.About_Offerings_Sub</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            <div class="bg-white rounded-2xl p-8 border border-slate-100 shadow-sm hover:shadow-md transition-all">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-800 flex items-center justify-center text-2xl mb-6">
                    🏡
                </div>
                <h3 class="text-xl font-semibold text-slate-800 font-display mb-3">@Strings.Feature_Bungalows_Title</h3>
                <p class="text-slate-600 text-sm font-body leading-relaxed">
                    @Strings.Feature_Bungalows_Desc
                </p>
            </div>

            <div class="bg-white rounded-2xl p-8 border border-slate-100 shadow-sm hover:shadow-md transition-all">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-800 flex items-center justify-center text-2xl mb-6">
                    🏕️
                </div>
                <h3 class="text-xl font-semibold text-slate-800 font-display mb-3">@Strings.Feature_Pitches_Title</h3>
                <p class="text-slate-600 text-sm font-body leading-relaxed">
                    @Strings.Feature_Pitches_Desc
                </p>
            </div>

            <div class="bg-white rounded-2xl p-8 border border-slate-100 shadow-sm hover:shadow-md transition-all">
                <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-800 flex items-center justify-center text-2xl mb-6">
                    🏖️
                </div>
                <h3 class="text-xl font-semibold text-slate-800 font-display mb-3">@Strings.Feature_Beach_Title</h3>
                <p class="text-slate-600 text-sm font-body leading-relaxed">
                    @Strings.Feature_Beach_Desc
                </p>
            </div>
        </div>
    </div>

    <!-- Call to Action Card -->
    <div class="rounded-3xl p-10 md:p-14 text-center text-white bg-brand-gradient shadow-xl relative overflow-hidden">
        <div class="relative z-10 max-w-2xl mx-auto">
            <h2 class="text-2xl md:text-4xl font-display font-bold mb-4">@Strings.About_CTA_Title</h2>
            <p class="text-xl text-white/80 font-body mb-8 leading-relaxed">
                @Strings.About_CTA_Sub
            </p>
            <div class="flex flex-wrap items-center justify-center gap-4">
                <a href='@Url.Action("New", "Reservations")' class="px-8 py-3.5 rounded-full text-sm font-semibold text-slate-900 bg-white hover:bg-slate-100 transition-all shadow-lg no-underline font-body">
                    @Strings.Nav_Book
                </a>
                <a href='@Url.Action("Contact", "Home")' class="px-8 py-3.5 rounded-full text-sm font-semibold text-white bg-white/10 hover:bg-white/20 transition-all border border-white/20 no-underline font-body">
                    @Strings.About_Contact_Us
                </a>
            </div>
        </div>
    </div>
</div>
