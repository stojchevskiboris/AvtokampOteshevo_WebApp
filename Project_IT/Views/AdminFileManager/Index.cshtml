@model Project_IT.Models.FileManagerViewModel

@{
    ViewBag.Title = "Администрација — File Manager";
    var imagesList = Model.Items.Where(i => !i.IsDirectory && i.IsImage).ToList();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-10 font-sans">
    <!-- Notifications -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span>✓</span>
                <span>@TempData["SuccessMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-emerald-600 hover:text-emerald-900 font-bold">&times;</button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center justify-between">
            <div class="flex items-center gap-2">
                <span>⚠️</span>
                <span>@TempData["ErrorMessage"]</span>
            </div>
            <button onclick="this.parentElement.remove()" class="text-rose-600 hover:text-rose-900 font-bold">&times;</button>
        </div>
    }

    <!-- Top Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 sm:mb-8">
        <div>
            <h1 class="text-2xl sm:text-3xl font-serif text-slate-800">File Manager</h1>
            <p class="text-slate-500 text-xs sm:text-sm mt-1">Управување со сите фајлови и директориуми во <code class="bg-slate-100 px-1.5 py-0.5 rounded text-slate-700">~/Content</code></p>
        </div>

        <div class="flex items-center gap-2 sm:gap-3">
            <button onclick="openModal('uploadModal')" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-3.5 sm:px-4 py-2 rounded-full text-xs sm:text-sm font-semibold text-white bg-brand-gradient shadow-md hover:opacity-90 transition cursor-pointer">
                <span>📤</span> Прикачи
            </button>
            <button onclick="openModal('createFolderModal')" class="flex-1 sm:flex-none inline-flex items-center justify-center gap-2 px-3.5 sm:px-4 py-2 rounded-full text-xs sm:text-sm font-semibold text-slate-700 bg-white border border-slate-200 shadow-sm hover:bg-slate-50 transition cursor-pointer">
                <span>📁</span> Нов Фолдер
            </button>
        </div>
    </div>

    <!-- Controls Bar & Breadcrumbs -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-3.5 sm:p-4 mb-6 flex flex-col lg:flex-row lg:items-center justify-between gap-4">
        <!-- Breadcrumb & Copy Path -->
        <div class="flex items-center gap-2 flex-wrap text-xs sm:text-sm font-medium">
            <span class="text-slate-400">Патека:</span>
            <div class="flex items-center gap-1 bg-slate-50 border border-slate-200 rounded-xl px-2.5 sm:px-3 py-1.5 flex-wrap max-w-full overflow-hidden">
                @for (int i = 0; i < Model.Breadcrumbs.Count; i++)
                {
                    var crumb = Model.Breadcrumbs[i];
                    if (i > 0)
                    {
                        <span class="text-slate-400">/</span>
                    }
                    if (i == Model.Breadcrumbs.Count - 1 && string.IsNullOrEmpty(Model.SearchQuery))
                    {
                        <span class="text-emerald-700 font-semibold truncate max-w-[120px] sm:max-w-none">@crumb.Name</span>
                    }
                    else
                    {
                        <a href="@Url.Action("Index", "AdminFileManager", new { currentPath = crumb.Path, viewType = Model.ViewType })" class="text-slate-600 hover:text-emerald-700 no-underline transition truncate max-w-[120px] sm:max-w-none">@crumb.Name</a>
                    }
                }
            </div>
            <button type="button" onclick="copyPathToClipboard('@Model.CurrentPath')" title="Копирај патека" class="p-1.5 sm:p-2 text-slate-500 hover:text-slate-800 hover:bg-slate-100 rounded-lg transition cursor-pointer">
                📋 <span class="text-xs ml-0.5 hidden sm:inline">Копирај Патека</span>
            </button>
        </div>

        <!-- Right Side: Search & View Switcher -->
        <div class="flex items-center gap-3 flex-wrap sm:flex-nowrap justify-between lg:justify-end w-full lg:w-auto">
            <!-- Search Form -->
            <form method="get" action="@Url.Action("Index", "AdminFileManager")" class="relative flex items-center flex-1 sm:flex-none">
                <input type="hidden" name="currentPath" value="@Model.CurrentPath" />
                <input type="hidden" name="viewType" value="@Model.ViewType" />
                <input type="text" name="query" value="@Model.SearchQuery" placeholder="Пребарај фајлови..."
                       class="w-full sm:w-64 pl-9 pr-8 py-1.5 text-xs sm:text-sm bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition" />
                <span class="absolute left-3 text-slate-400 text-xs">🔍</span>
                @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
                {
                    <a href="@Url.Action("Index", "AdminFileManager", new { currentPath = Model.CurrentPath, viewType = Model.ViewType })" class="absolute right-2.5 text-slate-400 hover:text-slate-600 text-xs no-underline font-bold">✕</a>
                }
            </form>

            <!-- Layout Switcher -->
            <div class="flex items-center bg-slate-100 p-1 rounded-xl border border-slate-200 shrink-0">
                <a href="@Url.Action("Index", "AdminFileManager", new { currentPath = Model.CurrentPath, query = Model.SearchQuery, viewType = "grid" })"
                   class="px-2.5 sm:px-3 py-1 rounded-lg text-xs font-semibold transition no-underline @(Model.ViewType == "grid" ? "bg-white text-emerald-700 shadow-sm" : "text-slate-500 hover:text-slate-800")">
                    ▦ Grid
                </a>
                <a href="@Url.Action("Index", "AdminFileManager", new { currentPath = Model.CurrentPath, query = Model.SearchQuery, viewType = "list" })"
                   class="px-2.5 sm:px-3 py-1 rounded-lg text-xs font-semibold transition no-underline @(Model.ViewType == "list" ? "bg-white text-emerald-700 shadow-sm" : "text-slate-500 hover:text-slate-800")">
                    ☰ List
                </a>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
    {
        <div class="mb-4 text-xs sm:text-sm text-slate-600">
            Резултати од пребарување за: <span class="font-semibold text-slate-900">"@Model.SearchQuery"</span> (@Model.TotalItems пронајдени)
        </div>
    }

    <!-- Content Items Area -->
    @if (!Model.Items.Any())
    {
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-8 sm:p-12 text-center text-slate-400">
            <div class="text-3xl sm:text-4xl mb-3">📂</div>
            <p class="text-xs sm:text-base font-medium">Оваа папка е празна или нема фајлови што одговараат на пребарувањето.</p>
        </div>
    }
    else if (Model.ViewType == "grid")
    {
        <!-- Grid View -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3 sm:gap-4 mb-8">
            @foreach (var item in Model.Items)
            {
                <div class="group relative bg-white rounded-2xl border border-slate-100 shadow-sm hover:shadow-md transition p-3 flex flex-col justify-between">
                    <!-- Dropdown Action Button -->
                    <div class="absolute top-2 right-2 z-10">
                        <button type="button" onclick="toggleDropdown(event, 'dropdown-@item.GetHashCode()')" class="p-1 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-700 font-bold transition">
                            ⋮
                        </button>
                        <div id="dropdown-@item.GetHashCode()" class="hidden absolute right-0 mt-1 w-36 bg-white rounded-xl shadow-lg border border-slate-100 py-1 text-xs z-20">
                            <button type="button" onclick="openDetailsModal('@item.Name', '@item.VirtualPath', '@item.FormattedSize', '@item.CreatedOn.ToString("dd.MM.yyyy HH:mm")', '@item.ModifiedOn.ToString("dd.MM.yyyy HH:mm")', '@item.DimensionString')" class="w-full text-left px-3 py-1.5 hover:bg-slate-50 text-slate-700">
                                ℹ️ Детали
                            </button>
                            <button type="button" onclick="openRenameModal('@item.RelativePath', '@item.Name')" class="w-full text-left px-3 py-1.5 hover:bg-slate-50 text-slate-700">
                                ✏️ Преименувај
                            </button>
                            <button type="button" onclick="openDeleteModal('@item.RelativePath', '@item.Name')" class="w-full text-left px-3 py-1.5 hover:bg-rose-50 text-rose-600 font-medium">
                                🗑️ Избриши
                            </button>
                        </div>
                    </div>

                    <!-- Main Item Clickable Content -->
                    <div class="flex flex-col items-center justify-center pt-3 pb-2 cursor-pointer" onclick="handleItemClick(event, @(item.IsDirectory ? "true" : "false"), '@item.RelativePath', '@item.VirtualPath', @(item.IsImage ? "true" : "false"))">
                        @if (item.IsDirectory)
                        {
                            <div class="w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center text-3xl sm:text-4xl text-amber-500 mb-2 group-hover:scale-105 transition">
                                📁
                            </div>
                        }
                        else if (item.IsImage)
                        {
                            <div class="w-20 h-16 sm:w-24 sm:h-20 rounded-xl overflow-hidden bg-slate-50 border border-slate-100 mb-2 flex items-center justify-center">
                                <img src="@item.VirtualPath" alt="@item.Name" class="w-full h-full object-cover group-hover:scale-105 transition" />
                            </div>
                        }
                        else
                        {
                            <div class="w-14 h-14 sm:w-16 sm:h-16 flex items-center justify-center text-3xl sm:text-4xl text-slate-400 mb-2 group-hover:scale-105 transition">
                                @if (item.Extension == ".pdf")
                                {<span>📄</span> }
                                else if (item.Extension == ".css" || item.Extension == ".js")
                                { <span>💻</span> }
                                else
                                { <span>📝</span>}
                            </div>
                        }

                        <span class="text-xs font-semibold text-slate-700 text-center truncate w-full px-1" title="@item.Name">@item.Name</span>
                        @if (!item.IsDirectory)
                        {
                            <span class="text-[10px] text-slate-400 mt-0.5">@item.FormattedSize</span>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Responsive List View -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden mb-8">
            <!-- Mobile List Layout (< sm) -->
            <div class="block sm:hidden divide-y divide-slate-100">
                @foreach (var item in Model.Items)
                {
                    <div class="p-3.5 flex flex-col gap-2 hover:bg-slate-50/50 transition">
                        <div class="flex items-center justify-between gap-3">
                            <div class="flex items-center gap-3 min-w-0 cursor-pointer flex-1" onclick="handleItemClick(event, @(item.IsDirectory ? "true" : "false"), '@item.RelativePath', '@item.VirtualPath', @(item.IsImage ? "true" : "false"))">
                                <div class="w-9 h-9 rounded-lg bg-slate-50 border border-slate-100 flex items-center justify-center text-lg shrink-0">
                                    @if (item.IsDirectory)
                                    {<span class="text-amber-500">📁</span> }
                                    else if (item.IsImage)
                                    { <img src="@item.VirtualPath" class="w-9 h-9 rounded-lg object-cover" /> }
                                    else if (item.Extension == ".pdf")
                                    { <span>📄</span> }
                                    else if (item.Extension == ".css" || item.Extension == ".js")
                                    { <span>💻</span> }
                                    else
                                    { <span>📝</span>}
                                </div>
                                <div class="min-w-0 flex-1">
                                    <div class="text-xs font-semibold text-slate-800 truncate" title="@item.Name">@item.Name</div>
                                    <div class="text-[10px] text-slate-400 flex items-center gap-2 mt-0.5">
                                        <span>@(item.IsDirectory ? "Фолдер" : (string.IsNullOrWhiteSpace(item.Extension) ? "Фајл" : item.Extension.ToUpper().TrimStart('.')))</span>
                                        @if (!item.IsDirectory)
                                        {
                                            <span>•</span>
                                            <span>@item.FormattedSize</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Mobile Quick Menu -->
                            <div class="relative shrink-0">
                                <button type="button" onclick="toggleDropdown(event, 'dropdown-m-@item.GetHashCode()')" class="p-1.5 rounded-lg hover:bg-slate-100 text-slate-400 hover:text-slate-700 font-bold transition">
                                    ⋮
                                </button>
                                <div id="dropdown-m-@item.GetHashCode()" class="hidden absolute right-0 mt-1 w-36 bg-white rounded-xl shadow-lg border border-slate-100 py-1 text-xs z-20">
                                    <button type="button" onclick="openDetailsModal('@item.Name', '@item.VirtualPath', '@item.FormattedSize', '@item.CreatedOn.ToString("dd.MM.yyyy HH:mm")', '@item.ModifiedOn.ToString("dd.MM.yyyy HH:mm")', '@item.DimensionString')" class="w-full text-left px-3 py-1.5 hover:bg-slate-50 text-slate-700">
                                        ℹ️ Детали
                                    </button>
                                    <button type="button" onclick="openRenameModal('@item.RelativePath', '@item.Name')" class="w-full text-left px-3 py-1.5 hover:bg-slate-50 text-slate-700">
                                        ✏️ Преименувај
                                    </button>
                                    <button type="button" onclick="openDeleteModal('@item.RelativePath', '@item.Name')" class="w-full text-left px-3 py-1.5 hover:bg-rose-50 text-rose-600 font-medium">
                                        🗑️ Избриши
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Desktop Table Layout (>= sm) -->
            <div class="hidden sm:block overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                    <thead class="bg-slate-50 border-b border-slate-100 text-slate-500 uppercase text-xs">
                        <tr>
                            <th class="px-4 md:px-6 py-4 font-semibold">Име</th>
                            <th class="px-4 md:px-6 py-4 font-semibold">Тип</th>
                            <th class="px-4 md:px-6 py-4 font-semibold">Големина</th>
                            <th class="px-4 md:px-6 py-4 font-semibold">Изменето</th>
                            <th class="px-4 md:px-6 py-4 font-semibold text-right">Акции</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-slate-50/50 transition">
                                <td class="px-4 md:px-6 py-3 font-medium text-slate-800 max-w-[200px] md:max-w-xs">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-lg flex items-center justify-center text-lg cursor-pointer shrink-0" onclick="handleItemClick(event, @(item.IsDirectory ? "true" : "false"), '@item.RelativePath', '@item.VirtualPath', @(item.IsImage ? "true" : "false"))">
                                            @if (item.IsDirectory)
                                            {<span class="text-amber-500">📁</span> }
                                            else if (item.IsImage)
                                            { <img src="@item.VirtualPath" class="w-8 h-8 rounded object-cover" /> }
                                            else if (item.Extension == ".pdf")
                                            { <span>📄</span> }
                                            else if (item.Extension == ".css" || item.Extension == ".js")
                                            { <span>💻</span> }
                                            else
                                            { <span>📝</span>}
                                        </div>
                                        <span class="cursor-pointer hover:text-emerald-700 transition truncate" title="@item.Name" onclick="handleItemClick(event, @(item.IsDirectory ? "true" : "false"), '@item.RelativePath', '@item.VirtualPath', @(item.IsImage ? "true" : "false"))">
                                            @item.Name
                                        </span>
                                    </div>
                                </td>
                                <td class="px-4 md:px-6 py-3 text-xs text-slate-400 whitespace-nowrap">
                                    @(item.IsDirectory ? "Фолдер" : (string.IsNullOrWhiteSpace(item.Extension) ? "Фајл" : item.Extension.ToUpper().TrimStart('.')))
                                </td>
                                <td class="px-4 md:px-6 py-3 text-xs text-slate-500 whitespace-nowrap">
                                    @item.FormattedSize
                                </td>
                                <td class="px-4 md:px-6 py-3 text-xs text-slate-400 whitespace-nowrap">
                                    @item.ModifiedOn.ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td class="px-4 md:px-6 py-3 text-right space-x-2 whitespace-nowrap">
                                    <button type="button" onclick="openDetailsModal('@item.Name', '@item.VirtualPath', '@item.FormattedSize', '@item.CreatedOn.ToString("dd.MM.yyyy HH:mm")', '@item.ModifiedOn.ToString("dd.MM.yyyy HH:mm")', '@item.DimensionString')" class="text-slate-600 hover:text-slate-900 font-semibold text-xs">Детали</button>
                                    <button type="button" onclick="openRenameModal('@item.RelativePath', '@item.Name')" class="text-emerald-700 hover:text-emerald-900 font-semibold text-xs">Преименувај</button>
                                    <button type="button" onclick="openDeleteModal('@item.RelativePath', '@item.Name')" class="text-rose-600 hover:text-rose-800 font-semibold text-xs">Избриши</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- Pagination Controls -->
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-center gap-1.5 sm:gap-2 mt-6 flex-wrap">
            @if (Model.CurrentPage > 1)
            {
                <a href="@Url.Action("Index", "AdminFileManager", new { currentPath = Model.CurrentPath, page = Model.CurrentPage - 1, query = Model.SearchQuery, viewType = Model.ViewType })"
                   class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-600 text-xs font-semibold hover:bg-slate-50 transition no-underline">
                    ← <span class="hidden sm:inline">Претходна</span>
                </a>
            }

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                if (p == Model.CurrentPage)
                {
                    <span class="px-3 py-1.5 rounded-xl bg-brand-gradient text-white text-xs font-semibold shadow-sm">@p</span>
                }
                else if (p <= 3 || p >= Model.TotalPages - 2 || Math.Abs(p - Model.CurrentPage) <= 1)
                {
                    <a href="@Url.Action("Index", "AdminFileManager", new { currentPath = Model.CurrentPath, page = p, query = Model.SearchQuery, viewType = Model.ViewType })"
                       class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-600 text-xs font-semibold hover:bg-slate-50 transition no-underline">
                        @p
                    </a>
                }
                else if (p == 4 && Model.CurrentPage > 5)
                {
                    <span class="text-slate-400 text-xs">...</span>
                }
                else if (p == Model.TotalPages - 3 && Model.CurrentPage < Model.TotalPages - 4)
                {
                    <span class="text-slate-400 text-xs">...</span>
                }
            }

            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a href="@Url.Action("Index", "AdminFileManager", new { currentPath = Model.CurrentPath, page = Model.CurrentPage + 1, query = Model.SearchQuery, viewType = Model.ViewType })"
                   class="px-3 py-1.5 rounded-xl border border-slate-200 bg-white text-slate-600 text-xs font-semibold hover:bg-slate-50 transition no-underline">
                    <span class="hidden sm:inline">Следна</span> →
                </a>
            }
        </div>
    }
</div>

<!-- ================= MODALS ================= -->
<!-- Upload File Modal -->
<div id="uploadModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100 animate-fadeIn">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-slate-800">Прикачи Фајл</h3>
            <button onclick="closeModal('uploadModal')" class="text-slate-400 hover:text-slate-600 font-bold">&times;</button>
        </div>
        @using (Html.BeginForm("Upload", "AdminFileManager", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="targetPath" value="@Model.CurrentPath" />
            <div class="mb-4">
                <label class="block text-xs font-semibold text-slate-600 mb-2">Изберете фајл (.jpg, .png, .gif, .pdf, .css, .js, .txt):</label>
                <input type="file" name="file" required class="w-full text-xs text-slate-600 file:mr-4 file:py-2 file:px-4 file:rounded-xl file:border-0 file:text-xs file:font-semibold file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100" />
            </div>
            <div class="flex justify-end gap-2 mt-6">
                <button type="button" onclick="closeModal('uploadModal')" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">Откажи</button>
                <button type="submit" class="px-4 py-2 rounded-xl text-xs font-semibold text-white bg-brand-gradient shadow transition">Прикачи</button>
            </div>
        }
    </div>
</div>

<!-- Create Folder Modal -->
<div id="createFolderModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100 animate-fadeIn">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-slate-800">Креирај Нов Фолдер</h3>
            <button onclick="closeModal('createFolderModal')" class="text-slate-400 hover:text-slate-600 font-bold">&times;</button>
        </div>
        @using (Html.BeginForm("CreateFolder", "AdminFileManager", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="currentPath" value="@Model.CurrentPath" />
            <div class="mb-4">
                <label class="block text-xs font-semibold text-slate-600 mb-2">Име на фолдер:</label>
                <input type="text" name="folderName" required placeholder="Пример: gallery" class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500" />
            </div>
            <div class="flex justify-end gap-2 mt-6">
                <button type="button" onclick="closeModal('createFolderModal')" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">Откажи</button>
                <button type="submit" class="px-4 py-2 rounded-xl text-xs font-semibold text-white bg-brand-gradient shadow transition">Креирај</button>
            </div>
        }
    </div>
</div>

<!-- Rename Modal -->
<div id="renameModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100 animate-fadeIn">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-slate-800">Преименувај</h3>
            <button onclick="closeModal('renameModal')" class="text-slate-400 hover:text-slate-600 font-bold">&times;</button>
        </div>
        @using (Html.BeginForm("Rename", "AdminFileManager", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="currentPath" value="@Model.CurrentPath" />
            <input type="hidden" id="renameItemPath" name="itemPath" value="" />
            <div class="mb-4">
                <label class="block text-xs font-semibold text-slate-600 mb-2">Ново име:</label>
                <input type="text" id="renameNewName" name="newName" required class="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500" />
            </div>
            <div class="flex justify-end gap-2 mt-6">
                <button type="button" onclick="closeModal('renameModal')" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">Откажи</button>
                <button type="submit" class="px-4 py-2 rounded-xl text-xs font-semibold text-white bg-brand-gradient shadow transition">Зачувај</button>
            </div>
        }
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="deleteModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100 animate-fadeIn">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-rose-600">Потврда за бришење</h3>
            <button onclick="closeModal('deleteModal')" class="text-slate-400 hover:text-slate-600 font-bold">&times;</button>
        </div>
        @using (Html.BeginForm("Delete", "AdminFileManager", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="currentPath" value="@Model.CurrentPath" />
            <input type="hidden" id="deleteItemPath" name="itemPath" value="" />
            <p class="text-sm text-slate-600 mb-4">Дали сте сигурни дека сакате да го избришете <strong id="deleteItemName" class="text-slate-900"></strong>?</p>
            <div class="flex justify-end gap-2 mt-6">
                <button type="button" onclick="closeModal('deleteModal')" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">Откажи</button>
                <button type="submit" class="px-4 py-2 rounded-xl text-xs font-semibold text-white bg-rose-600 hover:bg-rose-700 shadow transition">Избриши</button>
            </div>
        }
    </div>
</div>

<!-- Details Modal -->
<div id="detailsModal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-xl border border-slate-100 animate-fadeIn">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-slate-800">Детали за фајлот</h3>
            <button onclick="closeModal('detailsModal')" class="text-slate-400 hover:text-slate-600 font-bold">&times;</button>
        </div>
        <div class="space-y-3 text-sm">
            <div>
                <span class="block text-xs font-semibold text-slate-400">Име:</span>
                <span id="detailName" class="font-medium text-slate-800 break-all"></span>
            </div>
            <div>
                <span class="block text-xs font-semibold text-slate-400">Патека:</span>
                <span id="detailPath" class="font-mono text-xs text-slate-600 break-all"></span>
            </div>
            <div>
                <span class="block text-xs font-semibold text-slate-400">Големина:</span>
                <span id="detailSize" class="text-slate-700"></span>
            </div>
            <div id="detailDimensionContainer" class="hidden">
                <span class="block text-xs font-semibold text-slate-400">Резолуција:</span>
                <span id="detailDimension" class="text-slate-700"></span>
            </div>
            <div>
                <span class="block text-xs font-semibold text-slate-400">Креирано на:</span>
                <span id="detailCreated" class="text-slate-700"></span>
            </div>
            <div>
                <span class="block text-xs font-semibold text-slate-400">Изменето на:</span>
                <span id="detailModified" class="text-slate-700"></span>
            </div>
        </div>
        <div class="flex justify-end gap-2 mt-6">
            <button type="button" onclick="closeModal('detailsModal')" class="px-4 py-2 rounded-xl text-xs font-semibold text-slate-600 hover:bg-slate-100 transition">Затвори</button>
        </div>
    </div>
</div>

<!-- Image Lightbox Modal -->
<div id="imageModal" class="hidden fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4">
    <div class="relative bg-white rounded-2xl max-w-3xl w-full p-4 sm:p-6 shadow-2xl border border-slate-800 flex flex-col max-h-[90vh]">
        <!-- Close Button -->
        <button onclick="closeModal('imageModal')" class="absolute top-3 right-3 sm:top-4 sm:right-4 z-20 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 flex items-center justify-center font-bold transition">&times;</button>

        <!-- Main Image Preview Container -->
        <div class="relative flex-grow flex items-center justify-center bg-slate-900 rounded-xl overflow-hidden min-h-[250px] sm:min-h-[300px] max-h-[55vh]">
            <img id="lightboxImage" src="" alt="Preview" class="max-w-full max-h-[55vh] object-contain" />

            <!-- Left Arrow -->
            <button id="lightboxPrev" type="button" onclick="navigateGallery(-1)" class="absolute left-2 sm:left-3 p-2.5 sm:p-3 rounded-full bg-slate-900/60 hover:bg-slate-900 text-white font-bold transition flex items-center justify-center cursor-pointer shadow-lg text-xs sm:text-base">
                ❮
            </button>
            <!-- Right Arrow -->
            <button id="lightboxNext" type="button" onclick="navigateGallery(1)" class="absolute right-2 sm:right-3 p-2.5 sm:p-3 rounded-full bg-slate-900/60 hover:bg-slate-900 text-white font-bold transition flex items-center justify-center cursor-pointer shadow-lg text-xs sm:text-base">
                ❯
            </button>
        </div>

        <!-- Metadata & Link Footer -->
        <div class="mt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 border-t border-slate-100 pt-4 text-xs">
            <div class="space-y-1">
                <div><span class="font-semibold text-slate-400">Патека:</span> <span id="lightboxPath" class="font-mono text-slate-700 break-all"></span></div>
                <div class="flex gap-4">
                    <div><span class="font-semibold text-slate-400">Големина:</span> <span id="lightboxSize" class="text-slate-700"></span></div>
                    <div><span class="font-semibold text-slate-400">Резолуција:</span> <span id="lightboxResolution" class="text-slate-700"></span></div>
                </div>
            </div>
            <div class="shrink-0">
                <a id="lightboxOpenBtn" href="#" target="_blank" class="w-full sm:w-auto justify-center inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold text-white bg-emerald-700 hover:bg-emerald-800 transition no-underline">
                    Отвори фајл ↗
                </a>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Store image list for Lightbox Gallery navigation safely using Json.Encode
        var galleryImages = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(
            imagesList.Select(img => new {
                name = img.Name,
                virtualPath = img.VirtualPath,
                size = img.FormattedSize,
                dimension = img.DimensionString ?? "-"
            })
        ));
        var currentGalleryIndex = 0;

        function handleItemClick(event, isDirectory, relativePath, virtualPath, isImage) {
            // Prevent execution if target is dropdown or action button
            if (event.target.closest('button') || event.target.closest('[id^="dropdown-"]')) {
                return;
            }

            var isDir = (isDirectory === true || isDirectory === "true" || isDirectory === "True");
            var isImg = (isImage === true || isImage === "true" || isImage === "True");

            if (isDir) {
                var targetUrl = '@Url.Action("Index", "AdminFileManager")' + '?currentPath=' + encodeURIComponent(relativePath) + '&viewType=' + encodeURIComponent('@Model.ViewType');
                window.location.href = targetUrl;
            } else if (isImg) {
                openImageGallery(virtualPath);
            } else {
                window.open(virtualPath, '_blank');
            }
        }

        function openImageGallery(virtualPath) {
            if (!galleryImages || galleryImages.length === 0) return;

            // Normalize path strings to ensure matching across query string formats
            var normalizePath = function(p) {
                if (!p) return "";
                return p.replace(/\\/g, '/').toLowerCase();
            };

            var normalizedTarget = normalizePath(virtualPath);
            var foundIndex = galleryImages.findIndex(function(img) {
                return normalizePath(img.virtualPath) === normalizedTarget;
            });

            if (foundIndex !== -1) {
                currentGalleryIndex = foundIndex;
            } else {
                currentGalleryIndex = 0;
            }
            updateGalleryModal();
            openModal('imageModal');
        }

        function navigateGallery(direction) {
            if (!galleryImages || galleryImages.length === 0) return;
            currentGalleryIndex += direction;
            if (currentGalleryIndex < 0) {
                currentGalleryIndex = galleryImages.length - 1;
            } else if (currentGalleryIndex >= galleryImages.length) {
                currentGalleryIndex = 0;
            }
            updateGalleryModal();
        }

        function updateGalleryModal() {
            if (!galleryImages || galleryImages.length === 0) return;
            var item = galleryImages[currentGalleryIndex];

            document.getElementById('lightboxImage').src = item.virtualPath;
            document.getElementById('lightboxPath').textContent = item.virtualPath;
            document.getElementById('lightboxSize').textContent = item.size;
            document.getElementById('lightboxResolution').textContent = item.dimension || '-';
            document.getElementById('lightboxOpenBtn').href = item.virtualPath;

            // Show/hide navigation arrows based on total gallery images count
            var prevBtn = document.getElementById('lightboxPrev');
            var nextBtn = document.getElementById('lightboxNext');
            if (galleryImages.length <= 1) {
                prevBtn.style.display = 'none';
                nextBtn.style.display = 'none';
            } else {
                prevBtn.style.display = 'flex';
                nextBtn.style.display = 'flex';
            }
        }

        function openDetailsModal(name, virtualPath, size, created, modified, dimension) {
            document.getElementById('detailName').textContent = name;
            document.getElementById('detailPath').textContent = virtualPath;
            document.getElementById('detailSize').textContent = size;
            document.getElementById('detailCreated').textContent = created;
            document.getElementById('detailModified').textContent = modified;

            var dimContainer = document.getElementById('detailDimensionContainer');
            if (dimension && dimension !== '' && dimension !== 'null') {
                document.getElementById('detailDimension').textContent = dimension;
                dimContainer.classList.remove('hidden');
            } else {
                dimContainer.classList.add('hidden');
            }

            openModal('detailsModal');
        }

        function openRenameModal(itemPath, currentName) {
            document.getElementById('renameItemPath').value = itemPath;
            document.getElementById('renameNewName').value = currentName;
            openModal('renameModal');
        }

        function openDeleteModal(itemPath, itemName) {
            document.getElementById('deleteItemPath').value = itemPath;
            document.getElementById('deleteItemName').textContent = itemName;
            openModal('deleteModal');
        }

        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        function toggleDropdown(event, id) {
            event.stopPropagation();
            var dropdowns = document.querySelectorAll('[id^="dropdown-"]');
            dropdowns.forEach(function(d) {
                if (d.id !== id) {
                    d.classList.add('hidden');
                }
            });
            var target = document.getElementById(id);
            if (target) {
                target.classList.toggle('hidden');
            }
        }

        function copyPathToClipboard(path) {
            var fullVirtualPath = path.startsWith('/') ? path : '/' + path;
            navigator.clipboard.writeText(fullVirtualPath);
        }

        // Close dropdowns on outside click
        document.addEventListener('click', function(e) {
            var dropdowns = document.querySelectorAll('[id^="dropdown-"]');
            dropdowns.forEach(function(d) {
                d.classList.add('hidden');
            });
        });

        // Keyboard arrow navigation for image gallery modal
        document.addEventListener('keydown', function(e) {
            var imageModal = document.getElementById('imageModal');
            if (imageModal && !imageModal.classList.contains('hidden')) {
                if (e.key === 'ArrowLeft') {
                    navigateGallery(-1);
                } else if (e.key === 'ArrowRight') {
                    navigateGallery(1);
                } else if (e.key === 'Escape') {
                    closeModal('imageModal');
                }
            }
        });
    </script>
}